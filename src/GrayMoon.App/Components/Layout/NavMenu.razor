@implements IDisposable
@inject NavigationManager NavigationManager
@inject NavbarCollapseService NavbarCollapse
@using GrayMoon.App.Services

@* Always rendered - hidden purely via CSS (.page--topbar-hidden .sidebar .top-row in
   MainLayout.razor.css) so GrayMoon.Desktop's tray toggle can flip it with no server round-trip.
   A child of MainLayout has no way to react to DesktopTopBarState.Changed live: a Layout cannot
   declare its own @rendermode (see DesktopTopBarSync.razor for why), so MainLayout - and every
   component it renders, including this one - is always static/SSR-only and never joins a live
   circuit. *@
<div class="top-row navbar navbar-dark">
    <div class="container-fluid d-flex justify-content-center align-items-center">
        <a class="navbar-brand" href="">
            <span class="navbar-brand-content">
                <img src="moon.svg" alt="GrayMoon" class="navbar-brand-icon" />
                <span class="navbar-brand-title">GrayMoon</span>
            </span>
        </a>
    </div>
</div>

<div class="nav-body">
    <div class="nav-scrollable">
        <nav class="flex-column">
            @if (isWorkspaceView && workspaceId != null)
            {
                <div class="nav-item px-3" data-nav-label="Home">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-label="Home">
                        <span class="nav-link-icon">
                            <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                            <AgentUpgradeNotificationDot />
                        </span>
                        <span class="nav-link-text">Home</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Repositories">
                    <NavLink class="nav-link" href="@WorkspaceHref("")" Match="NavLinkMatch.All" aria-label="Repositories">
                        <i class="bi bi-grid" aria-hidden="true"></i>
                        <span class="nav-link-text">Repositories</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Changes">
                    <NavLink class="nav-link" href="@WorkspaceHref("changes")" Match="NavLinkMatch.All" aria-label="Changes">
                        <i class="bi bi-git" aria-hidden="true"></i>
                        <span class="nav-link-text">Changes</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Projects">
                    <NavLink class="nav-link" href="@WorkspaceHref("projects")" Match="NavLinkMatch.All" aria-label="Projects">
                        <i class="bi bi-journal-code" aria-hidden="true"></i>
                        <span class="nav-link-text">Projects</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Packages">
                    <NavLink class="nav-link" href="@WorkspaceHref("packages")" Match="NavLinkMatch.All" aria-label="Packages">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                        <span class="nav-link-text">Packages</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Files">
                    <NavLink class="nav-link" href="@WorkspaceHref("files")" Match="NavLinkMatch.All" aria-label="Files">
                        <i class="bi bi-file-earmark" aria-hidden="true"></i>
                        <span class="nav-link-text">Files</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Dependencies">
                    <NavLink class="nav-link" href="@WorkspaceHref("dependencies")" Match="NavLinkMatch.All" aria-label="Dependencies">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i>
                        <span class="nav-link-text">Deps</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Actions">
                    <NavLink class="nav-link" href="@WorkspaceHref("actions")" Match="NavLinkMatch.All" aria-label="Actions">
                        <i class="bi bi-play-circle" aria-hidden="true"></i>
                        <span class="nav-link-text">Actions</span>
                    </NavLink>
                </div>
            }
            else
            {
                <div class="nav-item px-3" data-nav-label="Home">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-label="Home">
                        <span class="nav-link-icon">
                            <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                            <AgentUpgradeNotificationDot />
                        </span>
                        <span class="nav-link-text">Home</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Workspaces">
                    <NavLink class="nav-link" href="workspaces" aria-label="Workspaces">
                        <i class="bi bi-grid" aria-hidden="true"></i>
                        <span class="nav-link-text">Workspaces</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Repositories">
                    <NavLink class="nav-link" href="repositories" aria-label="Repositories">
                        <i class="bi bi-github" aria-hidden="true"></i>
                        <span class="nav-link-text">Repositories</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Connectors">
                    <NavLink class="nav-link" href="connectors" aria-label="Connectors">
                        <i class="bi bi-plug" aria-hidden="true"></i>
                        <span class="nav-link-text">Connectors</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Worker">
                    <NavLink class="nav-link" href="agent" aria-label="Worker">
                        <i class="bi bi-cpu" aria-hidden="true"></i>
                        <span class="nav-link-text">Worker</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3" data-nav-label="Settings">
                    <NavLink class="nav-link" href="settings" aria-label="Settings">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                        <span class="nav-link-text">Settings</span>
                    </NavLink>
                </div>
            }
        </nav>
    </div>
</div>

<div class="nav-collapse-toggle">
    <button type="button"
            class="nav-collapse-btn"
            onclick="graymoonToggleSidebar()"
            title="Toggle sidebar"
            aria-label="Toggle sidebar">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
</div>

@code {
    private bool isWorkspaceView;
    private int? workspaceId;
    private string contextQuerySuffix = "";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        await UpdateWorkspaceContextAsync();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = UpdateWorkspaceContextAsync();
    }

    private string WorkspaceHref(string relativeSegment)
    {
        var basePath = string.IsNullOrEmpty(relativeSegment)
            ? $"workspaces/{workspaceId}"
            : $"workspaces/{workspaceId}/{relativeSegment}";
        return basePath + contextQuerySuffix;
    }

    private Task UpdateWorkspaceContextAsync()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var pathAndQuery = relativePath.Split('#')[0];
        var path = pathAndQuery.Split('?')[0];
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        contextQuerySuffix = "";
        var queryIndex = pathAndQuery.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex >= 0)
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(pathAndQuery[queryIndex..]);
            if (query.TryGetValue("context", out var values)
                && int.TryParse(values.FirstOrDefault(), out var contextId)
                && contextId > 0)
            {
                contextQuerySuffix = $"?context={contextId}";
            }
        }

        if (segments.Length >= 2 &&
            string.Equals(segments[0], "workspaces", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(segments[1], out var parsedId))
        {
            isWorkspaceView = true;
            workspaceId = parsedId;
        }
        else
        {
            isWorkspaceView = false;
            workspaceId = null;
            contextQuerySuffix = "";
        }

        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
