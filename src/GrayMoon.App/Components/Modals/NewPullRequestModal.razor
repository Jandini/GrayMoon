@using GrayMoon.App.Models
@using GrayMoon.App.Services
@using GrayMoon.Application
@using GrayMoon.Application.Features
@using Microsoft.Extensions.Options
@implements IDisposable
@inject IPullRequestService PullRequestService
@inject IWorkspacePushOperations PushOperations
@inject IWorkspaceBranchOperations BranchOperations
@inject IOptions<WorkspaceOptions> WorkspaceOptions
@inject ILogger<NewPullRequestModal> Logger
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="modal show d-block new-pr-modal" tabindex="-1" style="background-color: rgba(0,0,0,0.5);"
         @onkeydown="HandleKeyDown"
         @ref="modalElement">
        <div class="modal-dialog modal-lg modal-dialog-centered new-pr-modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    @* Title no-wrap/ellipsis — same .modal-title--compound convention as BranchModal/SwitchBranchModal/MergePullRequestModal. *@
                    <h5 class="modal-title modal-title--compound">
                        <span class="modal-title__primary">New Pull Request</span>
                        @{
                            var subtitle = Targets.Count == 1 ? Targets[0].RepositoryName : $"{Targets.Count} repositories";
                        }
                        <span class="modal-title__secondary text-muted fw-normal fs-6" title="@subtitle">@subtitle</span>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="HandleCancelClick" disabled="@IsBusy"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs new-pr-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(_activeTab == "details" ? "active" : null)"
                                    role="tab"
                                    aria-selected="@(_activeTab == "details")"
                                    id="new-pr-tab-details"
                                    @onclick='() => SetActiveTab("details")'>
                                Details
                            </button>
                        </li>
                        @if (IsMultiRepo)
                        {
                            <li class="nav-item" role="presentation">
                                <button type="button"
                                        class="nav-link @(_activeTab == "branch" ? "active" : null)"
                                        role="tab"
                                        aria-selected="@(_activeTab == "branch")"
                                        id="new-pr-tab-branch"
                                        @onclick='() => SetActiveTab("branch")'>
                                    Branch
                                </button>
                            </li>
                        }
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(_activeTab == "review" ? "active" : null)"
                                    role="tab"
                                    aria-selected="@(_activeTab == "review")"
                                    id="new-pr-tab-review"
                                    @onclick='() => SetActiveTab("review")'>
                                Review
                            </button>
                        </li>
                    </ul>

                    <div class="new-pr-tab-panels">
                        <div class="@TabPanelClass("details")"
                             aria-hidden="@(_activeTab != "details")">
                            @if (!IsMultiRepo)
                            {
                                <div class="mb-3">
                                    <div class="new-pr-branch-label-row">
                                        <label class="form-label" for="new-pr-branch">Branch</label>
                                        <span class="new-pr-branch-direction" aria-hidden="true">
                                            <span class="new-pr-branch-caption">Source</span>
                                            <span class="new-pr-branch-arrow">→</span>
                                            <span class="new-pr-branch-caption">Target</span>
                                        </span>
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0 ms-2 text-nowrap new-pr-branch-refresh"
                                                title="Fetch the latest branches from the remote"
                                                disabled="@(IsBusy || _refreshingBranches)"
                                                @onclick="RefreshAllTargetBranchesAsync">
                                            @if (_refreshingBranches)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            }
                                            Refresh
                                        </button>
                                    </div>
                                    <div id="new-pr-branch"
                                         class="new-pr-branch-panel @(_openTargetMenuRepoId.HasValue ? "new-pr-branch-panel--menu-open" : null)"
                                         role="group"
                                         aria-label="Pull request branches">
                                        @foreach (var target in Targets)
                                        {
                                            var state = GetRepoBranchState(target.RepositoryId);
                                            var menuOpen = _openTargetMenuRepoId == target.RepositoryId;
                                            <div class="new-pr-branch-row">
                                                <div class="new-pr-branch-main">
                                                    <span class="new-pr-branch-name text-truncate" title="@target.HeadBranch">@target.HeadBranch</span>
                                                </div>
                                                @if (state.IsLoading)
                                                {
                                                    <div class="new-pr-branch-target new-pr-branch-target--loading">
                                                        <span class="new-pr-branch-loading d-inline-flex align-items-center gap-2 text-muted">
                                                            <span class="spinner-border new-pr-branch-spinner" role="status" aria-hidden="true"></span>
                                                            Loading…
                                                        </span>
                                                    </div>
                                                }
                                                else if (state.Candidates.Count == 0)
                                                {
                                                    <div class="new-pr-branch-target new-pr-branch-target--error" title="@(state.Error ?? "No target branches available")">
                                                        <span class="new-pr-branch-target-value text-truncate">@(state.Error ?? "Unavailable")</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="new-pr-branch-target @(menuOpen ? "new-pr-branch-target--open" : null)">
                                                        <button type="button"
                                                                class="new-pr-branch-select"
                                                                id="@($"new-pr-target-{target.RepositoryId}")"
                                                                aria-label="@($"Target branch for {target.RepositoryName}")"
                                                                aria-haspopup="listbox"
                                                                aria-expanded="@menuOpen"
                                                                title="@state.SelectedBase"
                                                                disabled="@(IsBusy || state.IsLoading)"
                                                                @onclick="() => ToggleTargetMenu(target.RepositoryId)">
                                                            <span class="new-pr-branch-select-text text-truncate">@state.SelectedBase</span>
                                                        </button>
                                                        <span class="new-pr-branch-chevron" aria-hidden="true"></span>
                                                        @if (menuOpen)
                                                        {
                                                            <div class="new-pr-branch-menu-backdrop" @onclick="CloseTargetMenu"></div>
                                                            <ul class="new-pr-branch-menu"
                                                                role="listbox"
                                                                aria-labelledby="@($"new-pr-target-{target.RepositoryId}")">
                                                                @foreach (var branch in state.Candidates)
                                                                {
                                                                    var selected = string.Equals(branch, state.SelectedBase, StringComparison.Ordinal);
                                                                    <li role="option"
                                                                        aria-selected="@selected"
                                                                        class="new-pr-branch-menu-item @(selected ? "new-pr-branch-menu-item--selected" : null)"
                                                                        @onclick="() => SelectTargetBranch(target.RepositoryId, branch)">
                                                                        <span class="text-truncate" title="@branch">@branch</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(_branchLoadError))
                                    {
                                        <div class="form-text text-muted">@_branchLoadError</div>
                                    }
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label" for="new-pr-title">Title</label>
                                <input id="new-pr-title"
                                       type="text"
                                       class="form-control"
                                       @bind="_title"
                                       @bind:event="oninput"
                                       @ref="titleInput"
                                       disabled="@IsBusy" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="new-pr-body">Description</label>
                                <textarea id="new-pr-body"
                                          class="form-control new-pr-body"
                                          rows="6"
                                          @bind="_body"
                                          @bind:event="oninput"
                                          disabled="@IsBusy"></textarea>
                                <div class="form-text text-muted">
                                    If left empty, the repository pull request template will be used if available.
                                </div>
                            </div>

                            <div class="form-check mb-0">
                                <input id="new-pr-draft"
                                       type="checkbox"
                                       class="form-check-input"
                                       @bind="_isDraft"
                                       disabled="@IsBusy" />
                                <label for="new-pr-draft" class="form-check-label">Draft pull request</label>
                            </div>
                        </div>

                        @if (IsMultiRepo)
                        {
                            <div class="@TabPanelClass("branch")"
                                 aria-hidden="@(_activeTab != "branch")">
                                <div class="new-pr-branch-label-row">
                                    <label class="form-label" for="new-pr-branch">Repositories</label>
                                    <span class="new-pr-branch-direction" aria-hidden="true">
                                        <span class="new-pr-branch-caption">Source</span>
                                        <span class="new-pr-branch-arrow">→</span>
                                        <span class="new-pr-branch-caption">Target</span>
                                    </span>
                                    <button type="button"
                                            class="btn btn-link btn-sm p-0 ms-2 text-nowrap new-pr-branch-refresh"
                                            title="Fetch the latest branches from the remote"
                                            disabled="@(IsBusy || _refreshingBranches)"
                                            @onclick="RefreshAllTargetBranchesAsync">
                                        @if (_refreshingBranches)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                        }
                                        Refresh
                                    </button>
                                </div>
                                <div id="new-pr-branch"
                                     class="new-pr-branch-panel new-pr-branch-panel--scroll @(_openTargetMenuRepoId.HasValue ? "new-pr-branch-panel--menu-open" : null)"
                                     role="group"
                                     aria-label="Pull request branches">
                                    @foreach (var target in Targets)
                                    {
                                        var state = GetRepoBranchState(target.RepositoryId);
                                        var menuOpen = _openTargetMenuRepoId == target.RepositoryId;
                                        <div class="new-pr-branch-row new-pr-branch-row--multi">
                                            <div class="new-pr-branch-main">
                                                <span class="new-pr-branch-repo text-truncate" title="@target.RepositoryName">@target.RepositoryName</span>
                                                <span class="new-pr-branch-name text-truncate" title="@target.HeadBranch">@target.HeadBranch</span>
                                            </div>
                                            @if (state.IsLoading)
                                            {
                                                <div class="new-pr-branch-target new-pr-branch-target--loading">
                                                    <span class="new-pr-branch-loading d-inline-flex align-items-center gap-2 text-muted">
                                                        <span class="spinner-border new-pr-branch-spinner" role="status" aria-hidden="true"></span>
                                                        Loading…
                                                    </span>
                                                </div>
                                            }
                                            else if (state.Candidates.Count == 0)
                                            {
                                                <div class="new-pr-branch-target new-pr-branch-target--error" title="@(state.Error ?? "No target branches available")">
                                                    <span class="new-pr-branch-target-value text-truncate">@(state.Error ?? "Unavailable")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="new-pr-branch-target @(menuOpen ? "new-pr-branch-target--open" : null)">
                                                    <button type="button"
                                                            class="new-pr-branch-select"
                                                            id="@($"new-pr-target-{target.RepositoryId}")"
                                                            aria-label="@($"Target branch for {target.RepositoryName}")"
                                                            aria-haspopup="listbox"
                                                            aria-expanded="@menuOpen"
                                                            title="@state.SelectedBase"
                                                            disabled="@(IsBusy || state.IsLoading)"
                                                            @onclick="() => ToggleTargetMenu(target.RepositoryId)">
                                                        <span class="new-pr-branch-select-text text-truncate">@state.SelectedBase</span>
                                                    </button>
                                                    <span class="new-pr-branch-chevron" aria-hidden="true"></span>
                                                    @if (menuOpen)
                                                    {
                                                        <div class="new-pr-branch-menu-backdrop" @onclick="CloseTargetMenu"></div>
                                                        <ul class="new-pr-branch-menu"
                                                            role="listbox"
                                                            aria-labelledby="@($"new-pr-target-{target.RepositoryId}")">
                                                            @foreach (var branch in state.Candidates)
                                                            {
                                                                var selected = string.Equals(branch, state.SelectedBase, StringComparison.Ordinal);
                                                                <li role="option"
                                                                    aria-selected="@selected"
                                                                    class="new-pr-branch-menu-item @(selected ? "new-pr-branch-menu-item--selected" : null)"
                                                                    @onclick="() => SelectTargetBranch(target.RepositoryId, branch)">
                                                                    <span class="text-truncate" title="@branch">@branch</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(_branchLoadError))
                                {
                                    <div class="form-text text-muted">@_branchLoadError</div>
                                }
                            </div>
                        }

                        <div class="@TabPanelClass("review")"
                             aria-hidden="@(_activeTab != "review")">
                            <div class="d-flex align-items-center justify-content-between new-pr-reviewers-label-row">
                                <label class="form-label mb-0" for="new-pr-reviewers-filter">Reviewers <span class="text-muted">(optional)</span></label>
                                <span class="new-pr-reviewers-count">@GetReviewerCountText()</span>
                            </div>
                            <div class="new-pr-reviewer-box">
                                <input id="new-pr-reviewers-filter"
                                       type="text"
                                       class="new-pr-reviewer-search"
                                       placeholder="search user or team..."
                                       @bind="_reviewerFilter"
                                       @bind:event="oninput"
                                       disabled="@(IsBusy || _isLoadingReviewers)" />
                                <div class="new-pr-reviewer-list new-pr-reviewer-list--tab">
                                    @if (_isLoadingReviewers)
                                    {
                                        <div class="new-pr-reviewer-status d-flex align-items-center gap-2 px-2 py-1 text-muted">
                                            <span class="spinner-border new-pr-reviewer-spinner" role="status" aria-hidden="true"></span>
                                            Loading reviewers...
                                        </div>
                                    }
                                    else
                                    {
                                        var filtered = GetFilteredReviewers();
                                        @if (filtered.Count == 0)
                                        {
                                            <div class="new-pr-reviewer-status text-muted px-2 py-1">
                                                @(_allReviewers.Count == 0
                                                    ? "No reviewers were returned by GitHub."
                                                    : "No users or teams match the filter.")
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var item in filtered)
                                            {
                                                var isChecked = IsReviewerSelected(item);
                                                var key = ReviewerKey(item);
                                                <label class="new-pr-reviewer-item d-flex align-items-center gap-2 px-2 py-1"
                                                       for="@($"new-pr-reviewer-{key}")">
                                                    <input id="@($"new-pr-reviewer-{key}")"
                                                           type="checkbox"
                                                           class="form-check-input m-0"
                                                           checked="@isChecked"
                                                           @onchange="@((ChangeEventArgs e) => ToggleReviewer(item, e.Value is bool b && b))"
                                                           disabled="@IsBusy" />
                                                    <span class="flex-grow-1">@item.Name</span>
                                                    @if (item.IsTeam)
                                                    {
                                                        <span class="badge bg-secondary">team</span>
                                                    }
                                                </label>
                                            }
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between align-items-center">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="HandleOpenInGitHubClick"
                            disabled="@IsBusy">
                        Open in GitHub
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancelClick" disabled="@IsBusy">
                            Cancel
                        </button>
                        <button type="button"
                                class="btn btn-primary"
                                data-default-action
                                @onclick="() => HandleCreateClick(pushAndCreate: false)"
                                disabled="@(IsBusy || !IsValid)">
                            @if (IsBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            Create
                        </button>
                        @if (_repoIdsNeedingPush.Count > 0 && !_isCheckingUnpushed)
                        {
                            <button type="button"
                                    class="btn btn-warning"
                                    data-default-action
                                    @onclick="() => HandleCreateClick(pushAndCreate: true)"
                                    disabled="@(IsBusy || !IsValid)">
                                @if (IsBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Push & Create
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public WorkspaceFeatureContextId ContextId { get; set; }
    [Parameter] public IReadOnlyList<NewPrTargetRepo> Targets { get; set; } = Array.Empty<NewPrTargetRepo>();
    [Parameter] public EventCallback<NewPrFormResult> OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<IReadOnlyDictionary<int, string>> OnOpenInGitHub { get; set; }

    private ElementReference modalElement;
    private ElementReference titleInput;

    private string _title = string.Empty;
    private string _body = string.Empty;
    private bool _isDraft;
    private string _reviewerFilter = string.Empty;
    private List<ReviewerItem> _allReviewers = new();
    private readonly HashSet<string> _selectedReviewerKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool _isLoadingReviewers;
    private bool _reviewersRequested;
    private bool _refreshingBranches;
    private bool _wasVisible;
    private bool _focusTitleOnNextRender;
    private CancellationTokenSource? _reviewersCts;
    private DotNetObjectReference<NewPullRequestModal>? _dotNetRef;

    private bool _isCheckingUnpushed;
    private HashSet<int> _repoIdsNeedingPush = new();
    private CancellationTokenSource? _pushCheckCts;
    private CancellationTokenSource? _branchesCts;
    private string? _branchLoadError;
    private int? _openTargetMenuRepoId;
    private string _activeTab = "details";

    private readonly Dictionary<int, RepoBranchUiState> _branchByRepoId = new();

    private bool IsMultiRepo => Targets.Count > 1;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_title)
        && Targets.Count > 0
        && !_branchByRepoId.Values.Any(s => s.IsLoading)
        && Targets.All(t =>
        {
            var state = GetRepoBranchState(t.RepositoryId);
            return !string.IsNullOrWhiteSpace(state.SelectedBase)
                   && state.Candidates.Count > 0
                   && !string.Equals(state.SelectedBase, t.HeadBranch, StringComparison.Ordinal);
        });

    private int MaxConcurrency => Math.Max(1, WorkspaceOptions.Value.MaxParallelOperations);

    private void SetActiveTab(string tab)
    {
        if (tab == "branch" && !IsMultiRepo)
        {
            tab = "details";
        }

        if (_activeTab == tab)
        {
            return;
        }

        _activeTab = tab;
        CloseTargetMenu();

        // Reviewers are optional, so they are only fetched from GitHub once the Review tab is actually opened.
        if (tab == "review" && !_reviewersRequested)
        {
            _reviewersRequested = true;
            _ = LoadReviewersAsync();
        }
    }

    private string TabPanelClass(string tab) =>
        $"new-pr-tab-panel{(_activeTab == tab ? " new-pr-tab-panel--active" : null)}";

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            _title = ComputeDefaultTitle();
            _body = string.Empty;
            _isDraft = false;
            _reviewerFilter = string.Empty;
            _selectedReviewerKeys.Clear();
            _allReviewers = new();
            _activeTab = "details";
            _focusTitleOnNextRender = true;
            _isCheckingUnpushed = false;
            _repoIdsNeedingPush = new();
            _branchLoadError = null;
            _openTargetMenuRepoId = null;
            _branchByRepoId.Clear();
            foreach (var t in Targets)
            {
                _branchByRepoId[t.RepositoryId] = new RepoBranchUiState { IsLoading = true };
            }

            _reviewersRequested = false;
            _refreshingBranches = false;

            _ = LoadTargetBranchesAsync();
            _ = CheckUnpushedCommitsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && _focusTitleOnNextRender)
        {
            _focusTitleOnNextRender = false;
            try
            {
                await JS.InvokeVoidAsync("newPullRequestModal.selectTitle", titleInput);
            }
            catch { }

            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("newPullRequestModal.initTitlePasteHandler", titleInput, _dotNetRef);
            }
            catch { }
        }

        if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
            _reviewersCts?.Cancel();
            _reviewersCts?.Dispose();
            _reviewersCts = null;
            _pushCheckCts?.Cancel();
            _pushCheckCts?.Dispose();
            _pushCheckCts = null;
            _branchesCts?.Cancel();
            _branchesCts?.Dispose();
            _branchesCts = null;
        }
        else if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
        }
    }

    [JSInvokable]
    public void OnTitlePasteMultiline(string pastedText)
    {
        var normalized = pastedText.Replace("\r\n", "\n").Replace("\r", "\n");
        var lines = normalized.Split('\n');
        var firstLine = lines[0];
        var rest = string.Join("\n", lines.Skip(1)).Trim('\n');

        _title = firstLine;
        _body = string.IsNullOrWhiteSpace(rest)
            ? _body
            : (string.IsNullOrWhiteSpace(_body) ? rest : $"{_body}\n{rest}");

        StateHasChanged();
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _pushCheckCts?.Cancel();
        _pushCheckCts?.Dispose();
        _branchesCts?.Cancel();
        _branchesCts?.Dispose();
    }

    private RepoBranchUiState GetRepoBranchState(int repositoryId)
        => _branchByRepoId.TryGetValue(repositoryId, out var state)
            ? state
            : new RepoBranchUiState { IsLoading = true };

    private void ToggleTargetMenu(int repositoryId)
    {
        if (IsBusy) return;
        _openTargetMenuRepoId = _openTargetMenuRepoId == repositoryId ? null : repositoryId;
    }

    private void CloseTargetMenu() => _openTargetMenuRepoId = null;

    private void SelectTargetBranch(int repositoryId, string branch)
    {
        OnTargetBaseChanged(repositoryId, branch);
        _openTargetMenuRepoId = null;
    }

    private void OnTargetBaseChanged(int repositoryId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;
        if (!_branchByRepoId.TryGetValue(repositoryId, out var state))
            return;
        _branchByRepoId[repositoryId] = state with { SelectedBase = value.Trim() };
    }

    /// <summary>
    /// First paint: one bulk read of the persisted branch state for every target (no Worker, no fetch, no persistence).
    /// Only repositories with no persisted remote branches yet are then refreshed from the remote, in the background.
    /// </summary>
    private async Task LoadTargetBranchesAsync()
    {
        if (Targets.Count == 0) return;

        _branchesCts?.Cancel();
        _branchesCts?.Dispose();
        _branchesCts = new CancellationTokenSource();
        var ct = _branchesCts.Token;
        var started = System.Diagnostics.Stopwatch.GetTimestamp();

        try
        {
            var snapshots = await BranchOperations.GetBranchesForRepositoriesAsync(
                WorkspaceId, ContextId, Targets.Select(t => t.RepositoryId).ToList(), ct);
            if (ct.IsCancellationRequested) return;

            var needRefresh = new List<NewPrTargetRepo>();
            foreach (var target in Targets)
            {
                var resolution = NewPullRequestTargetBranch.Resolve(target, snapshots.GetValueOrDefault(target.RepositoryId));
                if (resolution.NeedsRefresh)
                    needRefresh.Add(target);
                _branchByRepoId[target.RepositoryId] = new RepoBranchUiState
                {
                    // Nothing persisted to choose from yet: keep the spinner until the background refresh answers.
                    IsLoading = resolution.Candidates.Count == 0 && resolution.NeedsRefresh,
                    Candidates = resolution.Candidates,
                    SelectedBase = resolution.SelectedBase,
                };
            }

            _branchLoadError = null;
            Logger.LogInformation(
                "New PR target branches: {Count} repositories rendered from persisted state in {ElapsedMs}ms; {RefreshCount} without persisted remote branches refreshed in the background",
                Targets.Count, (long)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds, needRefresh.Count);
            StateHasChanged();

            if (needRefresh.Count > 0)
                await RefreshTargetBranchesAsync(needRefresh, ct);
        }
        catch (OperationCanceledException)
        {
            // ignored
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load target branches for {Count} PR target(s)", Targets.Count);
            _branchLoadError = "Could not load target branches.";
            foreach (var t in Targets)
            {
                _branchByRepoId[t.RepositoryId] = new RepoBranchUiState
                {
                    IsLoading = false,
                    Error = "Could not load branches",
                    Candidates = [],
                    SelectedBase = t.DefaultBranch,
                };
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>"Refresh" in the branch panel: fetch every target's branches from the remote, keeping the user's choices.</summary>
    private async Task RefreshAllTargetBranchesAsync()
    {
        if (_refreshingBranches || Targets.Count == 0) return;
        var ct = _branchesCts?.Token ?? CancellationToken.None;
        try
        {
            await RefreshTargetBranchesAsync(Targets, ct);
        }
        catch (OperationCanceledException)
        {
            // ignored
        }
    }

    /// <summary>
    /// Refreshes <paramref name="targets"/> from the remote (bounded concurrency) and re-reads their persisted state in one bulk
    /// query. Selectors stay usable while this runs; a selection that is still valid afterwards is kept.
    /// </summary>
    private async Task RefreshTargetBranchesAsync(IReadOnlyList<NewPrTargetRepo> targets, CancellationToken ct)
    {
        _refreshingBranches = true;
        StateHasChanged();
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        var failed = new HashSet<int>();
        try
        {
            using var semaphore = new SemaphoreSlim(MaxConcurrency, MaxConcurrency);
            await Task.WhenAll(targets.Select(async target =>
            {
                await semaphore.WaitAsync(ct);
                try
                {
                    var outcome = await BranchOperations.RefreshBranchesAsync(WorkspaceId, ContextId, target.RepositoryId, ct);
                    if (!outcome.IsSuccessStatus)
                        lock (failed) failed.Add(target.RepositoryId);
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Refresh target branches failed for RepositoryId={RepositoryId}", target.RepositoryId);
                    lock (failed) failed.Add(target.RepositoryId);
                }
                finally
                {
                    semaphore.Release();
                }
            }));
            if (ct.IsCancellationRequested) return;

            var snapshots = await BranchOperations.GetBranchesForRepositoriesAsync(
                WorkspaceId, ContextId, targets.Select(t => t.RepositoryId).ToList(), ct);
            if (ct.IsCancellationRequested) return;

            foreach (var target in targets)
            {
                var previous = GetRepoBranchState(target.RepositoryId);
                var resolution = NewPullRequestTargetBranch.Resolve(
                    target, snapshots.GetValueOrDefault(target.RepositoryId), previous.SelectedBase);
                _branchByRepoId[target.RepositoryId] = new RepoBranchUiState
                {
                    IsLoading = false,
                    Candidates = resolution.Candidates,
                    SelectedBase = resolution.SelectedBase,
                    Error = resolution.Candidates.Count == 0
                        ? (failed.Contains(target.RepositoryId) ? "Could not load branches" : "No target branches available")
                        : null,
                };
            }

            _branchLoadError = failed.Count > 0 ? "Some repositories could not refresh target branches." : null;
            Logger.LogInformation(
                "New PR target branches: refreshed {Count} repositories from the remote in {ElapsedMs}ms ({Failed} failed)",
                targets.Count, (long)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds, failed.Count);
        }
        finally
        {
            _refreshingBranches = false;
            StateHasChanged();
        }
    }

    private string ComputeDefaultTitle()
    {
        if (Targets.Count == 0)
            return string.Empty;
        return PullRequestTitleHelper.BuildDefaultTitle(Targets[0].HeadBranch);
    }

    private async Task LoadReviewersAsync()
    {
        if (Targets.Count == 0) return;

        _reviewersCts?.Cancel();
        _reviewersCts?.Dispose();
        _reviewersCts = new CancellationTokenSource();
        var ct = _reviewersCts.Token;

        _isLoadingReviewers = true;
        StateHasChanged();

        try
        {
            // One call: repositories resolved in bulk, each distinct GitHub repository asked once, answers cached briefly.
            var candidates = await PullRequestService.GetReviewerCandidatesAsync(Targets.Select(t => t.RepositoryId).ToList(), ct);

            if (ct.IsCancellationRequested) return;

            _allReviewers = candidates.Teams
                .Select(t => new ReviewerItem(t, IsTeam: true))
                .Concat(candidates.Users.Select(u => new ReviewerItem(u, IsTeam: false)))
                .OrderByDescending(r => r.IsTeam)
                .ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            // ignored
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load reviewers for {Count} target(s)", Targets.Count);
            _allReviewers = new();
        }
        finally
        {
            _isLoadingReviewers = false;
            StateHasChanged();
        }
    }

    private async Task CheckUnpushedCommitsAsync()
    {
        if (Targets.Count == 0) return;

        _pushCheckCts?.Cancel();
        _pushCheckCts?.Dispose();
        _pushCheckCts = new CancellationTokenSource();
        var ct = _pushCheckCts.Token;

        _isCheckingUnpushed = true;
        StateHasChanged();

        try
        {
            var repoIds = Targets.Select(t => t.RepositoryId).ToHashSet();
            var needingPush = await PushOperations.GetRepositoryIdsNeedingPushAsync(WorkspaceId, ContextId, repoIds, ct);
            if (ct.IsCancellationRequested) return;

            _repoIdsNeedingPush = needingPush.ToHashSet();
        }
        catch (OperationCanceledException)
        {
            // ignored
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to check for unpushed commits for {Count} target(s)", Targets.Count);
            _repoIdsNeedingPush = new();
        }
        finally
        {
            _isCheckingUnpushed = false;
            StateHasChanged();
        }
    }

    private List<ReviewerItem> GetFilteredReviewers()
    {
        var q = _reviewerFilter?.Trim();
        if (string.IsNullOrWhiteSpace(q))
            return _allReviewers;
        var words = q.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0)
            return _allReviewers;
        return _allReviewers
            .Where(r => words.Any(w => r.Name.Contains(w, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private bool IsReviewerSelected(ReviewerItem item)
        => _selectedReviewerKeys.Contains(ReviewerKey(item));

    private void ToggleReviewer(ReviewerItem item, bool isChecked)
    {
        var key = ReviewerKey(item);
        if (isChecked) _selectedReviewerKeys.Add(key);
        else _selectedReviewerKeys.Remove(key);
    }

    private static string ReviewerKey(ReviewerItem item) => (item.IsTeam ? "team:" : "user:") + item.Name;

    private string GetReviewerCountText()
    {
        if (_isLoadingReviewers) return "loading...";
        if (_allReviewers.Count == 0) return string.Empty;
        var selected = _selectedReviewerKeys.Count;
        var total = _allReviewers.Count;
        return selected == 0
            ? $"{total} available"
            : $"{selected} selected of {total}";
    }

    private IReadOnlyDictionary<int, string> GetSelectedBases()
    {
        var map = new Dictionary<int, string>();
        foreach (var t in Targets)
        {
            var state = GetRepoBranchState(t.RepositoryId);
            if (!string.IsNullOrWhiteSpace(state.SelectedBase))
                map[t.RepositoryId] = state.SelectedBase;
        }
        return map;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !IsBusy)
        {
            if (_openTargetMenuRepoId is not null)
            {
                CloseTargetMenu();
                return;
            }
            await HandleCancelClick();
        }
    }

    private async Task HandleCancelClick()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleOpenInGitHubClick()
    {
        await OnOpenInGitHub.InvokeAsync(GetSelectedBases());
    }

    private async Task HandleCreateClick(bool pushAndCreate)
    {
        if (!IsValid) return;

        var users = new List<string>();
        var teams = new List<string>();
        foreach (var item in _allReviewers)
        {
            if (!_selectedReviewerKeys.Contains(ReviewerKey(item))) continue;
            if (item.IsTeam) teams.Add(item.Name);
            else users.Add(item.Name);
        }

        var result = new NewPrFormResult(
            Title: _title.Trim(),
            Body: string.IsNullOrWhiteSpace(_body) ? null : _body,
            IsDraft: _isDraft,
            Reviewers: users,
            TeamReviewers: teams,
            RepositoryIdsToPush: pushAndCreate ? _repoIdsNeedingPush.ToList() : Array.Empty<int>(),
            BaseBranchByRepositoryId: GetSelectedBases());

        await OnCreate.InvokeAsync(result);
    }

    private sealed record ReviewerItem(string Name, bool IsTeam);

    private sealed record RepoBranchUiState
    {
        public bool IsLoading { get; init; }
        public IReadOnlyList<string> Candidates { get; init; } = Array.Empty<string>();
        public string SelectedBase { get; init; } = "";
        public string? Error { get; init; }
    }
}
