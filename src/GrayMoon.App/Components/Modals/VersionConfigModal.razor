@using GrayMoon.App.Models
@using GrayMoon.App.Models.Api
@using GrayMoon.App.Services
@using GrayMoon.App.Api.Endpoints
@using GrayMoon.Application.Features
@using GrayMoon.Common.FileVersions
@inject IJSRuntime JS
@inject WorkspaceFileVersionService VersionService

@if (IsVisible)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Version Configuration <span class="text-muted fw-normal fs-6">@(File?.FileName ?? "")</span></h5>
                    <button type="button" class="btn-close" @onclick="RequestCloseAsync"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Enter one version pattern per line. Each pattern is a line prefix followed by a token:
                        <code>@("{@repository}")</code> (GitVersion),
                        <code>@("{@repository:branch}")</code> (current branch), or
                        <code>@("{@repository:commit}")</code> (current commit SHA).
                        For example: <code>@("MY_SERVICE_VERSION={@repository}")</code> matches lines starting with <code>MY_SERVICE_VERSION=</code>
                        and replaces the rest with the resolved value.
                        Type <kbd>@@</kbd> to autocomplete a repository name; you can append <code>:branch</code> or <code>:commit</code> inside the token.
                    </p>

                    <div class="mb-3 version-config-editor-wrap">
                        <label class="form-label d-flex align-items-baseline gap-2 flex-wrap">
                            Version Pattern
                            @if (!string.IsNullOrWhiteSpace(patternText) && (validTokenCount > 0 || invalidTokens.Count > 0 || unsupportedSelectors.Count > 0 || selfReferencingTokens.Count > 0))
                            {
                                @if (invalidTokens.Count > 0 || unsupportedSelectors.Count > 0 || selfReferencingTokens.Count > 0)
                                {
                                    <span class="version-config-error-icon">
                                        &#x26A0;
                                        <div class="version-config-error-tooltip">
                                            @if (selfReferencingTokens.Count > 0)
                                            {
                                                <div class="version-config-error-tooltip-title">Circular references:</div>
                                                @foreach (var t in selfReferencingTokens.Select(x => x.TokenKey).Distinct(StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <div>@t</div>
                                                }
                                            }
                                            @if (invalidTokens.Count > 0)
                                            {
                                                <div class="version-config-error-tooltip-title">Unknown repositories:</div>
                                                @foreach (var t in invalidTokens)
                                                {
                                                    <div>@t</div>
                                                }
                                            }
                                            @if (unsupportedSelectors.Count > 0)
                                            {
                                                <div class="version-config-error-tooltip-title">Unsupported selectors:</div>
                                                @foreach (var s in unsupportedSelectors)
                                                {
                                                    <div>@s</div>
                                                }
                                            }
                                        </div>
                                    </span>
                                }
                                <span class="version-config-token-count @(invalidTokens.Count > 0 || unsupportedSelectors.Count > 0 || selfReferencingTokens.Count > 0 ? "version-config-token-count-warning" : "")">@validTokenCount token@(validTokenCount != 1 ? "s" : "") resolved</span>
                            }
                        </label>
                        <textarea class="form-control version-config-textarea font-monospace"
                                  placeholder="@("GRAYMOON_VERSION={@GrayMoon}")"
                                  spellcheck="false"
                                  value="@patternText"
                                  @oninput="OnPatternInput"
                                  @onkeydown="OnTextareaKeyDown"
                                  @ref="textareaRef">
                        </textarea>

                        @if (showSuggestions && filteredRepos.Count > 0)
                        {
                            <div class="version-config-suggestions" style="left:@((int)_dropdownX)px;top:@((int)_dropdownY)px;" @ref="_suggestionsRef">
                                @for (int i = 0; i < filteredRepos.Count; i++)
                                {
                                    var idx = i;
                                    var repo = filteredRepos[i];
                                    <button type="button"
                                            class="version-config-suggestion-item @(idx == suggestionIndex ? "active" : "")"
                                            @onclick="() => AcceptSuggestion(repo)"
                                            @onmousedown:preventDefault="true">
                                        @repo
                                    </button>
                                }
                            </div>
                        }

                        @if (_fileValidating)
                        {
                            <div class="small text-muted mt-1">Checking file...</div>
                        }
                        else if (_notFoundInFileTokens.Count > 0)
                        {
                            <div class="mt-2 small">
                                <span class="text-white">Version pattern not found in file for</span>
                                @foreach (var t in _notFoundInFileTokens)
                                {
                                    <span class="badge version-config-not-found-badge ms-1">@t</span>
                                }
                            </div>
                        }

                        @if (selfReferencingTokens.Count > 0)
                        {
                            <div class="mt-2 small text-danger">
                                Circular reference: this file belongs to repository
                                <span class="font-monospace">@(File?.RepositoryName)</span>.
                                Tokens that reference the same repository
                                (<code>@("{@repo}")</code>, <code>@("{@repo:branch}")</code>, or <code>@("{@repo:commit}")</code>)
                                create a never-ending update cycle.
                            </div>
                        }

                    </div>
                </div>
                <div class="modal-footer">
                    @if (!string.IsNullOrWhiteSpace(patternText))
                    {
                        <button type="button" class="btn btn-outline-secondary me-auto" @onclick="ClearPattern">
                            Clear
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="RequestCloseAsync">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            data-default-action
                            disabled="@(selfReferencingTokens.Count > 0)"
                            @onclick="SaveAsync">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <ConfirmModal IsVisible="@_showDiscardConfirm"
                  Message="Changes were made. Do you want to cancel them?"
                  ConfirmButtonText="Discard"
                  ConfirmIsDanger="true"
                  OnConfirm="ConfirmDiscardAsync"
                  OnCancel="CloseDiscardConfirm" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public WorkspaceFeatureContextId ContextId { get; set; }
    [Parameter] public WorkspaceFileDto? File { get; set; }
    [Parameter] public List<WorkspaceRepoItem> WorkspaceRepos { get; set; } = new();
    [Parameter] public string? CurrentPattern { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string patternText = "";
    private string _initialPattern = "";
    private List<string> invalidTokens = new();
    private List<string> unsupportedSelectors = new();
    private List<FileVersionToken> selfReferencingTokens = new();
    private int validTokenCount;
    private bool _wasVisible;
    private ElementReference textareaRef;
    private ElementReference _suggestionsRef;

    private IReadOnlyList<string> _notFoundInFileTokens = [];
    private bool _fileValidating;
    private CancellationTokenSource? _validateCts;
    private bool _showDiscardConfirm;

    // Autocomplete state
    private bool showSuggestions;
    private List<string> filteredRepos = new();
    private int suggestionIndex;
    private int _atPos;
    private int _queryEnd;  // pre-computed end of @query - stable across Enter default-action timing
    private double _dropdownX;
    private double _dropdownY;
    private int _pendingCaret = -1;
    private bool _justOpened;
    private bool _escapeClosedSuggestions;

    private bool HasUnsavedChanges =>
        !string.Equals(patternText ?? "", _initialPattern ?? "", StringComparison.Ordinal);

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            patternText = CurrentPattern ?? "";
            _initialPattern = patternText;
            showSuggestions = false;
            _showDiscardConfirm = false;
            _escapeClosedSuggestions = false;
            _justOpened = true;
            _notFoundInFileTokens = [];
            _fileValidating = false;
            CancelValidateCts();
            Validate();
        }
        _wasVisible = IsVisible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_justOpened)
        {
            _justOpened = false;
            try { await JS.InvokeVoidAsync("versionPatternEditor.initAutocomplete", textareaRef); } catch { /* ignore */ }
            try { await textareaRef.FocusAsync(); } catch { /* ignore */ }
            try { await JS.InvokeVoidAsync("versionPatternEditor.autoResize", textareaRef); } catch { /* ignore */ }
            _ = InvokeAsync(() => ValidateAgainstFileAsync(CancellationToken.None, showSpinner: false));
        }
        if (IsVisible)
        {
            try { await JS.InvokeVoidAsync("versionPatternEditor.setAutocompleteActive", textareaRef, showSuggestions); } catch { /* ignore */ }
        }
        if (showSuggestions)
        {
            try { await JS.InvokeVoidAsync("versionPatternEditor.scrollActiveIntoView", _suggestionsRef); } catch { /* ignore */ }
        }
        if (_pendingCaret >= 0)
        {
            var pos = _pendingCaret;
            _pendingCaret = -1;
            try { await JS.InvokeVoidAsync("versionPatternEditor.setCaret", textareaRef, pos); } catch { /* ignore */ }
        }
    }

    private async Task OnPatternInput(ChangeEventArgs e)
    {
        patternText = e.Value?.ToString() ?? "";
        Validate();
        await JS.InvokeVoidAsync("versionPatternEditor.autoResize", textareaRef);
        await UpdateSuggestionsAsync();
        ScheduleFileValidation();
    }

    private async Task UpdateSuggestionsAsync()
    {
        var ctx = await JS.InvokeAsync<AtContext?>("versionPatternEditor.getAtContext", textareaRef);
        if (ctx == null)
        {
            showSuggestions = false;
            return;
        }
        _atPos = ctx.AtPos;
        var query = ctx.Query ?? "";
        _queryEnd = ctx.AtPos + 1 + query.Length;  // index right after the typed query chars
        filteredRepos = WorkspaceRepos
            .Select(r => r.RepositoryName)
            .Where(n => n.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n)
            .ToList();
        suggestionIndex = 0;
        if (filteredRepos.Count > 0)
        {
            var coords = await JS.InvokeAsync<DropdownCoords>("versionPatternEditor.getAtPixelCoords", textareaRef, _atPos);
            _dropdownX = coords.X;
            _dropdownY = coords.Y;
            showSuggestions = true;
        }
        else
        {
            showSuggestions = false;
        }
    }

    private sealed class InsertResult
    {
        public string Value { get; set; } = "";
        public int Caret { get; set; }
    }

    private sealed class DropdownCoords
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    private async Task OnTextareaKeyDown(KeyboardEventArgs e)
    {
        if (showSuggestions)
        {
            if (e.Key == "ArrowDown") { suggestionIndex = Math.Min(suggestionIndex + 1, filteredRepos.Count - 1); return; }
            if (e.Key == "ArrowUp") { suggestionIndex = Math.Max(suggestionIndex - 1, 0); return; }
            if (ModalKeyboard.IsPlainEnter(e) || e.Key == "Tab")
            {
                if (filteredRepos.Count > 0) await AcceptSuggestion(filteredRepos[suggestionIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                showSuggestions = false;
                _escapeClosedSuggestions = true;
                return;
            }
        }
    }

    private async Task AcceptSuggestion(string repoName)
    {
        var result = await JS.InvokeAsync<InsertResult>("versionPatternEditor.insertRepo", textareaRef, _atPos, _queryEnd, repoName);
        patternText = result.Value;
        _pendingCaret = result.Caret;
        showSuggestions = false;
        Validate();
    }

    private void Validate()
    {
        var repoNames = WorkspaceRepos.Select(r => r.RepositoryName)
                                      .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var result = FileVersionTokenParser.Validate(patternText, repoNames, File?.RepositoryName);
        invalidTokens = result.UnknownRepositories.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        unsupportedSelectors = result.UnsupportedSelectors.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        selfReferencingTokens = result.SelfReferencingTokens.ToList();
        validTokenCount = result.ValidTokens.Count;
    }

    private void ClearPattern()
    {
        patternText = "";
        invalidTokens.Clear();
        unsupportedSelectors.Clear();
        selfReferencingTokens.Clear();
        validTokenCount = 0;
        showSuggestions = false;
        CancelValidateCts();
        _notFoundInFileTokens = [];
        _fileValidating = false;
    }

    private async Task SaveAsync()
    {
        if (selfReferencingTokens.Count > 0)
            return;
        await OnSaved.InvokeAsync(patternText.Trim());
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;
        if (_showDiscardConfirm)
            return;
        // Textarea handler already closed the @ dropdown; do not treat this Escape as Cancel.
        if (_escapeClosedSuggestions)
        {
            _escapeClosedSuggestions = false;
            return;
        }
        if (showSuggestions)
        {
            showSuggestions = false;
            return;
        }
        await RequestCloseAsync();
    }

    private async Task RequestCloseAsync()
    {
        if (showSuggestions)
        {
            showSuggestions = false;
            return;
        }
        if (HasUnsavedChanges)
        {
            _showDiscardConfirm = true;
            return;
        }
        await OnCancel.InvokeAsync();
    }

    private void CloseDiscardConfirm()
    {
        _showDiscardConfirm = false;
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDiscardConfirm = false;
        await OnCancel.InvokeAsync();
    }

    private void CancelValidateCts()
    {
        _validateCts?.Cancel();
        _validateCts?.Dispose();
        _validateCts = null;
    }

    private void ScheduleFileValidation()
    {
        CancelValidateCts();
        var cts = new CancellationTokenSource();
        _validateCts = cts;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(2000, cts.Token);
                await ValidateAgainstFileAsync(cts.Token);
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task ValidateAgainstFileAsync(CancellationToken cancellationToken, bool showSpinner = true)
    {
        if (File == null || string.IsNullOrWhiteSpace(patternText)) return;
        _fileValidating = true;
        if (showSpinner) StateHasChanged();
        try
        {
            _notFoundInFileTokens = await VersionService.ValidatePatternAgainstFileAsync(
                WorkspaceId, ContextId, File.RepositoryName, File.FilePath, patternText, cancellationToken);
        }
        catch (OperationCanceledException) { return; }
        catch { _notFoundInFileTokens = []; }
        _fileValidating = false;
        StateHasChanged();
    }

    private sealed class AtContext
    {
        public int AtPos { get; set; }
        public string? Query { get; set; }
    }
}

