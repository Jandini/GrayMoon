@using GrayMoon.App.Models
@using GrayMoon.Abstractions.Workspaces
@using GrayMoon.App.Services.Workspaces

@if (IsVisible)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);"
         @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Workspace Name</label>
                        <input class="form-control workspace-name-input"
                               placeholder="Enter workspace name"
                               value="@WorkspaceName"
                               @oninput="OnNameChanged"
                               disabled="@IsNameDisabled"
                               @ref="firstInputElement" />
                        @if (IsNameDisabled && !string.IsNullOrWhiteSpace(NameDisabledHint))
                        {
                            <div class="form-text">@NameDisabledHint</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Workspace Path</label>
                        <input class="form-control workspace-path-input"
                               value="@WorkspacePath"
                               readonly
                               disabled />
                    </div>

                    <div class="mb-3">
                        <div class="form-label text-nowrap">Workspace type</div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="workspace-type" id="workspaceTypeDotNet"
                                   checked="@(Type == WorkspaceType.DotNetDependency)"
                                   disabled="@IsTypeDisabled"
                                   @onchange="() => OnTypeChosenAsync(WorkspaceType.DotNetDependency)" />
                            <label class="form-check-label" for="workspaceTypeDotNet">
                                .NET Dependency
                                <div class="form-text">Adds .NET projects, NuGet packages, dependency levels and package-aware push.</div>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="workspace-type" id="workspaceTypeBasic"
                                   checked="@(Type == WorkspaceType.Basic)"
                                   disabled="@IsTypeDisabled"
                                   @onchange="() => OnTypeChosenAsync(WorkspaceType.Basic)" />
                            <label class="form-check-label" for="workspaceTypeBasic">
                                Basic
                                <div class="form-text">Git repositories, branches, Features, pull requests, changes and files.</div>
                            </label>
                        </div>
                        @if (IsTypeDisabled && !string.IsNullOrWhiteSpace(TypeDisabledHint))
                        {
                            <div class="form-text">@TypeDisabledHint</div>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="workspaceUseGitVersion"
                                   checked="@UseGitVersion"
                                   @onchange="OnGitVersionChanged" />
                            <label class="form-check-label text-nowrap" for="workspaceUseGitVersion">Calculate versions with GitVersion</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="workspaceUseGitHubActions"
                                   checked="@UseGitHubActions"
                                   @onchange="OnGitHubActionsChanged" />
                            <label class="form-check-label text-nowrap" for="workspaceUseGitHubActions">GitHub Actions</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-nowrap" for="workspaceRepositorySelect">Workspace repository (optional)</label>
                        <div class="workspace-repository-picker @(IsWorkspaceRepositoryDisabled ? "disabled" : "")">
                            <input type="text"
                                   class="form-control workspace-repository-select"
                                   id="workspaceRepositorySelect"
                                   autocomplete="off"
                                   placeholder="@(_repositoryPickerOpen ? "Search repositories" : "None")"
                                   value="@(_repositoryPickerOpen ? _repositoryFilter : SelectedRepositoryDisplayName)"
                                   disabled="@IsWorkspaceRepositoryDisabled"
                                   @onfocus="OpenRepositoryPicker"
                                   @onclick="OpenRepositoryPicker"
                                   @onblur="CloseRepositoryPicker"
                                   @oninput="OnRepositoryFilterChanged"
                                   @onkeydown="OnRepositoryPickerKeyDown"
                                   @onkeydown:stopPropagation="_repositoryPickerOpen" />
                            @if (_repositoryPickerOpen && !IsWorkspaceRepositoryDisabled)
                            {
                                var filteredChoices = FilteredRepositoryChoices;
                                <div class="workspace-repository-list" role="listbox">
                                    <button type="button" role="option"
                                            class="workspace-repository-option text-nowrap @(WorkspaceRepositoryId is null ? "active" : "") @(_repositoryHighlightIndex == 0 ? "highlighted" : "")"
                                            @onmousedown="() => SelectRepositoryAsync(null)"
                                            @onmousedown:preventDefault>None</button>
                                    @for (var i = 0; i < filteredChoices.Count; i++)
                                    {
                                        var choice = filteredChoices[i];
                                        <button type="button" role="option"
                                                class="workspace-repository-option text-nowrap @(choice.RepositoryId == WorkspaceRepositoryId ? "active" : "") @(_repositoryHighlightIndex == i + 1 ? "highlighted" : "")"
                                                @onmousedown="() => SelectRepositoryAsync(choice.RepositoryId)"
                                                @onmousedown:preventDefault>@choice.DisplayName</button>
                                    }
                                    @if (filteredChoices.Count == 0)
                                    {
                                        <div class="workspace-repository-empty text-nowrap">No matching repositories</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="form-text">The Workspace's own Git repository. Its working tree is the Workspace root and it is the root of every Feature.</div>
                        @if (IsWorkspaceRepositoryDisabled && !string.IsNullOrWhiteSpace(WorkspaceRepositoryDisabledHint))
                        {
                            <div class="form-text">@WorkspaceRepositoryDisabledHint</div>
                        }
                    </div>

                    @if (DirectoryAlreadyExists)
                    {
                        <div class="gm-callout gm-callout--warning" role="alert">The workspace directory exists with @ExistingRepositoryCount @(ExistingRepositoryCount == 1 ? "repository" : "repositories").</div>
                    }

                    @if (ErrorMessage != null)
                    {
                        <div class="gm-callout gm-callout--error" role="alert">@ErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
                    <button type="button" class="btn btn-primary" data-default-action @onclick="OnSave" disabled="@(IsSaving || IsCheckingDirectory || SaveDisabled)">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference firstInputElement;

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Add Workspace";
    [Parameter] public string WorkspaceName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> WorkspaceNameChanged { get; set; }
    [Parameter] public string WorkspacePath { get; set; } = string.Empty;
    [Parameter] public bool DirectoryAlreadyExists { get; set; }
    [Parameter] public int ExistingRepositoryCount { get; set; }
    [Parameter] public bool IsNameDisabled { get; set; }
    [Parameter] public string? NameDisabledHint { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool IsCheckingDirectory { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public WorkspaceType Type { get; set; } = WorkspaceType.DotNetDependency;
    [Parameter] public EventCallback<WorkspaceType> TypeChanged { get; set; }
    [Parameter] public bool UseGitVersion { get; set; } = true;
    [Parameter] public EventCallback<bool> UseGitVersionChanged { get; set; }
    [Parameter] public bool UseGitHubActions { get; set; } = true;
    [Parameter] public EventCallback<bool> UseGitHubActionsChanged { get; set; }
    [Parameter] public bool IsTypeDisabled { get; set; }
    [Parameter] public string? TypeDisabledHint { get; set; }
    [Parameter] public int? WorkspaceRepositoryId { get; set; }
    [Parameter] public EventCallback<int?> WorkspaceRepositoryIdChanged { get; set; }
    [Parameter] public IReadOnlyList<WorkspaceRepositoryChoice> WorkspaceRepositoryChoices { get; set; } = Array.Empty<WorkspaceRepositoryChoice>();
    [Parameter] public bool IsWorkspaceRepositoryDisabled { get; set; }
    [Parameter] public string? WorkspaceRepositoryDisabledHint { get; set; }

    /// <summary>One entry of the "Workspace repository" select.</summary>
    public sealed record WorkspaceRepositoryChoice(int RepositoryId, string DisplayName);

    /// <summary>
    /// Imported repositories that can become the Workspace repository: every repository that is not already a
    /// Source of this Workspace (the Workspace's current Workspace repository is therefore included so an edit
    /// shows it selected), sorted by display name.
    /// </summary>
    public static IReadOnlyList<WorkspaceRepositoryChoice> BuildWorkspaceRepositoryChoices(
        IEnumerable<(int RepositoryId, string RepositoryName, string? OrgName)> repositories,
        IReadOnlySet<int> sourceRepositoryIds) =>
        repositories
            .Where(r => !sourceRepositoryIds.Contains(r.RepositoryId))
            .Select(r => new WorkspaceRepositoryChoice(
                r.RepositoryId,
                string.IsNullOrWhiteSpace(r.OrgName) ? r.RepositoryName : $"{r.OrgName}/{r.RepositoryName}"))
            .OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.RepositoryId)
            .ToList();

    private bool _wasVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_wasVisible && !IsNameDisabled)
        {
            _wasVisible = true;
            await firstInputElement.FocusAsync();
        }
        else if (!IsVisible)
        {
            _wasVisible = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
        else if (ModalKeyboard.IsPlainEnter(e) && !IsSaving && !IsCheckingDirectory && !SaveDisabled)
        {
            await OnSave.InvokeAsync();
        }
    }

    private async Task OnNameChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await WorkspaceNameChanged.InvokeAsync(value);
    }

    private async Task OnTypeChosenAsync(WorkspaceType type)
    {
        if (IsTypeDisabled)
            return;

        var defaults = WorkspaceProfileDefaults.ForType(type);
        await TypeChanged.InvokeAsync(type);
        await UseGitVersionChanged.InvokeAsync(defaults.Versioning == WorkspaceVersioningMode.GitVersion);
        await UseGitHubActionsChanged.InvokeAsync(defaults.Ci == WorkspaceCiProvider.GitHubActions);
    }

    private bool _repositoryPickerOpen;
    private string _repositoryFilter = string.Empty;
    private int _repositoryHighlightIndex;

    private IReadOnlyList<WorkspaceRepositoryChoice> FilteredRepositoryChoices =>
        FilterWorkspaceRepositoryChoices(WorkspaceRepositoryChoices, _repositoryFilter);

    private string SelectedRepositoryDisplayName =>
        WorkspaceRepositoryChoices.FirstOrDefault(c => c.RepositoryId == WorkspaceRepositoryId)?.DisplayName ?? "None";

    /// <summary>Case-insensitive "contains" filter on display name; an empty term returns all, order preserved.</summary>
    public static IReadOnlyList<WorkspaceRepositoryChoice> FilterWorkspaceRepositoryChoices(
        IEnumerable<WorkspaceRepositoryChoice> choices, string? term)
    {
        var trimmed = term?.Trim();
        if (string.IsNullOrEmpty(trimmed))
            return choices.ToList();
        return choices
            .Where(c => c.DisplayName.Contains(trimmed, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    /// <summary>Clamps a highlight move within the picker list, where index 0 is "None" and 1..n are the filtered choices. No wrapping.</summary>
    public static int MoveRepositoryHighlight(int currentIndex, int delta, int filteredChoiceCount)
    {
        var lastIndex = Math.Max(filteredChoiceCount, 0);
        return Math.Clamp(currentIndex + delta, 0, lastIndex);
    }

    /// <summary>Highlight index after the filter text changes: the first filtered choice (index 1), or "None" (index 0) when nothing matches.</summary>
    public static int ResetRepositoryHighlight(int filteredChoiceCount) => filteredChoiceCount > 0 ? 1 : 0;

    private void OpenRepositoryPicker()
    {
        if (IsWorkspaceRepositoryDisabled || _repositoryPickerOpen)
            return;
        _repositoryFilter = string.Empty;
        _repositoryPickerOpen = true;
        var selectedIndex = FilteredRepositoryChoices.ToList().FindIndex(c => c.RepositoryId == WorkspaceRepositoryId);
        _repositoryHighlightIndex = selectedIndex >= 0 ? selectedIndex + 1 : 0;
    }

    private void CloseRepositoryPicker() => _repositoryPickerOpen = false;

    private void OnRepositoryFilterChanged(ChangeEventArgs e)
    {
        _repositoryFilter = e.Value?.ToString() ?? string.Empty;
        _repositoryHighlightIndex = ResetRepositoryHighlight(FilteredRepositoryChoices.Count);
    }

    private async Task OnRepositoryPickerKeyDown(KeyboardEventArgs e)
    {
        if (!_repositoryPickerOpen)
            return;

        switch (e.Key)
        {
            case "Escape":
                _repositoryPickerOpen = false;
                break;
            case "ArrowDown":
                _repositoryHighlightIndex = MoveRepositoryHighlight(_repositoryHighlightIndex, 1, FilteredRepositoryChoices.Count);
                break;
            case "ArrowUp":
                _repositoryHighlightIndex = MoveRepositoryHighlight(_repositoryHighlightIndex, -1, FilteredRepositoryChoices.Count);
                break;
            case "Enter":
            case "NumpadEnter":
                var filtered = FilteredRepositoryChoices;
                if (filtered.Count == 0 && !string.IsNullOrWhiteSpace(_repositoryFilter))
                    break;
                if (_repositoryHighlightIndex <= 0)
                    await SelectRepositoryAsync(null);
                else if (_repositoryHighlightIndex <= filtered.Count)
                    await SelectRepositoryAsync(filtered[_repositoryHighlightIndex - 1].RepositoryId);
                break;
        }
    }

    private async Task SelectRepositoryAsync(int? id)
    {
        if (IsWorkspaceRepositoryDisabled)
            return;

        _repositoryPickerOpen = false;
        await WorkspaceRepositoryIdChanged.InvokeAsync(id);
    }
    private Task OnGitVersionChanged(ChangeEventArgs e) =>
        UseGitVersionChanged.InvokeAsync(e.Value is true or "true" or "on");

    private Task OnGitHubActionsChanged(ChangeEventArgs e) =>
        UseGitHubActionsChanged.InvokeAsync(e.Value is true or "true" or "on");
}
