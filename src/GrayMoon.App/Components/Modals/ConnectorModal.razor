@using GrayMoon.App.Models
@using GrayMoon.App.Services.Connectors
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject ConnectorEndpointTester EndpointTester
@inject ILogger<ConnectorModal> Logger

@if (IsVisible)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);"
         @onkeydown="HandleKeyDown"
         @ref="_modalElement">
        <div class="modal-dialog @(Mode == ConnectorModalMode.Delete ? "" : "modal-lg")">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body" id="connector-modal-body">
                    @if ((Mode == ConnectorModalMode.Create || Mode == ConnectorModalMode.Edit) && Model != null)
                    {
                        <EditForm Model="@Model" OnValidSubmit="@(_ => HandleValidSubmitAsync())">
                            <DataAnnotationsValidator />

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Connector Name <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="Model.ConnectorName" />
                                    <ValidationMessage For="@(() => Model.ConnectorName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Connector Type <span class="text-danger">*</span></label>
                                    <div class="dropdown">
                                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start d-flex align-items-center gap-2 justify-content-between"
                                                type="button"
                                                style="border-color: var(--border-input) !important;"
                                                @onclick="ToggleTypeDropdown">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi @ConnectorTypeIcon"></i>
                                                @ConnectorTypeLabel
                                            </span>
                                        </button>
                                        @if (_typeDropdownOpen)
                                        {
                                            <ul class="dropdown-menu show w-100">
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                            @onclick="() => SelectConnectorType(ConnectorType.GitHub)">
                                                        <i class="bi bi-github"></i> GitHub
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                            @onclick="() => SelectConnectorType(ConnectorType.NuGet)">
                                                        <i class="bi bi-box-seam"></i> NuGet
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                            @onclick="() => SelectConnectorType(ConnectorType.ProGet)">
                                                        <i class="bi bi-boxes"></i> ProGet
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                    <ValidationMessage For="@(() => Model.ConnectorType)" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@AddressLabel <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text"
                                           class="form-control"
                                           list="connector-api-base-url-list"
                                           @ref="_apiBaseUrlInput"
                                           @bind="Model.ApiBaseUrl"
                                           @bind:event="oninput"
                                           @bind:after="OnApiBaseUrlEdited"
                                           placeholder="@ApiBaseUrlPlaceholder" />
                                    @if (_urlMark is { } urlOk)
                                    {
                                        <span class="@(urlOk ? "connector-field-mark connector-field-mark--ok" : "connector-field-mark connector-field-mark--failed")"
                                              role="status"
                                              title="@_markTitle"
                                              aria-label="@_markTitle">
                                            <i class="bi @(urlOk ? "bi-check-lg" : "bi-x-lg")" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <button type="button"
                                            class="btn btn-outline-secondary connector-attached-btn text-nowrap"
                                            title="@TestButtonTitle"
                                            disabled="@(_isTesting || IsSubmitting || string.IsNullOrWhiteSpace(Model.ApiBaseUrl))"
                                            @onclick="TestApiBaseUrlAsync">
                                        @if (_isTesting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Test
                                    </button>
                                </div>
                                <datalist id="connector-api-base-url-list">
                                    <option value="@ConnectorUrlResolver.GitHubApiUrl"></option>
                                    <option value="@ConnectorUrlResolver.NuGetOrgIndexUrl"></option>
                                    @if (ApiBaseUrlHints != null)
                                    {
                                        @foreach (var h in ApiBaseUrlHints.Where(x => !string.IsNullOrWhiteSpace(x)))
                                        {
                                            <option value="@h!.Trim()"></option>
                                        }
                                    }
                                </datalist>
                                <div class="form-text">@ApiBaseUrlHelp</div>
                                @if (_urlMessage != null)
                                {
                                    <div class="connector-field-error" role="alert">@_urlMessage</div>
                                }
                                <ValidationMessage For="@(() => Model.ApiBaseUrl)" />
                            </div>

                            @if (ShouldShowUserNameField() || ShouldShowTokenField())
                            {
                                <div class="row mb-3">
                                    @if (IsProGet)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label">Feed <span class="text-danger">*</span></label>
                                            <div class="position-relative">
                                                <div class="input-group">
                                                    <input type="text"
                                                           class="form-control"
                                                           autocomplete="off"
                                                           role="combobox"
                                                           aria-expanded="@(_feedListOpen ? "true" : "false")"
                                                           aria-controls="connector-feed-list"
                                                           @ref="_feedInput"
                                                           @bind="Model.FeedName"
                                                           @bind:event="oninput"
                                                           @bind:after="OnFeedEdited"
                                                           @onkeydown="OnFeedKeyDownAsync"
                                                           @onkeydown:stopPropagation="_feedListOpen"
                                                           @onblur="CloseFeedList"
                                                           placeholder="Feed name" />
                                                    @if (_feedMark is { } feedMarkOk)
                                                    {
                                                        <span class="@(feedMarkOk ? "connector-field-mark connector-field-mark--ok" : "connector-field-mark connector-field-mark--failed")"
                                                              role="status"
                                                              title="@_markTitle"
                                                              aria-label="@_markTitle">
                                                            <i class="bi @(feedMarkOk ? "bi-check-lg" : "bi-x-lg")" aria-hidden="true"></i>
                                                        </span>
                                                    }
                                                    <button type="button"
                                                            class="btn btn-outline-secondary connector-attached-btn"
                                                            tabindex="-1"
                                                            title="Show the feeds on this server"
                                                            aria-label="Show the feeds on this server"
                                                            @onmousedown:preventDefault
                                                            @onclick="ToggleFeedListAsync">
                                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                                @if (_feedListOpen)
                                                {
                                                    var visibleFeeds = VisibleFeeds;
                                                    <ul class="connector-feed-list" id="connector-feed-list" role="listbox" @onmousedown:preventDefault>
                                                        @if (_feedsLoading)
                                                        {
                                                            <li class="connector-feed-list__note">
                                                                <span class="spinner-border spinner-border-sm me-2"></span>Loading feeds...
                                                            </li>
                                                        }
                                                        else if (visibleFeeds.Count == 0)
                                                        {
                                                            <li class="connector-feed-list__note">@(_feedListNote ?? "No feed matches - the name is used as typed.")</li>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var feed in visibleFeeds)
                                                            {
                                                                var isCurrent = string.Equals(feed, Model.FeedName?.Trim(), StringComparison.OrdinalIgnoreCase);
                                                                <li class="@(isCurrent ? "connector-feed-list__item connector-feed-list__item--active" : "connector-feed-list__item")"
                                                                    role="option"
                                                                    aria-selected="@(isCurrent ? "true" : "false")"
                                                                    @onclick="() => SelectFeed(feed)">
                                                                    @feed
                                                                </li>
                                                            }
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                            @if (_feedMessage != null)
                                            {
                                                <div class="connector-field-error" role="alert">@_feedMessage</div>
                                            }
                                            <ValidationMessage For="@(() => Model.FeedName)" />
                                        </div>
                                    }
                                    @if (ShouldShowUserNameField())
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label">User Name</label>
                                            <InputText class="form-control" @bind-Value="Model.UserName" />
                                            <ValidationMessage For="@(() => Model.UserName)" />
                                        </div>
                                    }
                                    @if (ShouldShowTokenField())
                                    {
                                        <div class="@(ShouldShowUserNameField() || IsProGet ? "col-md-6" : "col-12")">
                                            <label class="form-label">
                                                @TokenLabel
                                                @if (IsTokenRequired())
                                                {
                                                    <span class="text-danger">*</span>
                                                }
                                            </label>
                                            <div class="input-group">
                                                <InputText class="form-control" type="password" @bind-Value="Model.UserToken" @bind-Value:after="OnUserTokenEdited" />
                                                @if (_tokenMark is { } tokenOk)
                                                {
                                                    <span class="@(tokenOk ? "connector-field-mark connector-field-mark--ok" : "connector-field-mark connector-field-mark--failed")"
                                                          role="status"
                                                          title="@_markTitle"
                                                          aria-label="@_markTitle">
                                                        <i class="bi @(tokenOk ? "bi-check-lg" : "bi-x-lg")" aria-hidden="true"></i>
                                                    </span>
                                                }
                                                @if (ConnectorUrlResolver.OffersTokenPage(Model.ConnectorType, Model.ApiBaseUrl))
                                                {
                                                    var tokenPageUrl = ConnectorUrlResolver.GetTokenPageUrl(Model.ConnectorType, Model.ApiBaseUrl);
                                                    if (tokenPageUrl != null)
                                                    {
                                                        <a class="btn btn-outline-secondary connector-attached-btn text-nowrap"
                                                           href="@tokenPageUrl"
                                                           target="_blank"
                                                           rel="noopener noreferrer"
                                                           title="Create a classic personal access token on GitHub">
                                                            Create
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-secondary connector-attached-btn text-nowrap"
                                                                title="Create a classic personal access token on GitHub"
                                                                @onclick="ExplainTokenPageNeedsUrlAsync">
                                                            Create
                                                        </button>
                                                    }
                                                }
                                            </div>
                                            @if (_tokenMessage != null)
                                            {
                                                <div class="connector-field-error" role="alert">@_tokenMessage</div>
                                            }
                                            <ValidationMessage For="@(() => Model.UserToken)" />
                                        </div>
                                    }
                                </div>
                            }

                            @if (ErrorMessage != null)
                            {
                                <div class="gm-callout gm-callout--error" role="alert">@ErrorMessage</div>
                            }
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
                                <button type="submit" class="btn btn-primary" data-default-action disabled="@(IsSubmitting || _isTesting)">
                                    @if (IsSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @(IsSubmitting ? (Mode == ConnectorModalMode.Edit ? "Updating..." : "Adding...") : SubmitButtonText)
                                </button>
                            </div>
                        </EditForm>
                    }
                    else if (Mode == ConnectorModalMode.Delete)
                    {
                        <p>Are you sure you want to delete <strong>@ConnectorName</strong>?</p>
                        @if (!string.IsNullOrWhiteSpace(DeleteNote))
                        {
                            <p class="text-muted">@DeleteNote</p>
                        }
                        @if (ErrorMessage != null)
                        {
                            <div class="gm-callout gm-callout--error" role="alert">@ErrorMessage</div>
                        }
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
                            <button type="button" class="btn btn-danger" data-default-action @onclick="() => OnDelete.InvokeAsync()" disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Delete
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string TokenPageNeedsUrlMessage = "API Base URL is required to create a token.";

    private bool IsProGet => Model?.ConnectorType == ConnectorType.ProGet;
    private string AddressLabel => IsProGet ? "Server URL" : "API Base URL";
    private string TokenLabel => IsProGet ? "API Key" : "User Token";
    private string TestButtonTitle => IsProGet ? "Find the ProGet server and the feed, and check them" : "Find the API endpoint and check it";

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public ConnectorModalMode Mode { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public ConnectorForm? Model { get; set; }
    [Parameter] public string? ConnectorName { get; set; }
    [Parameter] public IReadOnlyList<string>? ApiBaseUrlHints { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    /// <summary>Delete mode: what stays behind when the connector goes. Null for none.</summary>
    [Parameter] public string? DeleteNote { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string SubmitButtonText => Mode == ConnectorModalMode.Edit ? "Update" : "Add";
    private bool _wasVisible;
    private bool _typeDropdownOpen;
    private ElementReference _modalElement;
    private ElementReference _apiBaseUrlInput;

    /// <summary>The form the per-opening state below belongs to; a new one (the dialog was opened again) resets it.</summary>
    private ConnectorForm? _stateModel;
    /// <summary>Create mode: the name the dialog itself filled in. While the name box still holds it, the name follows the type and the owner. Null in Edit mode.</summary>
    private string? _autoName;
    private bool _isTesting;
    /// <summary>Tick (true) or X (false) at the end of the address box; null before a test and after the address changed.</summary>
    private bool? _urlMark;
    /// <summary>Tick or X at the end of the token box: the token was accepted or rejected by the found endpoint.</summary>
    private bool? _tokenMark;
    /// <summary>The test result in words, shown as the tooltip of the marks.</summary>
    private string? _markTitle;
    /// <summary>Why the address failed, under the address box. A success shows the tick only.</summary>
    private string? _urlMessage;
    /// <summary>Why the token failed, under the token box.</summary>
    private string? _tokenMessage;
    /// <summary>ProGet: tick or X at the end of the Feed box.</summary>
    private bool? _feedMark;
    /// <summary>ProGet: what is wrong with the feed (not named yet, or not on the server), under the Feed box.</summary>
    private string? _feedMessage;
    /// <summary>ProGet: the server's NuGet feeds, loaded when the Feed dropdown is opened (or by a test), offered in the dropdown.</summary>
    private IReadOnlyList<string> _feedSuggestions = [];
    /// <summary>ProGet: the server address and key <see cref="_feedSuggestions"/> were loaded for; another pair loads again.</summary>
    private (string Server, string Key)? _feedsLoadedFor;
    private bool _feedListOpen;
    private bool _feedsLoading;
    /// <summary>What was typed in the Feed box, narrowing the dropdown; null (opened with the button) shows every feed.</summary>
    private string? _feedFilter;
    /// <summary>Why the dropdown has no feeds to offer (no key yet, the key may not list feeds, the server was not found).</summary>
    private string? _feedListNote;
    private ElementReference _feedInput;
    private CancellationTokenSource? _feedListCts;
    private CancellationTokenSource? _testCts;

    private IReadOnlyList<string> VisibleFeeds
    {
        get
        {
            var filter = _feedFilter?.Trim();
            return string.IsNullOrEmpty(filter)
                ? _feedSuggestions
                : _feedSuggestions.Where(f => f.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private string ApiBaseUrlPlaceholder => Model?.ConnectorType switch
    {
        ConnectorType.NuGet => "e.g. https://nuget.pkg.github.com/your-org/ or https://github.com/your-org/repository",
        ConnectorType.ProGet => "e.g. https://proget.example.com or https://proget.example.com/nuget/feed-name/v3/index.json",
        _ => "e.g. https://github.com/owner/repository or https://api.github.com/"
    };

    private string ApiBaseUrlHelp => Model?.ConnectorType switch
    {
        ConnectorType.NuGet => "Paste the feed URL, or a GitHub repository or organization URL, then click Test. GrayMoon finds the feed and checks it.",
        ConnectorType.ProGet => "Paste the ProGet address or a feed URL, then click Test. GrayMoon finds the server and the feed and checks them.",
        _ => "Paste the API URL or any repository URL, then click Test. GrayMoon finds the API endpoint and checks it."
    };

    protected override void OnParametersSet()
    {
        var model = IsVisible && Mode != ConnectorModalMode.Delete ? Model : null;
        if (ReferenceEquals(model, _stateModel))
            return;

        _stateModel = model;
        _autoName = model != null && Mode == ConnectorModalMode.Create ? model.ConnectorName : null;
        _typeDropdownOpen = false;
        ResetFeedList();
        ClearUrlStatus();

        // A saved ProGet connector holds the feed endpoint; the dialog shows it as server and feed.
        if (model != null)
            ConnectorFormAutoFill.SplitProGetAddress(model);
    }

    private string ConnectorTypeLabel => Model?.ConnectorType switch
    {
        ConnectorType.GitHub => "GitHub",
        ConnectorType.NuGet => "NuGet",
        ConnectorType.ProGet => "ProGet",
        _ => "Select type"
    };

    private string ConnectorTypeIcon => Model?.ConnectorType switch
    {
        ConnectorType.GitHub => "bi-github",
        ConnectorType.NuGet => "bi-box-seam",
        ConnectorType.ProGet => "bi-boxes",
        _ => "bi-chevron-down"
    };

    private void ToggleTypeDropdown() => _typeDropdownOpen = !_typeDropdownOpen;

    private void SelectConnectorType(ConnectorType type)
    {
        if (Model == null) return;
        _typeDropdownOpen = false;
        var previous = Model.ConnectorType;
        if (previous == type) return;

        Model.ConnectorType = type;
        ConnectorFormAutoFill.ApplyTypeChange(Model, previous);
        ApplyAutoName(ConnectorUrlResolver.DefaultName(type));
        ResetFeedList();
        ClearUrlStatus();
    }

    /// <summary>Renames the connector only while the name box still holds the name the dialog put there.</summary>
    private void ApplyAutoName(string name)
    {
        if (Model != null)
            _autoName = ConnectorFormAutoFill.ApplyName(Model, _autoName, name);
    }

    /// <summary>The address changed, so a result shown for the old one no longer holds; a test still running is dropped.</summary>
    private void OnApiBaseUrlEdited()
    {
        ResetFeedList();
        ClearUrlStatus();
    }

    /// <summary>The token changed, so its mark no longer holds. The address mark stays: the endpoint is still the one that was found.</summary>
    private void OnUserTokenEdited()
    {
        _tokenMark = null;
        _tokenMessage = null;
        ResetFeedList(); // another key may list other feeds
    }

    /// <summary>ProGet: forgets the loaded feeds (another server or key) and closes the dropdown; a load still running is dropped.</summary>
    private void ResetFeedList()
    {
        CancelFeedListLoad();
        _feedSuggestions = [];
        _feedsLoadedFor = null;
        _feedListOpen = false;
        _feedsLoading = false;
        _feedFilter = null;
        _feedListNote = null;
    }

    private void CancelFeedListLoad()
    {
        var cts = _feedListCts;
        _feedListCts = null;
        if (cts == null)
            return;
        cts.Cancel();
        cts.Dispose();
    }

    private void CloseFeedList() => _feedListOpen = false;

    /// <summary>The dropdown button: opens the list with every feed (loading it when needed), or closes it. The caret stays in the Feed box.</summary>
    private async Task ToggleFeedListAsync()
    {
        if (_feedListOpen)
        {
            _feedListOpen = false;
            return;
        }

        try
        {
            await _feedInput.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            Logger.LogDebug(ex, "Could not focus the Feed box.");
        }

        await OpenFeedListAsync();
    }

    private async Task OpenFeedListAsync()
    {
        _feedFilter = null;
        _feedListOpen = true;
        await LoadFeedsAsync();
    }

    /// <summary>Loads the server's feeds once per server address and key; the dropdown shows a loading row meanwhile.</summary>
    private async Task LoadFeedsAsync()
    {
        var model = Model;
        if (model == null)
            return;

        var source = ((model.ApiBaseUrl ?? string.Empty).Trim(), (model.UserToken ?? string.Empty).Trim());
        if (_feedsLoading || _feedsLoadedFor == source)
            return;

        CancelFeedListLoad();
        var cts = _feedListCts = new CancellationTokenSource();
        _feedsLoading = true;
        _feedListNote = null;
        StateHasChanged();
        try
        {
            var result = await EndpointTester.ListProGetFeedsAsync(source.Item1, source.Item2, cts.Token);
            if (!ReferenceEquals(_feedListCts, cts) || !ReferenceEquals(model, _stateModel))
                return;

            _feedSuggestions = result.Feeds;
            _feedListNote = result.Message;
            _feedsLoadedFor = source;
        }
        catch (OperationCanceledException)
        {
            // The address, the key or the dialog changed; the list is loaded again when it is opened.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the ProGet feed list failed unexpectedly.");
            if (ReferenceEquals(_feedListCts, cts))
                _feedListNote = $"The feeds could not be listed: {ex.Message}";
        }
        finally
        {
            if (ReferenceEquals(_feedListCts, cts))
            {
                _feedListCts = null;
                _feedsLoading = false;
                cts.Dispose();
            }
        }
    }

    private void SelectFeed(string feed)
    {
        if (Model == null)
            return;
        Model.FeedName = feed;
        ClearFeedMarks();
        _feedListOpen = false;
    }

    /// <summary>
    /// Feed box keys: Escape closes the dropdown (and not the dialog), Down / Up open it and then walk the offered
    /// feeds, putting each in the box.
    /// </summary>
    private async Task OnFeedKeyDownAsync(KeyboardEventArgs e)
    {
        if (Model == null)
            return;

        if (e.Key == "Escape")
        {
            _feedListOpen = false;
            return;
        }

        if (e.Key is not ("ArrowDown" or "ArrowUp"))
            return;

        if (!_feedListOpen)
        {
            await OpenFeedListAsync();
            return;
        }

        var feeds = VisibleFeeds;
        if (_feedsLoading || feeds.Count == 0)
            return;

        var current = -1;
        for (var i = 0; i < feeds.Count; i++)
        {
            if (string.Equals(feeds[i], Model.FeedName?.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                current = i;
                break;
            }
        }

        var next = e.Key == "ArrowDown"
            ? (current + 1) % feeds.Count
            : (current <= 0 ? feeds.Count - 1 : current - 1);
        Model.FeedName = feeds[next];
        ClearFeedMarks();
    }

    private void ClearUrlStatus()
    {
        CancelRunningTest();
        _isTesting = false;
        ClearMarks();
    }

    /// <summary>ProGet: the feed changed, so the feed and key marks no longer hold. The server mark stays.</summary>
    private void OnFeedEdited()
    {
        ClearFeedMarks();

        // Typing narrows the feeds already loaded, like autocomplete; loading them is left to the dropdown button.
        _feedFilter = Model?.FeedName;
        if (_feedSuggestions.Count > 0)
            _feedListOpen = VisibleFeeds.Count > 0;
    }

    private void ClearFeedMarks()
    {
        _feedMark = null;
        _feedMessage = null;
        _tokenMark = null;
        _tokenMessage = null;
    }

    private void ClearMarks()
    {
        _urlMark = null;
        _tokenMark = null;
        _feedMark = null;
        _markTitle = null;
        _urlMessage = null;
        _tokenMessage = null;
        _feedMessage = null;
    }

    /// <summary>ProGet: the server is fine but the feed is not named or not there: X at the Feed box and the reason under it.</summary>
    private void SetFeedFailure(string message)
    {
        _feedMark = false;
        _feedMessage = message;
    }

    /// <summary>The address itself is wrong or leads nowhere: X at the address box and the reason under it.</summary>
    private void SetUrlFailure(string message)
    {
        ClearMarks();
        _urlMark = false;
        _markTitle = message;
        _urlMessage = message;
    }

    /// <summary>
    /// Shows a test result as marks. A found endpoint ticks the address box. The token box gets a tick when the
    /// endpoint accepted the token and an X with the reason when it refused it; without a token it gets no mark.
    /// </summary>
    private void ShowTestResult(ConnectorEndpointTestResult result, bool tokenEntered)
    {
        if (!result.EndpointFound && result.ServerUrl == null)
        {
            SetUrlFailure(result.Message);
            return;
        }

        ClearMarks();
        _urlMark = true;
        _markTitle = result.Message;
        if (!result.EndpointFound)
        {
            // ProGet: the server answered, the feed is missing or unknown.
            SetFeedFailure(result.Message);
            return;
        }

        if (result.Feed != null)
            _feedMark = true;

        if (result.Outcome == ConnectorEndpointTestOutcome.Failed)
        {
            _tokenMark = false;
            _tokenMessage = result.Message;
        }
        else if (result.Outcome == ConnectorEndpointTestOutcome.Ok && tokenEntered)
        {
            _tokenMark = true;
        }
    }

    private void CancelRunningTest()
    {
        var cts = _testCts;
        _testCts = null;
        if (cts == null)
            return;
        cts.Cancel();
        cts.Dispose();
    }

    private Task TestApiBaseUrlAsync() => RunEndpointTestAsync();

    /// <summary>
    /// Finds and checks the endpoint behind the address, puts the found address in the box and shows the result under
    /// it. Returns null when the test was dropped (the address changed or the dialog closed) or could not run.
    /// </summary>
    private async Task<ConnectorEndpointTestResult?> RunEndpointTestAsync()
    {
        var model = Model;
        if (model == null)
            return null;

        CancelRunningTest();
        var cts = _testCts = new CancellationTokenSource();
        var token = cts.Token;
        _isTesting = true;
        ClearMarks();
        try
        {
            var result = await EndpointTester.TestAsync(model.ConnectorType, model.ApiBaseUrl, model.UserName, model.UserToken, token, model.FeedName);
            if (!ReferenceEquals(_testCts, cts) || !ReferenceEquals(model, _stateModel))
                return null;

            if (result.ServerUrl != null)
            {
                // ProGet: the box keeps the server, the feed has its own box; the two are joined when saving.
                model.ApiBaseUrl = result.ServerUrl;
                if (result.Feeds.Count > 0)
                {
                    // The test listed the feeds already; the dropdown offers them without asking again.
                    _feedSuggestions = result.Feeds;
                    _feedListNote = null;
                    _feedsLoadedFor = (result.ServerUrl.Trim(), (model.UserToken ?? string.Empty).Trim());
                }
                if (result.EndpointFound)
                {
                    model.FeedName = result.Feed;
                    ApplyAutoName(ConnectorUrlResolver.DefaultName(model.ConnectorType, result.Feed));
                }
            }
            else if (result.ResolvedUrl != null)
            {
                model.ApiBaseUrl = result.ResolvedUrl;
                ApplyAutoName(ConnectorUrlResolver.DefaultName(model.ConnectorType, result.Owner));
            }

            ShowTestResult(result, tokenEntered: !string.IsNullOrWhiteSpace(model.UserToken));
            return result;
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Connector endpoint test failed unexpectedly.");
            if (ReferenceEquals(_testCts, cts))
                SetUrlFailure($"The test could not run: {ex.Message}");
            return null;
        }
        finally
        {
            if (ReferenceEquals(_testCts, cts))
            {
                _testCts = null;
                _isTesting = false;
                cts.Dispose();
            }
        }
    }

    /// <summary>
    /// Add / Update. An address that is not the endpoint yet (a repository URL, a host) goes through the same step as
    /// the Test button first, so it is never saved as typed; an address that already is the endpoint is saved as is.
    /// </summary>
    private async Task HandleValidSubmitAsync()
    {
        if (Model == null || _isTesting)
            return;

        var resolution = ConnectorUrlResolver.Resolve(Model.ConnectorType, Model.ApiBaseUrl, Model.FeedName);
        if (resolution.Kind == ConnectorEndpointKind.ProGet)
        {
            await SubmitProGetAsync(Model, resolution);
            return;
        }

        if (!resolution.IsValid)
        {
            SetUrlFailure(resolution.Error!);
            return;
        }

        if (!resolution.IsExact)
        {
            var result = await RunEndpointTestAsync();
            if (result is not { EndpointFound: true })
                return;
        }

        await OnSubmit.InvokeAsync();
    }

    /// <summary>
    /// ProGet is saved with the feed endpoint. With a feed named (in the address or the Feed box) the endpoint is
    /// known and saved without a request; without one, the Test step runs first and may find the only feed.
    /// The box shows the server again afterwards, in case the save failed and the dialog stays open.
    /// </summary>
    private async Task SubmitProGetAsync(ConnectorForm model, ConnectorUrlResolution resolution)
    {
        if (!resolution.IsValid)
        {
            ClearMarks();
            SetFeedFailure(resolution.Error!);
            return;
        }

        if (resolution.Feed == null)
        {
            var result = await RunEndpointTestAsync();
            if (result == null)
                return;
            if (!result.EndpointFound)
            {
                if (result.ServerUrl != null && result.Feeds.Count == 0)
                    SetFeedFailure(ConnectorUrlResolver.FeedRequiredMessage);
                return;
            }

            resolution = ConnectorUrlResolver.Resolve(ConnectorType.ProGet, model.ApiBaseUrl, model.FeedName);
            if (!resolution.IsValid || resolution.Feed == null)
                return;
        }

        model.FeedName = resolution.Feed;
        model.ApiBaseUrl = resolution.Candidates[0];
        try
        {
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            model.ApiBaseUrl = resolution.ServerUrl!;
        }
    }

    private async Task ExplainTokenPageNeedsUrlAsync()
    {
        if (Model == null)
            return;

        var message = string.IsNullOrWhiteSpace(Model.ApiBaseUrl)
            ? TokenPageNeedsUrlMessage
            : ConnectorUrlResolver.Resolve(Model.ConnectorType, Model.ApiBaseUrl).Error ?? TokenPageNeedsUrlMessage;
        SetUrlFailure(message);
        try
        {
            await _apiBaseUrlInput.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            // The message is already shown; moving the caret is a convenience.
            Logger.LogDebug(ex, "Could not focus the API Base URL box.");
        }
    }

    public void Dispose()
    {
        CancelRunningTest();
        CancelFeedListLoad();
    }

    private bool ShouldShowUserNameField()
    {
        if (Model == null) return true;
        return ConnectorHelpers.ShouldShowUserNameField(Model.ConnectorType, Model.ApiBaseUrl ?? string.Empty);
    }

    private bool ShouldShowTokenField()
    {
        if (Model == null) return true;
        return ConnectorHelpers.ShouldShowTokenField(Model.ConnectorType, Model.ApiBaseUrl ?? string.Empty);
    }

    private bool IsTokenRequired()
    {
        if (Model == null) return true;
        return ConnectorHelpers.RequiresToken(Model.ConnectorType, Model.ApiBaseUrl ?? string.Empty);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            if (Mode == ConnectorModalMode.Create || Mode == ConnectorModalMode.Edit)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("focusFirstModalInput", "connector-modal-body");
                }
                catch
                {
                    await _modalElement.FocusAsync();
                }
            }
            else
            {
                await _modalElement.FocusAsync();
            }
        }
        else if (!IsVisible)
        {
            _wasVisible = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
        else if (Mode == ConnectorModalMode.Delete
            && ModalSubmitGuard.CanSubmit(ModalKeyboard.IsPlainEnter(e), e.Repeat, IsSubmitting))
        {
            // Same guard as the Delete button (disabled while submitting): a held or repeated Enter deletes once.
            await OnDelete.InvokeAsync();
        }
    }
}
