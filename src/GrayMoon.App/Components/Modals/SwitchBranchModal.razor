    protected override async Task OnParametersSetAsync()
    {
        var busyJustEnded = _wasBusy && !IsBusy;
        _wasBusy = IsBusy;

        if (IsVisible)
        {
            if (!_prevVisible)
            {
                // Modal just opened: reset to InitialTab when provided (e.g. "tags" from upgrade badge), otherwise Locals
                activeTab = InitialTab ?? "local";
                newBranchName = "";
                selectedBaseBranch = "__default__";
                showBasedOnDropdown = false;
                showBranchExistsConfirmation = false;
                createWithUpstream = false;
                branchExistsConfirmMessage = "";
                _pendingCreateName = null;
                _pendingCreateBaseBranch = null;
                _pendingCreateSetUpstream = false;
                errorMessage = null;
                branchFilter = "";
                branchToDelete = null;
                _awaitingForceDeleteConfirmation = false;
                _prevVisible = true;
                _focusFilterOnNextRender = true;
                currentBranchLocal = CurrentBranch;
                await LoadBranchesAsync();
            }
            else
            {
                currentBranchLocal = CurrentBranch;
                // Reload lists after a page job (Fetch) finishes so the overlay path can persist then re-read.
                if (busyJustEnded)
                    await ReloadListsAfterPageJobAsync();
            }
        }
        else
        {
            _prevVisible = false;
        }
    }

    private async Task OnFetchClicked()
    {
        if (IsBusy || isRefreshing)
            return;
        await OnFetchBranches.InvokeAsync();
    }

    private async Task ReloadListsAfterPageJobAsync()
    {
        try
        {
            var outcome = await BranchOperations.GetBranchesAsync(WorkspaceId, ViewingContextId!.Value, RepositoryId);
            if (outcome.IsSuccessStatus)
            {
                ApplyBranchLists(outcome.Body);
                selectedBranch = !string.IsNullOrWhiteSpace(currentTag) && activeTab == "tags" ? currentTag : currentBranchLocal;
                showReturnToDefaultButton = remoteBranches.Count > 0 && ShouldShowReturnToDefaultButton();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not reload branches after fetch");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            try
            {
                await modalElement.FocusAsync();
            }
            catch
            {
                // Focus may fail if element is not yet rendered, ignore
            }
        }
        else if (!IsVisible)
        {
            _wasVisible = false;
        }
        // Focus new branch input when opening New Branch tab
        if (IsVisible && activeTab == "newbranch")
        {
            try
            {
                await newBranchNameInput.FocusAsync();
            }
            catch { }
        }
        // Focus filter input when switching to Locals or Remotes tab
        if (IsVisible && _focusFilterOnNextRender && (activeTab == "local" || activeTab == "remote"))
        {
            _focusFilterOnNextRender = false;
            try
            {
                await branchFilterInput.FocusAsync();
            }
            catch { }
        }
        // Scroll delete confirmation into view when shown (e.g. when user deletes the last branch in the list)
        if (IsVisible && _scrollToDeleteConfirm && branchToDelete != null)
        {
            _scrollToDeleteConfirm = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollElementIntoView", deleteConfirmElementRef);
            }
            catch { }
        }
        // Scroll external worktree cleanup confirmation into view when shown - same rationale as branch delete above.
        if (IsVisible && _scrollToWorktreeCleanupConfirm && worktreeCleanupBranch != null)
        {
            _scrollToWorktreeCleanupConfirm = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollElementIntoView", worktreeCleanupConfirmElementRef);
            }
            catch { }
        }
        // Scroll current tag into view when Tags tab opens so it is visible even if many newer tags are above it
        if (IsVisible && _scrollToCurrentTag && activeTab == "tags" && !string.IsNullOrWhiteSpace(currentTag))
        {
            _scrollToCurrentTag = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollElementIntoViewById", "switch-branch-current-tag");
            }
            catch { }
        }
    }

    private async Task LoadBranchesAsync()
    {
        isLoading = true;
        errorMessage = null;
        showReturnToDefaultButton = false;
        StateHasChanged();

        try
        {
            var outcome = await BranchOperations.GetBranchesAsync(WorkspaceId, ViewingContextId!.Value, RepositoryId);
            if (outcome.IsSuccessStatus)
            {
                ApplyBranchLists(outcome.Body);
                await LoadOccupancyAsync();

                // Default the selection: tag tab pre-selects the current tag, otherwise pre-select the current branch.
                if (!string.IsNullOrWhiteSpace(currentTag))
                {
                    activeTab = "tags";
                    selectedBranch = currentTag;
                    _scrollToCurrentTag = true;
                }
                else
                {
                    selectedBranch = currentBranchLocal;
                }

                // Show sync only when remotes are known, we are on a real non-default branch, and it is missing on remote.
                showReturnToDefaultButton = remoteBranches.Count > 0 && ShouldShowReturnToDefaultButton();

                // If no branches/tags were persisted, automatically fetch them (keep loading state)
                if (localBranches.Count == 0 && remoteBranches.Count == 0 && tags.Count == 0)
                {
                    StateHasChanged();
                    await RefreshBranchesAsync();
                    return;
                }
            }
            else
            {
                errorMessage = $"Failed to load branches: {outcome.StatusCode}";
                Logger.LogError("Failed to load branches: {StatusCode}, {Error}", outcome.StatusCode, outcome.ErrorText);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while loading branches.";
            Logger.LogError(ex, "Error loading branches");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>Reload branch lists from persistence without running fetch. Used after delete so UI reflects updated persistence.</summary>
    private async Task ReloadBranchesFromPersistenceAsync()
    {
        try
        {
            var outcome = await BranchOperations.GetBranchesAsync(WorkspaceId, ViewingContextId!.Value, RepositoryId);
            if (outcome.IsSuccessStatus)
            {
                ApplyBranchLists(outcome.Body);
                selectedBranch = !string.IsNullOrWhiteSpace(currentTag) && activeTab == "tags" ? currentTag : currentBranchLocal;
                showReturnToDefaultButton = remoteBranches.Count > 0 && ShouldShowReturnToDefaultButton();
                await OnBranchChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reloading branches from persistence");
        }
        StateHasChanged();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "local" || tab == "remote" || tab == "tags")
            _focusFilterOnNextRender = true;
        // Reset selection so the radio matches the new tab's current item.
        if (tab == "tags")
        {
            selectedBranch = currentTag;
            if (!string.IsNullOrWhiteSpace(currentTag))
                _scrollToCurrentTag = true;
        }
        else if (tab == "local")
            selectedBranch = currentBranchLocal;
        else if (tab == "remote")
            selectedBranch = null;
        StateHasChanged();
    }

    /// <summary>True when Locals filter matched no branches so the footer can offer Create instead of Check out.</summary>
    private bool CanCreateFromFilter() =>
        activeTab == "local"
        && localBranches.Count > 0
        && !string.IsNullOrWhiteSpace(branchFilter)
        && GetFilteredLocalBranches().Count() == 0;

    /// <summary>Copy filter text to New branch name and switch to New Branch tab (when Locals filter matched no branches).</summary>
    private void CreateFromFilter()
    {
        newBranchName = branchFilter?.Trim() ?? "";
        activeTab = "newbranch";
        StateHasChanged();
    }

    private void SelectBranch(string branch)
    {
        selectedBranch = branch;
        StateHasChanged();
    }

    // New-branch helpers (single-repo create)
    private void ToggleBasedOnDropdown()
    {
        showBasedOnDropdown = !showBasedOnDropdown;
    }

    private void SelectBaseBranch(string value)
    {
        selectedBaseBranch = value;
        showBasedOnDropdown = false;
    }

    private string GetBranchCountText(int count, bool isFiltered = false)
    {
        if (isFiltered)
            return count == 1 ? "1 branch matched" : $"{count} branches matched";
        return count == 1 ? "1 branch" : $"{count} branches";
    }

    private IEnumerable<string> GetFilteredLocalBranches()
    {
        IEnumerable<string> filtered;
        if (string.IsNullOrWhiteSpace(branchFilter))
            filtered = localBranches;
        else
        {
            var term = branchFilter.Trim();
            filtered = localBranches.Where(b => b.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        var list = filtered.ToList();
        if (string.IsNullOrWhiteSpace(currentBranchLocal))
            return list;
        var current = list.FirstOrDefault(b => string.Equals(b, currentBranchLocal, StringComparison.OrdinalIgnoreCase));
        if (current == null)
            return list;
        return list.Where(b => !string.Equals(b, current, StringComparison.OrdinalIgnoreCase)).Prepend(current);
    }

    private IEnumerable<string> GetFilteredRemoteBranches()
    {
        if (string.IsNullOrWhiteSpace(branchFilter))
            return remoteBranches;
        var term = branchFilter.Trim();
        return remoteBranches.Where(b => b.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<string> GetFilteredTags()
    {
        if (string.IsNullOrWhiteSpace(branchFilter))
            return tags;
        var term = branchFilter.Trim();
        return tags.Where(t => t.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private string GetFilterCountText()
    {
        var filtered = activeTab switch
        {
            "tags" => GetFilteredTags().Count(),
            "remote" => GetFilteredRemoteBranches().Count(),
            _ => GetFilteredLocalBranches().Count(),
        };
        var noun = activeTab == "tags" ? "tag" : "branch";
        var nounPlural = activeTab == "tags" ? "tags" : "branches";
        if (!string.IsNullOrWhiteSpace(branchFilter))
            return filtered == 1 ? $"1 {noun} matched" : $"{filtered} {nounPlural} matched";
        return filtered == 1 ? $"1 {noun}" : $"{filtered} {nounPlural}";
    }

    private bool IsCheckoutDisabled()
    {
        if (isRefreshing || string.IsNullOrWhiteSpace(selectedBranch))
            return true;
        if (activeTab == "tags")
            return selectedBranch == currentTag;
        if (TryGetOccupancy(selectedBranch, out var occ)
            && (occ.RequiresFeatureCleanup || occ.RequiresExternalCleanup || !occ.AllowCheckout))
            return true;
        return selectedBranch == currentBranchLocal;
    }

    private async Task LoadOccupancyAsync()
    {
        _occupancy = new Dictionary<string, BranchOccupancyBadge>(StringComparer.OrdinalIgnoreCase);
        if (WorkspaceRepositoryId <= 0 || ViewingContextId is null)
            return;
        try
        {
            _occupancy = await OccupancyService.GetBadgesForRepositoryAsync(
                WorkspaceId, WorkspaceRepositoryId, ViewingContextId.Value);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Worktree occupancy load failed for repo {RepositoryId}", RepositoryId);
        }
    }

    private bool TryGetOccupancy(string branch, out BranchOccupancyBadge badge)
    {
        if (_occupancy.TryGetValue(branch, out badge!))
            return true;
        badge = null!;
        return false;
    }

    /// <summary>True if the current branch exists on remote (exact match or origin/currentBranch).</summary>
    private bool IsCurrentBranchOnRemote()
    {
        if (string.IsNullOrWhiteSpace(currentBranchLocal) || remoteBranches.Count == 0)
            return false;
        if (remoteBranches.Any(r => string.Equals(r, currentBranchLocal, StringComparison.OrdinalIgnoreCase)))
            return true;
        var originRef = "origin/" + currentBranchLocal;
        return remoteBranches.Any(r => string.Equals(r, originRef, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>True when current is a real branch that is not the default and has no remote-tracking counterpart.</summary>
    /// <summary>True when current is a real branch that is not the default and has no remote-tracking counterpart.</summary>
    private bool ShouldShowReturnToDefaultButton()
    {
        if (IsFeatureContext)
            return false;
        if (!string.IsNullOrWhiteSpace(currentTag) || string.IsNullOrWhiteSpace(currentBranchLocal))
            return false;
        if (!string.IsNullOrWhiteSpace(defaultBranch)
            && string.Equals(currentBranchLocal, defaultBranch, StringComparison.OrdinalIgnoreCase))
            return false;
        return !IsCurrentBranchOnRemote();
    }

    /// <summary>Local branches for "Based on" dropdown (current branch first).</summary>
    private IEnumerable<string> GetLocalBranchesForBasedOn()
    {
        if (localBranches.Count == 0)
            return Enumerable.Empty<string>();
        if (string.IsNullOrWhiteSpace(currentBranchLocal))
            return localBranches;
        var current = localBranches.FirstOrDefault(b => string.Equals(b, currentBranchLocal, StringComparison.OrdinalIgnoreCase));
        if (current == null)
            return localBranches;
        return localBranches.Where(b => !string.Equals(b, current, StringComparison.OrdinalIgnoreCase)).Prepend(current);
    }

    /// <summary>Remote branches for "Based on" dropdown (exclude default and remotes that duplicate a local branch name).</summary>
    private IEnumerable<string> GetRemoteBranchesForBasedOn()
    {
        var localSet = new HashSet<string>(localBranches, StringComparer.OrdinalIgnoreCase);
        foreach (var b in remoteBranches)
        {
            if (string.Equals(b, defaultBranch, StringComparison.OrdinalIgnoreCase))
                continue;
            var shortName = b.StartsWith("origin/", StringComparison.OrdinalIgnoreCase) ? b.Substring("origin/".Length) : b;
            if (localSet.Contains(shortName))
                continue;
            yield return b;
        }
    }

    private int GetBasedOnItemCount() =>
        1 + GetLocalBranchesForBasedOn().Count() + GetRemoteBranchesForBasedOn().Count();

    private void SelectClosestMatchingBranch()
    {
        var filtered = activeTab switch
        {
            "tags" => GetFilteredTags().ToList(),
            "remote" => GetFilteredRemoteBranches().ToList(),
            _ => GetFilteredLocalBranches().ToList(),
        };
        if (filtered.Count == 0)
        {
            selectedBranch = null;
        }
        else if (selectedBranch == null || !filtered.Contains(selectedBranch))
        {
            selectedBranch = filtered[0];
        }
        StateHasChanged();
    }

    private static string GetRemoteBranchDisplayName(string? branch)
    {
        if (string.IsNullOrWhiteSpace(branch))
            return branch ?? "";
        return branch.StartsWith("origin/", StringComparison.OrdinalIgnoreCase) ? branch : "origin/" + branch;
    }

    private string GetSelectedBaseDisplayText()
    {
        if (selectedBaseBranch == "__default__")
            return defaultBranch != null ? GetRemoteBranchDisplayName(defaultBranch) : "default";
        if (localBranches.Any(b => string.Equals(b, selectedBaseBranch, StringComparison.OrdinalIgnoreCase)))
            return selectedBaseBranch ?? "";
        return GetRemoteBranchDisplayName(selectedBaseBranch);
    }

    private async Task CreateAsync()
    {
        var name = newBranchName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "Enter a branch name.";
            return;
        }
        var baseBranch = selectedBaseBranch ?? "__default__";

        showBranchExistsConfirmation = false;
        errorMessage = null;
        StateHasChanged();

        // If branch exists locally/remotely, show confirm
        if (localBranches.Any(b => string.Equals(b, name, StringComparison.OrdinalIgnoreCase)) ||
            remoteBranches.Any(b => string.Equals(b, name, StringComparison.OrdinalIgnoreCase)))
        {
            branchExistsConfirmMessage = $"The branch already exists in this repository.";
            _pendingCreateName = name;
            _pendingCreateBaseBranch = baseBranch;
            _pendingCreateSetUpstream = createWithUpstream;
            showBranchExistsConfirmation = true;
            StateHasChanged();
            return;
        }

        // Close dialog and let parent show full-page overlay and run create
        await OnCreateBranch.InvokeAsync((RepositoryId, RepositoryName, name, baseBranch, createWithUpstream));
        await OnCancel.InvokeAsync();
    }

    private void DismissBranchExistsConfirmation()
    {
        showBranchExistsConfirmation = false;
        branchExistsConfirmMessage = "";
        _pendingCreateName = null;
        _pendingCreateBaseBranch = null;
        _pendingCreateSetUpstream = false;
        StateHasChanged();
    }

    /// <summary>When branch name input changes, revert from "branch exists" state so button goes back to Create.</summary>
    private void OnNewBranchNameChanged()
    {
        if (showBranchExistsConfirmation)
        {
            DismissBranchExistsConfirmation();
        }
    }

    /// <summary>Check out the existing branch (when user chose "Check out" after entering an existing branch name).</summary>
    private async Task CheckoutExistingBranchAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingCreateName))
            return;

        var branchToCheckout = _pendingCreateName;
        DismissBranchExistsConfirmation();
        await OnCancel.InvokeAsync();
        await OnCheckoutBranch.InvokeAsync((RepositoryId, branchToCheckout, false));
    }

    private async Task RequestFeatureCleanup(BranchOccupancyBadge occupancy)
    {
        if (occupancy.ContextId is not WorkspaceFeatureContextId contextId)
            return;
        await OnCancel.InvokeAsync();
        await OnRequestFeatureCleanup.InvokeAsync(contextId);
    }

    private void RequestDeleteBranch(string branch, bool isRemote)
    {
        branchToDelete = branch;
        deleteIsRemote = isRemote;
        _awaitingForceDeleteConfirmation = false;
        deleteConfirmMessage = isRemote
            ? $"Delete remote branch '{GetRemoteBranchDisplayName(branch)}'?"
            : $"Delete branch '{branch}'?";
        errorMessage = null;
        _scrollToDeleteConfirm = true;
        StateHasChanged();
    }

    private void DismissDeleteConfirmation()
    {
        branchToDelete = null;
        deleteConfirmMessage = "";
        _awaitingForceDeleteConfirmation = false;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the inline cleanup confirm for a branch checked out in an external (non-Feature) git worktree
    /// (§28B) and kicks off the analyze call. Counterpart to <see cref="RequestDeleteBranch"/> for the
    /// "Worktree" occupancy badge - routes to <see cref="IWorkspaceExternalWorktreeOperations"/> instead of an
    /// ordinary branch delete, which git worktree rules would reject anyway.
    /// </summary>
    private async Task RequestExternalWorktreeCleanupAsync(string branch, BranchOccupancyBadge occupancy)
    {
        worktreeCleanupBranch = branch;
        _worktreeCleanupPlan = null;
        _awaitingForceWorktreeCleanupConfirmation = false;
        errorMessage = null;
        _scrollToWorktreeCleanupConfirm = true;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(occupancy.WorktreePath))
        {
            _worktreeCleanupPlan = new GrayMoon.Application.Features.ExternalWorktreeCleanupPlan
            {
                Success = false,
                Error = "Worktree path is unknown."
            };
            StateHasChanged();
            return;
        }

        try
        {
            _worktreeCleanupPlan = await ExternalWorktreeOperations.AnalyzeExternalWorktreeCleanupAsync(
                WorkspaceId, WorkspaceRepositoryId, occupancy.WorktreePath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AnalyzeExternalWorktreeCleanup failed for {WorktreePath}", occupancy.WorktreePath);
            _worktreeCleanupPlan = new GrayMoon.Application.Features.ExternalWorktreeCleanupPlan
            {
                Success = false,
                Error = "Could not inspect the external worktree."
            };
        }
        StateHasChanged();
    }

    private void DismissExternalWorktreeCleanup()
    {
        worktreeCleanupBranch = null;
        _worktreeCleanupPlan = null;
        _awaitingForceWorktreeCleanupConfirmation = false;
        StateHasChanged();
    }

    private async Task ProceedWithExternalWorktreeCleanupAsync()
    {
        if (_worktreeCleanupPlan is not { Success: true } plan)
            return;

        isCleaningUpWorktree = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await ExternalWorktreeOperations.RemoveExternalWorktreeAsync(
                WorkspaceId,
                WorkspaceRepositoryId,
                plan.WorktreePath,
                new GrayMoon.Application.Features.ExternalWorktreeCleanupOptions
                {
                    AllowForceRemoveDirty = _awaitingForceWorktreeCleanupConfirmation
                });

            if (result.Success)
            {
                DismissExternalWorktreeCleanup();
                await ReloadBranchesFromPersistenceAsync();
            }
            else
            {
                errorMessage = result.Error ?? "Failed to remove the external worktree.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while removing the external worktree.";
            Logger.LogError(ex, "Error removing external worktree");
        }
        finally
        {
            isCleaningUpWorktree = false;
            StateHasChanged();
        }
    }

    /// <summary>Git exit when branch -d fails on unmerged branch; stable phrase from git's error output.</summary>
    private static bool IsGitBranchNotFullyMergedError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
            return false;
        // Git prints: error: the branch 'name' is not fully merged
        return error.Contains("not fully merged", StringComparison.OrdinalIgnoreCase);
    }

    private Task ProceedWithDeleteAsync() => DeleteBranchAsync(force: false);

    private Task ProceedWithForceDeleteAsync() => DeleteBranchAsync(force: true);

    private async Task DeleteBranchAsync(bool force)
    {
        if (string.IsNullOrWhiteSpace(branchToDelete))
            return;

        isDeleting = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var outcome = await BranchOperations.DeleteBranchAsync(WorkspaceId, ViewingContextId!.Value, RepositoryId, branchToDelete, deleteIsRemote, force);
            if (outcome.IsSuccessStatus)
            {
                var data = outcome.Body as DeleteBranchApiResult;
                if (data != null && data.Success)
                {
                    DismissDeleteConfirmation();
                    await ReloadBranchesFromPersistenceAsync();
                }
                else
                {
                    var err = data?.Error ?? "Failed to delete branch.";
                    // Intercept only git "not fully merged" after branch -d; offer force delete step (local only).
                    if (!deleteIsRemote && !force && IsGitBranchNotFullyMergedError(err))
                    {
                        _awaitingForceDeleteConfirmation = true;
                        _scrollToDeleteConfirm = true;
                    }
                    else
                    {
                        errorMessage = err;
                    }
                }
            }
            else
            {
                errorMessage = outcome.ErrorText ?? $"Delete failed: {outcome.StatusCode}";
                Logger.LogError("Delete branch failed: {StatusCode}, {Error}", outcome.StatusCode, outcome.ErrorText);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while deleting the branch.";
            Logger.LogError(ex, "Error deleting branch");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task ProceedWithCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingCreateName) || string.IsNullOrWhiteSpace(_pendingCreateBaseBranch))
            return;

        // Close dialog and let parent show full-page overlay and run create
        await OnCreateBranch.InvokeAsync((RepositoryId, RepositoryName, _pendingCreateName, _pendingCreateBaseBranch, _pendingCreateSetUpstream));
        await OnCancel.InvokeAsync();
    }
    private async Task CheckoutAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedBranch))
            return;

        var isTag = activeTab == "tags";

        // Close modal immediately and trigger checkout from parent
        await OnCancel.InvokeAsync();
        await OnCheckoutBranch.InvokeAsync((RepositoryId, selectedBranch, isTag));
    }

    private async Task HandleBranchFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Code == "Escape")
        {
            if (!string.IsNullOrWhiteSpace(branchFilter))
            {
                branchFilter = "";
                SelectClosestMatchingBranch();
                _escapeConsumedByFilter = true;
            }
            return;
        }
        if (e.Key != "Enter" && e.Code != "Enter")
            return;
        if (activeTab == "newbranch" || isRefreshing)
            return;
        // Locals tab: when filter matched no branches, Enter opens New Branch with filter text as name
        if (CanCreateFromFilter())
        {
            _suppressNextEnterForNewBranch = true;
            CreateFromFilter();
            return;
        }
        if (IsCheckoutDisabled())
            return;
        await CheckoutAsync();
    }

    private async Task ReturnToDefaultAsync()
    {
        if (string.IsNullOrWhiteSpace(currentBranchLocal) || string.IsNullOrWhiteSpace(defaultBranch))
            return;

        // Close dialog and let parent show full-page overlay and run sync
        await OnReturnToDefault.InvokeAsync((RepositoryId, RepositoryName, currentBranchLocal, defaultBranch));
        await OnCancel.InvokeAsync();
    }

    private string GetPullRequestUrl()
    {
        if (string.IsNullOrWhiteSpace(RepositoryUrl) || string.IsNullOrWhiteSpace(defaultBranch))
            return "#";

        // Use current branch or selected branch for comparison
        var compareBranch = selectedBranch ?? currentBranchLocal ?? defaultBranch;
        return GetPullRequestUrlForBranch(compareBranch);
    }

    private string GetPullRequestUrlForBranch(string branchName)
    {
        if (string.IsNullOrWhiteSpace(RepositoryUrl) || string.IsNullOrWhiteSpace(defaultBranch) || string.IsNullOrWhiteSpace(branchName))
            return "#";

        var url = RepositoryUrl.Trim();
        if (url.StartsWith("git@github.com:", StringComparison.OrdinalIgnoreCase))
            url = url.Replace("git@github.com:", "https://github.com/", StringComparison.OrdinalIgnoreCase);
        if (url.EndsWith(".git", StringComparison.OrdinalIgnoreCase))
            url = url.Substring(0, url.Length - 4);

        return $"{url}/compare/{Uri.EscapeDataString(defaultBranch)}...{Uri.EscapeDataString(branchName)}";
    }

    private async Task RefreshBranchesAsync()
    {
        // Allow refresh even if loading (called from LoadBranchesAsync when no branches found)
        if (isRefreshing)
            return;

        // If already loading (from LoadBranchesAsync), keep isLoading true instead of isRefreshing
        var wasLoading = isLoading;
        if (!wasLoading)
        {
            isRefreshing = true;
        }
        errorMessage = null;
        StateHasChanged();

        try
        {
            var outcome = await BranchOperations.RefreshBranchesAsync(WorkspaceId, ViewingContextId!.Value, RepositoryId);
            if (outcome.IsSuccessStatus)
            {
                ApplyBranchLists(outcome.Body);

                // Pre-select the current item on the active tab.
                if (activeTab == "tags")
                    selectedBranch = currentTag;
                else
                    selectedBranch = currentBranchLocal;

                showReturnToDefaultButton = ShouldShowReturnToDefaultButton();

                // Refresh workspace data
                await OnBranchChanged.InvokeAsync();
            }
            else
            {
                errorMessage = outcome.ErrorText ?? $"Failed to refresh branches: {outcome.StatusCode}";
                Logger.LogError("Failed to refresh branches: {StatusCode}, {Error}", outcome.StatusCode, outcome.ErrorText);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while refreshing branches.";
            Logger.LogError(ex, "Error refreshing branches");
        }
        finally
        {
            if (wasLoading)
            {
                isLoading = false;
            }
            else
            {
                isRefreshing = false;
            }
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Code == "Escape")
        {
            if (_escapeConsumedByFilter)
            {
                _escapeConsumedByFilter = false;
                return;
            }
            await OnCancel.InvokeAsync();
            return;
        }
        if (ModalKeyboard.IsPlainEnter(e) && activeTab == "newbranch" && !isCreating)
        {
            if (_suppressNextEnterForNewBranch)
            {
                _suppressNextEnterForNewBranch = false;
                return;
            }
            if (showBranchExistsConfirmation)
                await CheckoutExistingBranchAsync();
            else if (!string.IsNullOrWhiteSpace(newBranchName?.Trim()))
                await CreateAsync();
        }
    }

    private async Task HandleBranchNameKeyDown(KeyboardEventArgs e)
    {
        if (ModalKeyboard.IsPlainEnter(e) && !isCreating)
        {
            if (_suppressNextEnterForNewBranch)
            {
                _suppressNextEnterForNewBranch = false;
                return;
            }
            if (showBranchExistsConfirmation)
                await CheckoutExistingBranchAsync();
            else if (!string.IsNullOrWhiteSpace(newBranchName?.Trim()))
                await CreateAsync();
        }
    }

    private void ApplyBranchLists(object? body)
    {
        IReadOnlyList<string>? local = null;
        IReadOnlyList<string>? remote = null;
        IReadOnlyList<string>? tagList = null;
        string? current = null;
        string? tag = null;
        string? def = null;

        if (body is WorkspaceBranchesSnapshot snapshot)
        {
            local = snapshot.LocalBranches;
            remote = snapshot.RemoteBranches;
            tagList = snapshot.Tags;
            current = snapshot.CurrentBranch;
            tag = snapshot.CurrentTag;
            def = snapshot.DefaultBranch;
        }
        else
        {
            var data = body as BranchesResponse ?? AgentResponseJson.DeserializeAgentResponse<BranchesResponse>(body);
            if (data != null)
            {
                local = data.LocalBranches;
                remote = data.RemoteBranches;
                tagList = data.Tags;
                current = data.CurrentBranch;
                tag = data.CurrentTag;
                def = data.DefaultBranch;
            }
        }

        localBranches = local?.Where(b => !IsSyntheticGitRefName(b)).ToList() ?? new List<string>();
        remoteBranches = remote?.Where(b => !IsSyntheticGitRefName(b)).ToList() ?? new List<string>();
        tags = tagList?.Where(t => !string.IsNullOrWhiteSpace(t)).ToList() ?? new List<string>();
        currentBranchLocal = current;
        currentTag = tag;
        defaultBranch = def;
    }

}
