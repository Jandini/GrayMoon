@using GrayMoon.App.Models
@using GrayMoon.App.Models.Api
@using GrayMoon.App.Services
@using GrayMoon.App.Services.Features
@using GrayMoon.Application.Features
@inject IWorkspaceBranchOperations BranchOperations
@inject IWorkspaceBranchOccupancyService OccupancyService
@inject GrayMoon.Application.Features.IWorkspaceExternalWorktreeOperations ExternalWorktreeOperations
@inject IJSRuntime JSRuntime
@inject ILogger<SwitchBranchModal> Logger

@if (IsVisible)
{
    @*
        z-index drops below the page's BackgroundJobOverlay (.loading-overlay--page, z-index: 100) while
        a page job is running so the overlay covers this still-mounted dialog.
    *@
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: @(IsBusy ? 50 : 1055);"
         @onkeydown="HandleKeyDown"
         @ref="modalElement">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Branch - @RepositoryName</h5>
                    <button type="button" class="btn-close" @onclick="OnCancel" disabled="@isRefreshing"></button>
                </div>
                <div class="modal-body">
                    @if (errorMessage != null)
                    {
                        <div class="gm-callout gm-callout--error" role="alert">@errorMessage</div>
                    }
                    else
                    {
                        <div class="mb-3 switch-branch-tabs-wrapper">
                            <div class="d-flex align-items-center justify-content-between">
                                <ul class="nav nav-tabs switch-branch-tabs mb-0 flex-grow-1" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "local" ? "active" : "")" 
                                                type="button" 
                                                role="tab"
                                                disabled="@isRefreshing"
                                                @onclick='() => SetActiveTab("local")'>
                                            Locals
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "remote" ? "active" : "")" 
                                                type="button" 
                                                role="tab"
                                                disabled="@isRefreshing"
                                                @onclick='() => SetActiveTab("remote")'>
                                            Remotes
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "tags" ? "active" : "")"
                                                type="button"
                                                role="tab"
                                                disabled="@isRefreshing"
                                                @onclick='() => SetActiveTab("tags")'>
                                            Tags
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "newbranch" ? "active" : "")"
                                                type="button"
                                                role="tab"
                                                disabled="@isRefreshing"
                                                @onclick='() => SetActiveTab("newbranch")'>
                                            New Branch
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        @if (activeTab != "newbranch")
                        {
                            <div class="mb-3 switch-branch-field-block">
                                <div class="d-flex align-items-center justify-content-between switch-branch-label-row">
                                    <label class="form-label mb-0" for="branch-filter">@(activeTab == "tags" ? "Tag name" : "Branch name")</label>
                                    <span class="switch-branch-tab-count">@GetFilterCountText()</span>
                                </div>
                                <input id="branch-filter"
                                       type="text"
                                       class="form-control"
                                       placeholder="@(activeTab == "tags" ? "search tag..." : "search branch...")"
                                       @bind="branchFilter"
                                       @bind:event="oninput"
                                       @bind:after="SelectClosestMatchingBranch"
                                       @onkeydown="HandleBranchFilterKeyDown"
                                       @ref="branchFilterInput" />
                            </div>
                            <div class="branch-list border rounded">
                                @if (activeTab == "tags")
                                {
                                    @if (GetFilteredTags().Count() == 0)
                                    {
                                        <div class="text-muted p-3">@(tags.Count == 0 ? "No tags found." : "No tags match the filter.")</div>
                                    }
                                    else
                                    {
                                        @foreach (var tag in GetFilteredTags())
                                        {
                                            <div class="branch-item p-2 @(selectedBranch == tag ? "bg-light" : "")"
                                                 id="@(tag == currentTag ? "switch-branch-current-tag" : null)"
                                                 style="cursor: pointer;"
                                                 @onclick='() => SelectBranch(tag)'>
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 min-w-0">
                                                        <input type="radio"
                                                               name="branchSelection"
                                                               class="switch-branch-radio"
                                                               checked="@(selectedBranch == tag)"
                                                               @onchange='() => SelectBranch(tag)' />
                                                        <span class="ms-2 @(tag == currentTag ? "fw-bold" : "")">
                                                            <i class="bi bi-tag me-1" aria-hidden="true"></i>@tag
                                                            @if (tag == currentTag)
                                                            {
                                                                <span class="badge bg-primary ms-2">Current</span>
                                                            }
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else if (activeTab == "local")
                                {
                                    @if (GetFilteredLocalBranches().Count() == 0)
                                    {
                                        <div class="text-muted p-3">@(localBranches.Count == 0 ? "No local branches found." : "No branches match the filter.")</div>
                                    }
                                    else
                                    {
                                        @foreach (var branch in GetFilteredLocalBranches())
                                        {
                                            <div class="branch-item p-2 @(selectedBranch == branch ? "bg-light" : "")" 
                                                 style="cursor: pointer;"
                                                 @onclick='() => SelectBranch(branch)'>
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 min-w-0">
                                                        <input type="radio" 
                                                               name="branchSelection" 
                                                               class="switch-branch-radio"
                                                               checked="@(selectedBranch == branch)"
                                                               @onchange='() => SelectBranch(branch)' />
                                                        <span class="ms-2 @(branch == currentBranchLocal ? "fw-bold" : "")">
                                                            @branch
                                                            @if (branch == currentBranchLocal)
                                                            {
                                                                <span class="badge bg-primary ms-2">Current</span>
                                                                @if (showReturnToDefaultButton && string.IsNullOrWhiteSpace(currentTag))
                                                                {
                                                                    <span class="badge ms-2" style="background-color: #ffc107; color: #000;">Local Only</span>
                                                                }
                                                            }
                                                            else if (TryGetOccupancy(branch, out var occ))
                                                            {
                                                                @if (occ.Kind == BranchOccupancyKind.Feature)
                                                                {
                                                                    <span class="badge bg-info ms-2" title="@occ.FeatureName">Feature</span>
                                                                }
                                                                else if (occ.Kind == BranchOccupancyKind.Worktree)
                                                                {
                                                                    <span class="badge bg-secondary ms-2" title="@occ.WorktreePath">Worktree</span>
                                                                }
                                                                else if (occ.Kind == BranchOccupancyKind.Workspace)
                                                                {
                                                                    <span class="badge bg-secondary ms-2" title="Checked out in Workspace">Workspace</span>
                                                                }
                                                            }
                                                        </span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        @if (!string.IsNullOrWhiteSpace(RepositoryUrl) && !string.IsNullOrWhiteSpace(defaultBranch))
                                                        {
                                                            <a href="@GetPullRequestUrlForBranch(branch)" 
                                                               class="branch-pr-link" 
                                                               target="_blank" 
                                                               rel="noopener noreferrer" 
                                                               title="Open Pull Request (default...@branch)"
                                                               aria-label="Open Pull Request"
                                                               @onclick="(e) => { }"
                                                               @onclick:stopPropagation="true">
                                                                <i class="bi bi-git" aria-hidden="true"></i>
                                                            </a>
                                                        }
                                                        @if (branch != currentBranchLocal && TryGetOccupancy(branch, out var occForDelete) && occForDelete.RequiresFeatureCleanup)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-link p-0 branch-delete-link"
                                                                    title="@($"Owned by Feature '{occForDelete.FeatureName}' - use Remove Feature to delete this branch")"
                                                                    aria-label="Remove owning Feature to delete this branch"
                                                                    @onclick="(e) => RequestFeatureCleanup(occForDelete)"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                        else if (branch != currentBranchLocal && TryGetOccupancy(branch, out var occForExternalCleanup) && occForExternalCleanup.RequiresExternalCleanup)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-link p-0 branch-delete-link"
                                                                    title="@($"Checked out in an external worktree at {occForExternalCleanup.WorktreePath} - remove that worktree to delete this branch")"
                                                                    aria-label="Remove external worktree to delete this branch"
                                                                    @onclick="(e) => RequestExternalWorktreeCleanupAsync(branch, occForExternalCleanup)"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="bi bi-folder-x" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                        else if (branch != currentBranchLocal)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-link p-0 branch-delete-link"
                                                                    title="Delete branch"
                                                                    aria-label="Delete branch"
                                                                    @onclick="(e) => { RequestDeleteBranch(branch, false); }"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            @if (branchToDelete == branch && !deleteIsRemote)
                                            {
                                                <div class="branch-delete-confirm d-flex flex-column gap-2 px-2 py-2" @ref="deleteConfirmElementRef">
                                                    @if (_awaitingForceDeleteConfirmation)
                                                    {
                                                        <div class="small">
                                                            <span class="text-danger">Branch appears not fully merged to 'HEAD'. Deleting this branch may result in lost commits.</span>
                                                            <div class="text-muted mt-1" style="font-size: 0.8rem;">You can safely proceed if your branch was squash merged.</div>
                                                        </div>
                                                        <div class="d-flex gap-2 flex-shrink-0 align-self-end">
                                                            <button type="button" class="btn btn-danger btn-sm" @onclick="ProceedWithForceDeleteAsync" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">
                                                                @if (isDeleting)
                                                                {
                                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                                }
                                                                Delete
                                                            </button>
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissDeleteConfirmation" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">Abort</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span class="text-danger small">@deleteConfirmMessage</span>
                                                            <div class="d-flex gap-2 flex-shrink-0">
                                                                <button type="button" class="btn btn-danger btn-sm" @onclick="ProceedWithDeleteAsync" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">
                                                                    @if (isDeleting)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                                    }
                                                                    Delete
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissDeleteConfirmation" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">Cancel</button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            @if (worktreeCleanupBranch == branch)
                                            {
                                                <div class="branch-delete-confirm d-flex flex-column gap-2 px-2 py-2" @ref="worktreeCleanupConfirmElementRef">
                                                    @if (_worktreeCleanupPlan == null)
                                                    {
                                                        <div class="small text-muted">
                                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                                            Checking external worktree...
                                                        </div>
                                                    }
                                                    else if (!_worktreeCleanupPlan.Success)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span class="text-danger small">@_worktreeCleanupPlan.Error</span>
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissExternalWorktreeCleanup" @onclick:stopPropagation="true">Close</button>
                                                        </div>
                                                    }
                                                    else if (_worktreeCleanupPlan.IsDirty && !_awaitingForceWorktreeCleanupConfirmation)
                                                    {
                                                        <div class="small">
                                                            <span class="text-danger">@_worktreeCleanupPlan.Summary has uncommitted changes.</span>
                                                            <div class="text-muted mt-1" style="font-size: 0.8rem;">Removing it will discard those changes.</div>
                                                        </div>
                                                        <div class="d-flex gap-2 flex-shrink-0 align-self-end">
                                                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => { _awaitingForceWorktreeCleanupConfirmation = true; }" disabled="@(isCleaningUpWorktree || isRefreshing)" @onclick:stopPropagation="true">Remove Anyway</button>
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissExternalWorktreeCleanup" disabled="@(isCleaningUpWorktree || isRefreshing)" @onclick:stopPropagation="true">Cancel</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span class="text-danger small">Remove external worktree at @_worktreeCleanupPlan.WorktreePath?</span>
                                                            <div class="d-flex gap-2 flex-shrink-0">
                                                                <button type="button" class="btn btn-danger btn-sm" @onclick="ProceedWithExternalWorktreeCleanupAsync" disabled="@(isCleaningUpWorktree || isRefreshing)" @onclick:stopPropagation="true">
                                                                    @if (isCleaningUpWorktree)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                                    }
                                                                    Remove
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissExternalWorktreeCleanup" disabled="@(isCleaningUpWorktree || isRefreshing)" @onclick:stopPropagation="true">Cancel</button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    @if (GetFilteredRemoteBranches().Count() == 0)
                                    {
                                        <div class="text-muted p-3">@(remoteBranches.Count == 0 ? "No remote branches found." : "No branches match the filter.")</div>
                                    }
                                    else
                                    {
                                        @foreach (var branch in GetFilteredRemoteBranches())
                                        {
                                            <div class="branch-item p-2 @(selectedBranch == branch ? "bg-light" : "")" 
                                                 style="cursor: pointer;"
                                                 @onclick='() => SelectBranch(branch)'>
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 min-w-0">
                                                        <input type="radio" 
                                                               name="branchSelection" 
                                                               class="switch-branch-radio"
                                                               checked="@(selectedBranch == branch)"
                                                               @onchange='() => SelectBranch(branch)' />
                                                        <span class="ms-2">
                                                            @GetRemoteBranchDisplayName(branch)
                                                            @if (branch == defaultBranch)
                                                            {
                                                                <span class="badge bg-success ms-2">Default</span>
                                                            }
                                                        </span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        @if (!string.IsNullOrWhiteSpace(RepositoryUrl) && !string.IsNullOrWhiteSpace(defaultBranch))
                                                        {
                                                            <a href="@GetPullRequestUrlForBranch(branch)" 
                                                               class="branch-pr-link" 
                                                               target="_blank" 
                                                               rel="noopener noreferrer" 
                                                               title="Open Pull Request (default...@branch)"
                                                               aria-label="Open Pull Request"
                                                               @onclick="(e) => { }"
                                                               @onclick:stopPropagation="true">
                                                                <i class="bi bi-git" aria-hidden="true"></i>
                                                            </a>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-link p-0 branch-delete-link"
                                                                title="Delete remote branch"
                                                                aria-label="Delete remote branch"
                                                                @onclick="(e) => { RequestDeleteBranch(branch, true); }"
                                                                @onclick:stopPropagation="true">
                                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            @if (branchToDelete == branch && deleteIsRemote)
                                            {
                                                <div class="branch-delete-confirm d-flex align-items-center justify-content-between px-2 py-2" @ref="deleteConfirmElementRef">
                                                    <span class="text-danger small">@deleteConfirmMessage</span>
                                                    <div class="d-flex gap-2 flex-shrink-0">
                                                        <button type="button" class="btn btn-danger btn-sm" @onclick="ProceedWithDeleteAsync" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">
                                                            @if (isDeleting)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                            }
                                                            Delete
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DismissDeleteConfirmation" disabled="@(isDeleting || isRefreshing)" @onclick:stopPropagation="true">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            @* New Branch tab UI (single-repo creation) *@
                            @if (errorMessage != null)
                            {
                                <div class="gm-callout gm-callout--error" role="alert">@errorMessage</div>
                            }
                            <div class="mb-3 switch-branch-field-block">
                                <label class="form-label" for="new-branch-name">Branch name</label>
                                <input id="new-branch-name"
                                       type="text"
                                       class="form-control"
                                       placeholder="e.g. feature/my-feature"
                                       @bind="newBranchName"
                                       @bind:event="oninput"
                                       @bind:after="OnNewBranchNameChanged"
                                       @onkeydown="HandleBranchNameKeyDown"
                                       @ref="newBranchNameInput" />
                            </div>
                            <div class="mb-3 switch-branch-field-block">
                                <label class="form-label" for="based-on">Based on</label>
                                <div class="position-relative new-branch-based-on-wrapper">
                                    <button type="button"
                                            id="based-on"
                                            class="new-branch-based-on-trigger border rounded w-100 d-flex align-items-center gap-2 text-start"
                                            style="cursor: pointer; padding: 0.375rem 0.75rem;"
                                            @onclick="ToggleBasedOnDropdown">
                                        <span class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                            <span class="text-truncate">@GetSelectedBaseDisplayText()</span>
                                            @if (selectedBaseBranch == "__default__")
                                            {
                                                <span class="badge bg-success flex-shrink-0">Default</span>
                                            }
                                        </span>
                                        <i class="bi bi-chevron-down flex-shrink-0 text-secondary"></i>
                                    </button>
                                    @if (showBasedOnDropdown)
                                    {
                                        <ul class="list-unstyled border rounded mt-1 mb-0 py-1 new-branch-based-on-list position-absolute start-0 end-0 shadow @(GetBasedOnItemCount() > 3 ? "new-branch-based-on-list--scroll" : null)"
                                            style="z-index: 1050; font-size: 1rem;">
                                            <li class="new-branch-based-on-item px-3 py-2 @(selectedBaseBranch == "__default__" ? "selected" : "")"
                                                style="cursor: pointer;"
                                                @onclick='() => SelectBaseBranch("__default__")'>
                                                <span>@(defaultBranch != null ? GetRemoteBranchDisplayName(defaultBranch) : "default")</span>
                                                <span class="badge bg-success ms-2">Default</span>
                                            </li>
                                            @foreach (var branch in GetLocalBranchesForBasedOn())
                                            {
                                                <li class="new-branch-based-on-item px-3 py-2 @(selectedBaseBranch == branch ? "selected" : "")"
                                                    style="cursor: pointer;"
                                                    @onclick='() => SelectBaseBranch(branch)'>
                                                    @branch
                                                    @if (branch == currentBranchLocal)
                                                    {
                                                        <span class="badge bg-primary ms-2">Current</span>
                                                    }
                                                </li>
                                            }
                                            @foreach (var branch in GetRemoteBranchesForBasedOn())
                                            {
                                                <li class="new-branch-based-on-item px-3 py-2 @(selectedBaseBranch == branch ? "selected" : "")"
                                                    style="cursor: pointer;"
                                                    @onclick='() => SelectBaseBranch(branch)'>
                                                    @GetRemoteBranchDisplayName(branch)
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                            <div class="mb-3 switch-branch-field-block form-check">
                                <input id="create-with-upstream"
                                       type="checkbox"
                                       class="form-check-input switch-branch-checkbox"
                                       @bind="createWithUpstream" />
                                <label class="form-check-label" for="create-with-upstream">Upstream branch</label>
                            </div>
                        }

                    }
                </div>
                <div class="modal-footer d-flex justify-content-between flex-row">
                    <div class="d-flex gap-2 align-items-center">
                        @if (activeTab == "newbranch" && showBranchExistsConfirmation)
                        {
                            <span class="text-warning small">The branch already exists in this repository.</span>
                        }
                        else if (activeTab != "newbranch")
                        {
                            <button type="button" 
                                    class="btn btn-outline-secondary"
                                    @onclick="OnFetchClicked"
                                    disabled="@(isRefreshing || IsBusy)">
                                @if (isRefreshing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>
                                }
                                Fetch
                            </button>
                            @if (showReturnToDefaultButton && !string.IsNullOrWhiteSpace(defaultBranch) && activeTab == "local" && selectedBranch == currentBranchLocal && string.IsNullOrWhiteSpace(currentTag))
                            {
                                <button type="button" 
                                        class="btn btn-warning" 
                                        @onclick="ReturnToDefaultAsync"
                                        disabled="@isRefreshing">
                                    <i class="bi bi-rewind me-1" aria-hidden="true"></i>
                                    Return to @defaultBranch
                                </button>
                            }
                        }
                    </div>
                    <div class="d-flex gap-2 ms-auto">
                        @if (activeTab == "newbranch")
                        {
                            @if (showBranchExistsConfirmation)
                            {
                                <button type="button" class="btn btn-primary" data-default-action @onclick="CheckoutExistingBranchAsync" disabled="@(isCreating || isRefreshing)">
                                    @if (isCreating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Check out
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" data-default-action @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(newBranchName?.Trim()) || isRefreshing)">
                                    Create
                                </button>
                            }
                        }
                        else if (CanCreateFromFilter())
                        {
                            <button type="button"
                                    class="btn btn-primary"
                                    data-default-action
                                    @onclick="CreateFromFilter"
                                    disabled="@isRefreshing">
                                Create
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                                    class="btn btn-primary" 
                                    data-default-action
                                    @onclick="CheckoutAsync"
                                    disabled="@IsCheckoutDisabled()">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Check out
                            </button>
                        }
                        <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@(isCreating || isRefreshing)">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    /// <summary>True while a page job is running. Drops the dialog below the page LoadingOverlay.</summary>
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public int RepositoryId { get; set; }
    [Parameter] public int WorkspaceRepositoryId { get; set; }
