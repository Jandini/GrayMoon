@using GrayMoon.Application.Features
@inject IWorkspaceFeatureContextResolver ContextResolver
@inject IWorkspaceFeatureOperations FeatureOperations
@inject IWorkspaceSelectedFeatureContextService SelectedContextService
@inject IWorkspaceNativeLaunchService NativeLaunch
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="workspace-feature-selector d-flex align-items-center gap-1">
    <label class="form-label mb-0 text-muted small text-nowrap" for="@InputId">Context</label>
    <div class="position-relative flex-grow-1">
        <input id="@InputId"
               class="form-control form-control-sm workspace-feature-selector__input"
               value="@_filter"
               placeholder="Workspace or Feature…"
               disabled="@Disabled"
               autocomplete="off"
               @oninput="OnFilterInput"
               @onfocus="OpenDropdown"
               @onkeydown="OnKeyDown"
               @onclick:stopPropagation />
        @if (_open)
        {
            <div class="workspace-feature-selector__backdrop" @onclick="CloseDropdown"></div>
            <ul class="dropdown-menu show shadow workspace-feature-selector__menu" role="listbox">
                @foreach (var option in FilteredOptions)
                {
                    <li>
                        <button type="button"
                                class="dropdown-item @(option.ContextId.Value == SelectedContextId?.Value ? "active" : "")"
                                role="option"
                                @onclick="() => SelectAsync(option)">
                            @(option.IsSpecialWorkspace ? "Workspace" : option.FeatureName)
                            @if (!option.IsSpecialWorkspace && !string.IsNullOrEmpty(option.LifecycleState) && option.LifecycleState != "Ready")
                            {
                                <span class="text-muted small"> (@option.LifecycleState)</span>
                            }
                        </button>
                    </li>
                }
                @if (CanOfferCreate)
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-menu-item dropdown-item" @onclick="RequestCreate">
                            Create Feature "@_filter.Trim()"…
                        </button>
                    </li>
                }
                @if (_desktopAvailable && SelectedContextId is not null)
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li><button type="button" class="dropdown-item" @onclick='() => LaunchAsync("openInCursor")'>Open in Cursor</button></li>
                    <li><button type="button" class="dropdown-item" @onclick='() => LaunchAsync("openInVsCode")'>Open in VS Code</button></li>
                    <li><button type="button" class="dropdown-item" @onclick='() => LaunchAsync("openInTerminal")'>Open in Terminal</button></li>
                    <li><button type="button" class="dropdown-item" @onclick='() => LaunchAsync("showInExplorer")'>Show in Explorer</button></li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public WorkspaceFeatureContextId? SelectedContextId { get; set; }
    [Parameter] public EventCallback<WorkspaceFeatureContextId> SelectedContextIdChanged { get; set; }
    [Parameter] public EventCallback<string> OnRequestCreateFeature { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string InputId { get; set; } = "workspace-feature-selector";

    private readonly List<WorkspaceFeatureContextInfo> _options = [];
    private string _filter = "";
    private bool _open;
    private bool _loaded;
    private bool _desktopAvailable;

    private IEnumerable<WorkspaceFeatureContextInfo> FilteredOptions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter))
                return _options;
            var q = _filter.Trim();
            return _options.Where(o =>
                o.IsSpecialWorkspace
                    ? "Workspace".Contains(q, StringComparison.OrdinalIgnoreCase)
                    : (o.FeatureName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private bool CanOfferCreate
    {
        get
        {
            var name = _filter.Trim();
            if (string.IsNullOrWhiteSpace(name))
                return false;
            if (_options.Any(o => !o.IsSpecialWorkspace && string.Equals(o.FeatureName, name, StringComparison.OrdinalIgnoreCase)))
                return false;
            return name.IndexOfAny([' ', '~', '^', ':', '?', '*', '[', '\\']) < 0
                   && !name.Contains("..", StringComparison.Ordinal)
                   && !name.StartsWith('/')
                   && !name.EndsWith('/');
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded && WorkspaceId > 0)
        {
            await ReloadAsync();
            _loaded = true;
        }

        SyncFilterLabel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _desktopAvailable)
            return;
        try
        {
            _desktopAvailable = await JS.InvokeAsync<bool>("eval", "!!(window.graymoonDesktop && window.graymoonDesktop.isAvailable && window.graymoonDesktop.isAvailable())");
            if (_desktopAvailable)
                await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _desktopAvailable = false;
        }
    }

    private async Task LaunchAsync(string method)
    {
        if (SelectedContextId is null)
            return;
        var paths = await NativeLaunch.ResolveContextLaunchPathsAsync(SelectedContextId.Value);
        if (paths is null || string.IsNullOrWhiteSpace(paths.ContextRoot))
            return;
        try
        {
            await JS.InvokeAsync<bool>($"graymoonDesktop.{method}", paths.ContextRoot);
        }
        catch
        {
            // Desktop bridge optional.
        }
        CloseDropdown();
    }

    private void SyncFilterLabel()
    {
        if (_open)
            return;
        var selected = _options.FirstOrDefault(o => SelectedContextId is not null && o.ContextId.Value == SelectedContextId.Value.Value);
        _filter = selected is null
            ? ""
            : selected.IsSpecialWorkspace ? "Workspace" : (selected.FeatureName ?? "");
    }

    private async Task ReloadAsync()
    {
        _options.Clear();
        var all = await ContextResolver.ListForWorkspaceAsync(WorkspaceId);
        _options.AddRange(all.Where(c => c.IsSpecialWorkspace || string.Equals(c.LifecycleState, "Ready", StringComparison.OrdinalIgnoreCase)
                                                               || string.Equals(c.LifecycleState, "NeedsRepair", StringComparison.OrdinalIgnoreCase)));
        SyncFilterLabel();
    }

    private void OnFilterInput(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _open = true;
    }

    private void OpenDropdown() => _open = true;
    private void CloseDropdown()
    {
        _open = false;
        SyncFilterLabel();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDropdown();
            return;
        }

        if (e.Key != "Enter")
            return;

        var exact = FilteredOptions.FirstOrDefault(o =>
            o.IsSpecialWorkspace
                ? string.Equals(_filter.Trim(), "Workspace", StringComparison.OrdinalIgnoreCase)
                : string.Equals(o.FeatureName, _filter.Trim(), StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
        {
            await SelectAsync(exact);
            return;
        }

        if (CanOfferCreate)
            await RequestCreate();
    }

    private async Task SelectAsync(WorkspaceFeatureContextInfo option)
    {
        if (!option.IsSpecialWorkspace && !string.Equals(option.LifecycleState, "Ready", StringComparison.OrdinalIgnoreCase))
            return;

        await SelectedContextService.SetSelectedAsync(WorkspaceId, option.ContextId);
        await SelectedContextIdChanged.InvokeAsync(option.ContextId);
        _open = false;
        SyncFilterLabel();

        var uri = new Uri(Navigation.Uri);
        var path = uri.GetLeftPart(UriPartial.Path);
        if (option.IsSpecialWorkspace)
            Navigation.NavigateTo(path, replace: true);
        else
            Navigation.NavigateTo($"{path}?context={option.ContextId.Value}", replace: true);
    }

    private async Task RequestCreate()
    {
        var name = _filter.Trim();
        _open = false;
        await OnRequestCreateFeature.InvokeAsync(name);
    }

    public Task RefreshAsync() => ReloadAsync();
}
