@using GrayMoon.Application
@using GrayMoon.Application.Features
@using GrayMoon.Common.Features
@inject IWorkspaceFeatureOperations FeatureOperations
@inject ILogger<CreateFeatureModal> Logger

@if (IsVisible)
{
    @if (!_busy)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1085;"
             @onkeydown="HandleKeyDown"
             @ref="_modalElement">
            <div class="modal-dialog modal-dialog-centered @(HasBranchCollisions ? "modal-lg" : null)">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">New Feature <small class="text-muted fw-normal">worktree</small></h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                    </div>
                    <div class="modal-body">
                        @if (HasBranchCollisions)
                        {
                            <div class="gm-callout gm-callout--error mb-3" role="alert">
                                <div class="fw-semibold">@BranchExistsSummary</div>
                            </div>
                            <ul class="list-unstyled mb-2 create-feature-collision-list">
                                @foreach (var collision in _branchCollisions!)
                                {
                                    <li class="create-feature-collision-item">
                                        <strong>@collision.RepositoryName</strong>
                                        <span class="text-muted small ms-2">@string.Join(", ", collision.Refs)</span>
                                    </li>
                                }
                            </ul>
                            <p class="text-muted small mb-3">Choose a different Feature name, or delete those branches first.</p>
                        }
                        else if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="gm-callout gm-callout--error mb-3" role="alert">@_error</div>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="create-feature-name">Feature name <small class="text-muted fw-normal">branch</small></label>
                            <input id="create-feature-name"
                                   class="form-control @(NameValidationError is not null ? "is-invalid" : null)"
                                   @bind="_name"
                                   @bind:event="oninput"
                                   autocomplete="off"
                                   @ref="_nameInput" />
                            @if (NameValidationError is not null)
                            {
                                <div class="text-danger small mt-1">@NameValidationError</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="create-feature-base">Based on</label>
                            <div id="create-feature-base" class="form-control" aria-disabled="true" tabindex="-1">
                                Current Workspace
                                @if (!string.IsNullOrWhiteSpace(WorkspaceBranchName))
                                {
                                    <small class="text-muted fw-normal ms-1">@WorkspaceBranchName</small>
                                }
                            </div>
                        </div>
                        <div class="form-text text-muted mb-0">
                            @if (!string.IsNullOrWhiteSpace(WorkspaceBranchName))
                            {
                                <text>The Feature starts from the current committed state of <code class="mx-1" style="font-size: 1em;">@WorkspaceBranchName</code>. Uncommitted changes in Workspace are not copied and remain in Workspace.</text>
                            }
                            else
                            {
                                <text>The Feature starts from the current committed state. Uncommitted changes in Workspace are not copied and remain in Workspace.</text>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                        <button type="button" class="btn btn-primary" data-default-action @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(_name) || NameValidationError is not null)">
                            New Feature
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    @* While _busy, the dialog is hidden and the page-level BackgroundJobOverlay (driven by the
       "create-feature" structural operation) covers the page with its own "Creating feature..." message. *@
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public string? InitialName { get; set; }
    /// <summary>Unified Current Workspace branch name when every Workspace repo shares one; otherwise null.</summary>
    [Parameter] public string? WorkspaceBranchName { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<CreateFeatureResult> OnCreated { get; set; }

    private ElementReference _modalElement;
    private ElementReference _nameInput;
    private string _name = "";
    private string? _error;
    private IReadOnlyList<CreateFeatureBranchCollision>? _branchCollisions;
    private int _totalRepositoryCount;
    private bool _busy;
    private bool _wasVisible;
    private bool _focusPending;

    private bool HasBranchCollisions => _branchCollisions is { Count: > 0 };

    /// <summary>Null while the field is empty (no error shown before the user types anything) or valid.</summary>
    private string? NameValidationError =>
        string.IsNullOrWhiteSpace(_name) ? null : FeatureNameValidator.Validate(_name.Trim());

    private string BranchExistsSummary =>
        FormatBranchExistsSummary(_name.Trim(), _branchCollisions?.Count ?? 0, _totalRepositoryCount);

    /// <summary>Short "X of Y" summary for BranchExists without the concatenated Error string (E5).</summary>
    internal static string FormatBranchExistsSummary(string featureName, int collisionCount, int totalRepositoryCount)
    {
        var name = string.IsNullOrWhiteSpace(featureName) ? "this name" : $"'{featureName.Trim()}'";
        if (totalRepositoryCount <= 0)
            return $"Branch {name} already exists in {collisionCount} repositories";
        return $"Branch {name} already exists in {collisionCount} of {totalRepositoryCount} repositories";
    }

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            _name = InitialName?.Trim() ?? "";
            _error = null;
            _branchCollisions = null;
            _totalRepositoryCount = 0;
            _focusPending = true;
        }

        _wasVisible = IsVisible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending)
            return;

        _focusPending = false;
        try
        {
            await _nameInput.FocusAsync();
        }
        catch
        {
            // circuit / JS unavailable
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        _branchCollisions = null;
        _totalRepositoryCount = 0;
        try
        {
            var result = await FeatureOperations.CreateFeatureAsync(
                WorkspaceId,
                _name.Trim(),
                WorkspaceFeatureBaseKindApplication.CurrentWorkspace);
            if (!result.Success)
            {
                if (string.Equals(result.Condition, "BranchExists", StringComparison.Ordinal)
                    && result.BranchCollisions is { Count: > 0 })
                {
                    _branchCollisions = result.BranchCollisions;
                    _totalRepositoryCount = result.TotalRepositoryCount ?? result.BranchCollisions.Count;
                    _error = null;
                    return;
                }

                // Partial create: close and let the parent open Status and repair (C5).
                if (string.Equals(result.Condition, "NeedsRepair", StringComparison.Ordinal)
                    && result.ContextId is not null)
                {
                    await OnCreated.InvokeAsync(result);
                    return;
                }

                _error = result.Error ?? result.Condition ?? "Feature creation failed.";
                return;
            }

            await OnCreated.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Create Feature failed");
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Cancel() => OnCancel.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_busy)
        {
            await Cancel();
        }
        else if (ModalKeyboard.IsPlainEnter(e) && !_busy && !string.IsNullOrWhiteSpace(_name) && NameValidationError is null)
        {
            // Ctrl/Cmd+Enter is handled globally by modal-default-action.js via data-default-action.
            await CreateAsync();
        }
    }
}
