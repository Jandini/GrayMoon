@using GrayMoon.Application
@using GrayMoon.Application.Features
@inject IWorkspaceFeatureOperations FeatureOperations
@inject ILogger<RemoveFeatureModal> Logger

@if (IsVisible && !_removing)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1085;">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Remove Feature</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="@(_report is null ? Cancel : Done)" disabled="@_analyzing"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="gm-callout gm-callout--error mb-3" role="alert">@_error</div>
                    }
                    @if (_report is not null && string.IsNullOrEmpty(_error))
                    {
                        <div class="gm-callout gm-callout--warning mb-3" role="alert">
                            Feature removed with warnings.
                        </div>
                        @if (ReportWarnings.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var warning in ReportWarnings)
                                {
                                    <li class="mb-2">
                                        <div class="text-muted small">@warning</div>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_plan is null)
                    {
                        @* Fallback only: normal open preloads the plan via the page LoadingOverlay. *@
                        @if (string.IsNullOrEmpty(_error))
                        {
                            <p class="mb-0 text-muted">@( _analyzing ? "Refreshing removal details…" : "No removal plan is available." )</p>
                        }
                    }
                    else if (_plan.Success)
                    {
                        <div class="gm-callout @CalloutClass mb-3" role="alert">
                            @StatusHeadline
                        </div>
                        <p class="mb-2 fw-semibold">This will remove the following from your computer:</p>
                        <ul class="list-unstyled mb-2">
                            @foreach (var repo in _plan.Repositories)
                            {
                                <li class="mb-2">
                                    <strong>@repo.RepositoryName</strong>
                                    <div class="text-muted small">@DescribeRepository(repo)</div>
                                </li>
                            }
                        </ul>
                        <p class="text-muted small mb-3">Local branches are deleted. Remote branches are kept.</p>
                        @if (AnyRepoStatusUnknown)
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Could not check this repository. Make sure the Worker is running, then try again.
                            </div>
                        }
                        @if (_plan.PullRequestStatusUnknown)
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Could not check pull requests. GitHub may be offline or rate limited.
                            </div>
                        }
                        @if (!AnyRepoStatusUnknown && (ShowDiscardCheckbox || ShowForceCheckbox))
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Some work in this Feature hasn't been safely saved yet (see above). Removing it now
                                will permanently delete that work. Confirm below to continue anyway.
                            </div>
                            @if (ShowDiscardCheckbox)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="allow-discard" @bind="_allowDiscard" disabled="@_analyzing" />
                                    <label class="form-check-label" for="allow-discard">
                                        Permanently discard uncommitted changes in @DirtyRepositories.Count repositor@(DirtyRepositories.Count == 1 ? "y" : "ies")
                                    </label>
                                </div>
                                <ul class="list-unstyled mb-2 ms-4">
                                    @foreach (var repo in DirtyRepositories)
                                    {
                                        <li class="text-muted small">@repo.RepositoryName</li>
                                    }
                                </ul>
                            }
                            @if (ShowForceCheckbox)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="allow-force" @bind="_allowForce" disabled="@_analyzing" />
                                    <label class="form-check-label" for="allow-force">
                                        Delete local Feature branches that have commits not in the default branch (@BranchesNotInDefaultRepositories.Count)
                                    </label>
                                </div>
                                <ul class="list-unstyled mb-2 ms-4">
                                    @foreach (var repo in BranchesNotInDefaultRepositories)
                                    {
                                        var count = repo.EffectiveAheadOfDefault ?? 0;
                                        <li class="text-muted small">@repo.RepositoryName: @(repo.FeatureBranchName ?? repo.BranchName) (@count commit@(count == 1 ? "" : "s"))</li>
                                    }
                                </ul>
                            }
                        }
                        @if (!AnyRepoStatusUnknown && ShowUnlockCheckbox)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="allow-unlock" @bind="_allowUnlock" disabled="@_analyzing" />
                                <label class="form-check-label" for="allow-unlock">
                                    Unlock and remove @LockedRepositories.Count locked worktree@(LockedRepositories.Count == 1 ? "" : "s")
                                </label>
                            </div>
                            <ul class="list-unstyled mb-2 ms-4">
                                @foreach (var repo in LockedRepositories)
                                {
                                    <li class="text-muted small">@repo.RepositoryName@(string.IsNullOrWhiteSpace(repo.LockReason) ? "" : $": {repo.LockReason}")</li>
                                }
                            </ul>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (_report is not null)
                    {
                        <button type="button" class="btn btn-primary" @onclick="Done">Done</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@_analyzing">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="RemoveAsync"
                                disabled="@(_analyzing || _plan is null || !CanRemove(AnyRepoStatusUnknown, ShowDiscardCheckbox, _allowDiscard, ShowForceCheckbox, _allowForce, ShowUnlockCheckbox, _allowUnlock))">
                            Remove Feature
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
@* While _removing, the dialog is hidden and the page-level BackgroundJobOverlay (driven by the
   "remove-feature" structural operation) covers the page with its own "Removing feature..." message. *@

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public WorkspaceFeatureContextId? FeatureContextId { get; set; }
    /// <summary>
    /// Pre-analyzed plan from the page LoadingOverlay job. When set, the dialog skips its own
    /// "Checking..." analyze on open and shows this plan immediately.
    /// </summary>
    [Parameter] public RemoveFeaturePlan? InitialPlan { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRemoved { get; set; }

    private RemoveFeaturePlan? _plan;
    private IReadOnlyList<RemoveFeatureRepositoryReport>? _report;
    private string? _error;
    private bool _analyzing;
    private bool _removing;
    private bool _allowDiscard;
    private bool _allowForce;
    private bool _allowUnlock;
    private int? _analyzedFor;
    private int? _appliedInitialPlanFor;

    /// <summary>
    /// True when a successful remove left something the user should acknowledge: kept/failed branch,
    /// leftover files, or a branch kept because the worktree was off its Feature branch.
    /// </summary>
    internal static bool HasReportWarnings(IReadOnlyList<RemoveFeatureRepositoryReport>? report)
    {
        if (report is null || report.Count == 0)
            return false;

        foreach (var repo in report)
        {
            if (repo.BranchOutcome is RemoveFeatureBranchOutcome.KeptUnmerged or RemoveFeatureBranchOutcome.Failed)
                return true;
            if (repo.ResidueRemaining)
                return true;
            if (!string.IsNullOrWhiteSpace(repo.KeptBranchName))
                return true;
        }

        return false;
    }

    /// <summary>One line per repository that was not fully cleaned up: kept/failed branch, or leftover files.</summary>
    private IReadOnlyList<string> ReportWarnings
    {
        get
        {
            if (_report is null)
                return [];

            var warnings = new List<string>();
            foreach (var repo in _report)
            {
                if (repo.BranchOutcome == RemoveFeatureBranchOutcome.KeptUnmerged)
                    warnings.Add($"{repo.RepositoryName}: local branch kept (has commits not in the default branch).");
                else if (repo.BranchOutcome == RemoveFeatureBranchOutcome.Failed)
                    warnings.Add($"{repo.RepositoryName}: local branch delete failed. {repo.BranchMessage}".TrimEnd());

                // 09 SB-2: the worktree was on another branch (or a detached commit) instead of its
                // Feature branch; that branch was never deleted and is still in the Workspace.
                if (!string.IsNullOrWhiteSpace(repo.KeptBranchName))
                    warnings.Add($"{repo.RepositoryName}: {repo.KeptBranchName} kept (this repository was not on its Feature branch).");

                if (repo.ResidueRemaining)
                {
                    var fileWord = repo.ResidueFileCount == 1 ? "file" : "files";
                    warnings.Add(
                        $"{repo.RepositoryName}: {repo.ResidueFileCount} leftover {fileWord} could not be removed. {repo.ResidueMessage}".TrimEnd());
                }
            }

            return warnings;
        }
    }

    /// <summary>True when the Agent could not confirm disk state for one or more repositories. Remove is disabled in that case.</summary>
    private bool AnyRepoStatusUnknown => _plan?.Repositories.Any(r => r.WorktreeStatusUnknown) == true;

    /// <summary>Repositories with uncommitted, staged or conflicting changes (D3). Drives the discard checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> DirtyRepositories =>
        _plan?.Repositories.Where(IsRepositoryDirty).ToList() ?? [];

    /// <summary>Shown only when at least one repository is actually dirty (D3, fixes U-17).</summary>
    private bool ShowDiscardCheckbox => DirtyRepositories.Count > 0;

    /// <summary>Repositories with live commits ahead of the default branch and no merged pull request (D3). Drives the force-delete-branch checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> BranchesNotInDefaultRepositories =>
        _plan?.Repositories.Where(HasUnmergedBranchAheadOfDefault).ToList() ?? [];

    /// <summary>Shown only when at least one repository actually has unmerged commits ahead of the default branch (D3, fixes U-17).</summary>
    private bool ShowForceCheckbox => BranchesNotInDefaultRepositories.Count > 0;

    /// <summary>Repositories reported locked (<c>git worktree lock</c>) by the Agent (D5). Drives the unlock checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> LockedRepositories =>
        _plan?.Repositories.Where(HasLockedWorktree).ToList() ?? [];

    /// <summary>Shown only when at least one repository is actually locked (D5). An old Worker never reports a lock, so no checkbox appears.</summary>
    private bool ShowUnlockCheckbox => LockedRepositories.Count > 0;

    internal static bool IsRepositoryDirty(RemoveFeatureRepositoryPlan repo) =>
        repo.HasUncommittedChanges || repo.HasStagedChanges || repo.HasConflicts;

    internal static bool HasUnmergedBranchAheadOfDefault(RemoveFeatureRepositoryPlan repo) =>
        (repo.EffectiveAheadOfDefault ?? 0) > 0 && repo.PullRequestMerged != true;

    internal static bool HasLockedWorktree(RemoveFeatureRepositoryPlan repo) => repo.IsLocked;

    /// <summary>
    /// Remove is enabled only when every checkbox the dialog actually shows has been ticked, and never
    /// while any repository's disk state is Unknown (A2). A checkbox that is not shown because its own
    /// risk does not apply never blocks Remove (D3, fixes U-17).
    /// </summary>
    internal static bool CanRemove(
        bool anyRepoStatusUnknown,
        bool showDiscardCheckbox,
        bool allowDiscard,
        bool showForceCheckbox,
        bool allowForce,
        bool showUnlockCheckbox,
        bool allowUnlock)
    {
        if (anyRepoStatusUnknown)
            return false;
        if (showDiscardCheckbox && !allowDiscard)
            return false;
        if (showForceCheckbox && !allowForce)
            return false;
        if (showUnlockCheckbox && !allowUnlock)
            return false;
        return true;
    }

    /// <summary>
    /// True when a repository has live commits ahead of its default branch but no pull request opened
    /// for them yet, so the generic Active headline would be misleading ("hasn't been merged" implies
    /// one exists to merge).
    /// </summary>
    private bool HasOutgoingCommitsWithoutPullRequest =>
        _plan?.Repositories.Any(r => (r.AheadOfDefault ?? 0) > 0 && r.PullRequestNumber is null or 0) == true;

    /// <summary>Plain-language summary of the Feature's completion state, replacing the raw enum name in the UI.</summary>
    private string StatusHeadline
    {
        get
        {
            if (_plan?.Classification == RemoveFeatureClassification.Active && HasOutgoingCommitsWithoutPullRequest)
                return "Some repositories have commits that are not in a pull request yet.";

            return _plan?.Classification switch
            {
                RemoveFeatureClassification.Completed =>
                    "This Feature is finished (pull request merged, or never opened), so it's safe to remove.",
                RemoveFeatureClassification.Abandoned =>
                    "This Feature's pull request was closed without merging. Removing it will permanently delete this work.",
                RemoveFeatureClassification.Active =>
                    "This Feature still has work that hasn't been merged yet. Removing it now will discard that work.",
                RemoveFeatureClassification.NeedsRepair =>
                    "GrayMoon couldn't confirm the state of one or more repositories for this Feature. Review the details below before removing it.",
                _ => "Review the details below before removing this Feature."
            };
        }
    }

    private string CalloutClass => _plan?.Classification switch
    {
        RemoveFeatureClassification.Completed => "gm-callout--success",
        RemoveFeatureClassification.Abandoned => "gm-callout--warning",
        RemoveFeatureClassification.NeedsRepair => "gm-callout--warning",
        _ => "gm-callout--info"
    };

    /// <summary>Plain-language, per-repository summary replacing raw field dumps like "worktree present; 3 outgoing".</summary>
    private static string DescribeRepository(RemoveFeatureRepositoryPlan repo)
    {
        var parts = new List<string>();

        // 09 SB-2: tell the owner exactly which branch is kept and which is deleted, before anything
        // about worktree or commit state, since this changes what "safe to remove" means below.
        if (repo.IsOffFeatureBranch)
        {
            var current = string.IsNullOrWhiteSpace(repo.CheckedOutBranch) ? "a detached commit" : $"`{repo.CheckedOutBranch}`";
            parts.Add(
                $"This repository is on {current}, not on its Feature branch `{repo.FeatureBranchName}`. " +
                $"{current} is kept; `{repo.FeatureBranchName}` is deleted.");
        }
        else if (repo.FeatureBranchName is not null && repo.FeatureBranchExists == false)
        {
            parts.Add("The Feature branch is already gone; nothing to delete.");
        }

        if (repo.WorktreeStatusUnknown)
        {
            // The trailing Warning check below already adds the explanation for this repository.
        }
        else if (!repo.WorktreeExists)
        {
            parts.Add("Folder is already missing on disk");
        }
        else if (!repo.LiveStatusEstablished)
        {
            parts.Add("Live worktree status unavailable");
        }
        else
        {
            if (repo.HasConflicts)
                parts.Add("Has unresolved conflicts");
            if (repo.HasStagedChanges)
                parts.Add("Has staged changes");
            if (repo.HasUncommittedChanges)
                parts.Add("Has uncommitted changes");
        }

        if (repo.OutgoingCommits is int outgoing && outgoing > 0)
        {
            parts.Add($"{outgoing} commit{(outgoing == 1 ? "" : "s")} not pushed to the remote");
        }

        if (repo.PullRequestNumber is int prNumber)
        {
            var state = repo.PullRequestMerged == true ? "merged"
                : string.Equals(repo.PullRequestState, "closed", StringComparison.OrdinalIgnoreCase) ? "closed without merging"
                : "still open";
            parts.Add($"Pull request #{prNumber} is {state}");
        }
        else if (repo.HasUpstream)
        {
            parts.Add("No pull request has been opened for this branch");
        }

        if (!string.IsNullOrEmpty(repo.Warning))
        {
            parts.Add(repo.Warning);
        }

        if (parts.Count == 0)
        {
            parts.Add("Up to date with nothing pending");
        }

        return string.Join(" · ", parts);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible || FeatureContextId is null)
            return;

        // After a successful remove the Feature context is gone. Never re-analyze while showing the
        // warnings report (or while the structural overlay is covering the page) — that would surface
        // "WorkspaceFeatureContext N was not found" next to the removal outcome.
        if (_removing || _report is not null)
            return;

        // Page already ran analyze under LoadingOverlay; show that plan immediately (no in-dialog check).
        if (InitialPlan is not null
            && _appliedInitialPlanFor != FeatureContextId.Value.Value)
        {
            ApplyPlan(InitialPlan);
            _appliedInitialPlanFor = FeatureContextId.Value.Value;
            return;
        }

        if (_analyzedFor == FeatureContextId.Value.Value && _plan is not null)
            return;

        // Fallback when opened without a preloaded plan (should not happen from Repositories).
        _analyzing = true;
        _error = null;
        try
        {
            await RefreshPlanAsync();
        }
        finally
        {
            _analyzing = false;
        }
    }

    private void ApplyPlan(RemoveFeaturePlan plan)
    {
        _plan = plan;
        _analyzedFor = FeatureContextId?.Value;
        _report = null;
        _allowDiscard = false;
        _allowForce = false;
        _allowUnlock = false;
        _error = plan.Success ? null : plan.Error;
    }

    /// <summary>
    /// Reloads the removal plan. Used on open and after a failed remove so a locked folder's
    /// stored error shows in the open dialog without closing it. Does not clear <see cref="_error"/>.
    /// </summary>
    private async Task RefreshPlanAsync()
    {
        if (FeatureContextId is null)
            return;

        try
        {
            _plan = await FeatureOperations.AnalyzeRemoveFeatureAsync(FeatureContextId.Value);
            _analyzedFor = FeatureContextId.Value.Value;
            if (!_plan.Success && string.IsNullOrEmpty(_error))
                _error = _plan.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AnalyzeRemoveFeature failed");
            if (string.IsNullOrEmpty(_error))
                _error = ex.Message;
        }
    }

    private async Task RemoveAsync()
    {
        if (FeatureContextId is null)
            return;
        _removing = true;
        _error = null;
        _report = null;
        try
        {
            var result = await FeatureOperations.RemoveFeatureAsync(
                FeatureContextId.Value,
                new RemoveFeatureOptions
                {
                    AllowDiscardUncommitted = _allowDiscard,
                    AllowForceDeleteLocalBranches = _allowForce,
                    AllowUnlockWorktrees = _allowUnlock,
                    AnalyzedPlan = _plan
                });
            if (!result.Success)
            {
                // Hard failure: error only — never pair with a green/success report.
                _report = null;
                _error = result.Error ?? "Remove Feature failed.";
                await RefreshPlanAsync();
                return;
            }

            var report = result.RemoveFeatureReport ?? [];
            if (!HasReportWarnings(report))
            {
                // Clean success: close immediately; page shows a toast via OnRemoved.
                ResetDialogState();
                await OnRemoved.InvokeAsync();
                return;
            }

            // Success with warnings the user must acknowledge — warnings dialog only (no success headline).
            _plan = null;
            _analyzedFor = null;
            _error = null;
            _report = report;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Remove Feature failed");
            _report = null;
            _error = ex.Message;
        }
        finally
        {
            _removing = false;
        }
    }

    private void ResetDialogState()
    {
        _plan = null;
        _analyzedFor = null;
        _appliedInitialPlanFor = null;
        _report = null;
        _allowDiscard = false;
        _allowForce = false;
        _allowUnlock = false;
        _error = null;
    }

    private Task Cancel()
    {
        ResetDialogState();
        return OnCancel.InvokeAsync();
    }

    private async Task Done()
    {
        ResetDialogState();
        await OnRemoved.InvokeAsync();
    }
}
