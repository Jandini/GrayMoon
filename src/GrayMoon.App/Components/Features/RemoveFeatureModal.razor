@using GrayMoon.Application
@using GrayMoon.Application.Features
@inject IWorkspaceFeatureOperations FeatureOperations
@inject ILogger<RemoveFeatureModal> Logger

@if (IsVisible && !_removing)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1085;"
         @onkeydown="HandleKeyDown"
         @ref="_modalElement">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    @* Title no-wrap/ellipsis — same .modal-title--compound convention as BranchModal/SwitchBranchModal/FeatureStatusPanel. *@
                    <h5 class="modal-title modal-title--compound">
                        <span class="modal-title__primary">Remove Feature</span>
                        @if (!string.IsNullOrEmpty(_featureName))
                        {
                            <span class="modal-title__secondary text-muted fw-normal fs-6" title="@_featureName">@_featureName</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="@(_report is null ? Cancel : Done)" disabled="@_analyzing"></button>
                </div>
                <div class="modal-body">
                    @if (HasInUseBlockers)
                    {
                        @* Remove failed because a worktree folder is in use: name the programs instead of a bare Git/IO error. *@
                        <div class="gm-callout gm-callout--warning mb-3" role="alert">
                            <div class="fw-semibold">@RemoveFeatureBlockerText.InUseTitle</div>
                            <div>@RemoveFeatureBlockerText.InUseBody</div>
                        </div>
                        @foreach (var repoBlockers in _blockers!)
                        {
                            <div class="mb-2" @key="repoBlockers.WorkspaceRepositoryId">
                                <div class="small fw-semibold mb-1">@repoBlockers.RepositoryName</div>
                                @if (repoBlockers.PathExists)
                                {
                                    <BlockingProcessList Processes="repoBlockers.Processes"
                                                         MayBeIncomplete="repoBlockers.MayBeIncomplete"
                                                         Diagnostic="@repoBlockers.Diagnostic" />
                                }
                                else
                                {
                                    <p class="text-muted small mb-1">The folder is gone. Select Retry to finish removing the Feature.</p>
                                }
                            </div>
                        }
                        <p class="text-muted small mb-2">@RemoveFeatureBlockerText.CloseAndRetry</p>
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <details class="small text-muted mb-3">
                                <summary>Details</summary>
                                <div class="text-break">@_error</div>
                            </details>
                        }
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="gm-callout gm-callout--error mb-3" role="alert">@_error</div>
                    }
                    @if (_report is not null && string.IsNullOrEmpty(_error))
                    {
                        <div class="gm-callout gm-callout--warning mb-3" role="alert">
                            Feature removed with warnings.
                        </div>
                        @if (ReportWarnings.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var warning in ReportWarnings)
                                {
                                    <li class="mb-2">
                                        <div class="text-muted small">@warning.Text</div>
                                        @if (warning.Leftover?.BlockingProcesses is { } leftoverBlockers)
                                        {
                                            <div class="mt-1 ms-2">
                                                <BlockingProcessList Processes="leftoverBlockers"
                                                                     MayBeIncomplete="warning.Leftover.BlockersMayBeIncomplete"
                                                                     Diagnostic="@warning.Leftover.BlockersDiagnostic" />
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (CanRetryLeftovers)
                            {
                                <p class="text-muted small mb-0 mt-2">@RemoveFeatureBlockerText.CloseAndRetry</p>
                            }
                        }
                    }
                    else if (_plan is null)
                    {
                        @* Fallback only: normal open preloads the plan via the page LoadingOverlay. *@
                        @if (string.IsNullOrEmpty(_error))
                        {
                            <p class="mb-0 text-muted">@( _analyzing ? "Refreshing removal details…" : "No removal plan is available." )</p>
                        }
                    }
                    else if (_plan.Success)
                    {
                        @if (UseNeutralStatusText)
                        {
                            <p class="mb-3">@StatusHeadline</p>
                        }
                        else
                        {
                            <div class="gm-callout @CalloutClass mb-3" role="alert">
                                @StatusHeadline
                            </div>
                        }
                        <p class="mb-2 fw-semibold">This will remove the following from your computer:</p>
                        @if (AllRepositoriesNothingPending)
                        {
                            <p class="text-muted small mb-2">@AllCleanSummaryText</p>
                        }
                        else
                        {
                            @if (DetailStatusGroups.Count > 0)
                            {
                                <ul class="list-unstyled mb-2 remove-feature-repo-list">
                                    @foreach (var group in DetailStatusGroups)
                                    {
                                        var repo = group.Repositories[0];
                                        <li class="mb-2">
                                            <strong>@repo.RepositoryName</strong>
                                            <div class="text-muted small">@group.Message</div>
                                        </li>
                                    }
                                </ul>
                            }
                            @foreach (var group in SummaryStatusGroups)
                            {
                                <p class="text-muted small mb-2">
                                    @FormatStatusGroupSummary(
                                        group.Message,
                                        group.Count,
                                        allRepositoriesShareThisStatus: RepositoryStatusGroups.Count == 1)
                                </p>
                            }
                        }
                        @if (ShowDeleteLocalBranchesCheckbox)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="delete-local-branches" @bind="_deleteLocalBranches" disabled="@_analyzing" />
                                <label class="form-check-label" for="delete-local-branches">
                                    Delete local Feature branches
                                </label>
                            </div>
                        }
                        @if (ShowDeleteRemoteBranchesCheckbox)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="delete-remote-branches" @bind="_deleteRemoteBranches" disabled="@_analyzing" />
                                <label class="form-check-label" for="delete-remote-branches">
                                    Delete remote Feature branches
                                </label>
                            </div>
                        }
                        else if (ShowNoRemoteBranchesNote)
                        {
                            <p class="text-muted small mb-2">No remote Feature branches to delete (this Feature was never pushed).</p>
                        }
                        @if (AnyRepoStatusUnknown)
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Could not check this repository. Make sure the Worker is running, then try again.
                            </div>
                        }
                        @if (_plan.PullRequestStatusUnknown)
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Could not check pull requests. GitHub may be offline or rate limited.
                            </div>
                        }
                        @if (!AnyRepoStatusUnknown && (ShowDiscardCheckbox || ShowForceCheckbox))
                        {
                            <div class="gm-callout gm-callout--warning mb-3" role="alert">
                                Some work in this Feature hasn't been safely saved yet (see above). Removing it now
                                will permanently delete that work. Confirm below to continue anyway.
                            </div>
                            @if (ShowDiscardCheckbox)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="allow-discard" @bind="_allowDiscard" disabled="@_analyzing" />
                                    <label class="form-check-label" for="allow-discard">
                                        Permanently discard uncommitted changes in @DirtyRepositories.Count repositor@(DirtyRepositories.Count == 1 ? "y" : "ies")
                                    </label>
                                </div>
                                <ul class="list-unstyled mb-2 ms-4">
                                    @foreach (var repo in DirtyRepositories)
                                    {
                                        <li class="text-muted small">@repo.RepositoryName</li>
                                    }
                                </ul>
                            }
                            @if (ShowForceCheckbox)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="allow-force" @bind="_allowForce" disabled="@_analyzing" />
                                    <label class="form-check-label" for="allow-force">
                                        Delete local Feature branches that have commits not in the default branch (@BranchesNotInDefaultRepositories.Count)
                                    </label>
                                </div>
                                <ul class="list-unstyled mb-2 ms-4">
                                    @foreach (var repo in BranchesNotInDefaultRepositories)
                                    {
                                        var count = repo.EffectiveAheadOfDefault ?? 0;
                                        <li class="text-muted small">@repo.RepositoryName: @(repo.FeatureBranchName ?? repo.BranchName) (@count commit@(count == 1 ? "" : "s"))</li>
                                    }
                                </ul>
                            }
                        }
                        @if (!AnyRepoStatusUnknown && ShowUnlockCheckbox)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="allow-unlock" @bind="_allowUnlock" disabled="@_analyzing" />
                                <label class="form-check-label" for="allow-unlock">
                                    Unlock and remove @LockedRepositories.Count locked worktree@(LockedRepositories.Count == 1 ? "" : "s")
                                </label>
                            </div>
                            <ul class="list-unstyled mb-2 ms-4">
                                @foreach (var repo in LockedRepositories)
                                {
                                    <li class="text-muted small">@repo.RepositoryName@(string.IsNullOrWhiteSpace(repo.LockReason) ? "" : $": {repo.LockReason}")</li>
                                }
                            </ul>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (_report is not null)
                    {
                        @if (CanRetryLeftovers)
                        {
                            <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="RefreshBlockersAsync" disabled="@BlockerActionBusy">
                                @if (_refreshingBlockers)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                Refresh blockers
                            </button>
                            <button type="button" class="btn btn-outline-primary text-nowrap" @onclick="RetryLeftoversAsync" disabled="@BlockerActionBusy">
                                @if (_retryingLeftovers)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                Retry
                            </button>
                        }
                        <button type="button" class="btn btn-primary text-nowrap" data-default-action @onclick="Done" disabled="@BlockerActionBusy">Done</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="Cancel" disabled="@(_analyzing || BlockerActionBusy)">Cancel</button>
                        @if (HasInUseBlockers)
                        {
                            <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="RefreshBlockersAsync" disabled="@(_analyzing || BlockerActionBusy)">
                                @if (_refreshingBlockers)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                Refresh blockers
                            </button>
                        }
                        <button type="button" class="@RemoveCtaClass text-nowrap" data-default-action @onclick="RemoveAsync"
                                disabled="@(_analyzing || BlockerActionBusy || _plan is null || !CanRemove(AnyRepoStatusUnknown, ShowDiscardCheckbox, _allowDiscard, ShowForceCheckbox, _allowForce, ShowUnlockCheckbox, _allowUnlock))">
                            @(HasInUseBlockers ? "Retry" : "Remove Feature")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
@* While _removing, the dialog is hidden and the page-level BackgroundJobOverlay (driven by the
   "remove-feature" structural operation) covers the page with its own "Removing feature..." message. *@

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public WorkspaceFeatureContextId? FeatureContextId { get; set; }
    /// <summary>
    /// Pre-analyzed plan from the page LoadingOverlay job. When set, the dialog skips its own
    /// "Checking..." analyze on open and shows this plan immediately.
    /// </summary>
    [Parameter] public RemoveFeaturePlan? InitialPlan { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRemoved { get; set; }

    private ElementReference _modalElement;
    private RemoveFeaturePlan? _plan;
    private IReadOnlyList<RemoveFeatureRepositoryReport>? _report;
    private string? _error;
    private bool _analyzing;
    private bool _removing;
    private bool _allowDiscard;
    private bool _allowForce;
    private bool _allowUnlock;
    private bool _deleteLocalBranches = true;
    private bool _deleteRemoteBranches;
    private int? _analyzedFor;
    private int? _appliedInitialPlanFor;
    private string? _featureName;
    private int? _featureNameLoadedFor;

    /// <summary>Processes holding worktree folders after a Remove that failed because they are in use; null otherwise.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryBlockers>? _blockers;
    private bool _refreshingBlockers;
    private bool _retryingLeftovers;

    private bool HasInUseBlockers => _report is null && _blockers is { Count: > 0 };

    private bool BlockerActionBusy => _refreshingBlockers || _retryingLeftovers;

    /// <summary>True when a removed Feature left files behind that a Retry can try to delete again.</summary>
    private bool CanRetryLeftovers => _report?.Any(r => r.ResidueRemaining && r.ResidueTarget is not null) == true;

    /// <summary>One line of the "removed with warnings" report; <see cref="Leftover"/> is set for a leftover-files line.</summary>
    internal sealed record ReportWarning(string Text, RemoveFeatureRepositoryReport? Leftover = null);

    /// <summary>
    /// True when a successful remove left something the user should acknowledge: kept/failed branch,
    /// leftover files, or a branch kept because the worktree was off its Feature branch.
    /// </summary>
    internal static bool HasReportWarnings(IReadOnlyList<RemoveFeatureRepositoryReport>? report)
    {
        if (report is null || report.Count == 0)
            return false;

        foreach (var repo in report)
        {
            if (repo.BranchOutcome is RemoveFeatureBranchOutcome.KeptUnmerged
                or RemoveFeatureBranchOutcome.Failed
                or RemoveFeatureBranchOutcome.Kept)
                return true;
            if (repo.RemoteBranchOutcome is RemoveFeatureRemoteBranchOutcome.Failed
                or RemoveFeatureRemoteBranchOutcome.RefusedLease
                or RemoveFeatureRemoteBranchOutcome.Kept)
                return true;
            if (repo.ResidueRemaining)
                return true;
            if (!string.IsNullOrWhiteSpace(repo.KeptBranchName))
                return true;
        }

        return false;
    }

    /// <summary>One line per repository that was not fully cleaned up: kept/failed branch, or leftover files.</summary>
    private IReadOnlyList<ReportWarning> ReportWarnings => BuildReportWarnings(_report);

    internal static IReadOnlyList<ReportWarning> BuildReportWarnings(IReadOnlyList<RemoveFeatureRepositoryReport>? report)
    {
        if (report is null)
            return [];

        var warnings = new List<ReportWarning>();
        foreach (var repo in report)
        {
            if (repo.BranchOutcome == RemoveFeatureBranchOutcome.KeptUnmerged)
                warnings.Add(new($"{repo.RepositoryName}: local branch kept (has commits not in the default branch)."));
            else if (repo.BranchOutcome == RemoveFeatureBranchOutcome.Kept)
                warnings.Add(new($"{repo.RepositoryName}: local Feature branch kept."));
            else if (repo.BranchOutcome == RemoveFeatureBranchOutcome.Failed)
                warnings.Add(new($"{repo.RepositoryName}: local branch delete failed. {repo.BranchMessage}".TrimEnd()));

            if (repo.RemoteBranchOutcome == RemoveFeatureRemoteBranchOutcome.Kept)
                warnings.Add(new($"{repo.RepositoryName}: remote Feature branch kept."));
            else if (repo.RemoteBranchOutcome == RemoveFeatureRemoteBranchOutcome.RefusedLease)
                warnings.Add(new($"{repo.RepositoryName}: remote branch kept (tip no longer matches this Feature). {repo.RemoteBranchMessage}".TrimEnd()));
            else if (repo.RemoteBranchOutcome == RemoveFeatureRemoteBranchOutcome.Failed)
                warnings.Add(new($"{repo.RepositoryName}: remote branch delete failed. {repo.RemoteBranchMessage}".TrimEnd()));

            // 09 SB-2: the worktree was on another branch (or a detached commit) instead of its
            // Feature branch; that branch was never deleted and is still in the Workspace.
            if (!string.IsNullOrWhiteSpace(repo.KeptBranchName))
                warnings.Add(new($"{repo.RepositoryName}: {repo.KeptBranchName} kept (this repository was not on its Feature branch)."));

            if (repo.ResidueRemaining)
            {
                // Files are often all deleted while the folder itself stays in use (a shell or AI tool sitting in it).
                var text = repo.ResidueFileCount > 0
                    ? $"{repo.RepositoryName}: {repo.ResidueFileCount} leftover {(repo.ResidueFileCount == 1 ? "file" : "files")} could not be removed. {repo.ResidueMessage}"
                    : $"{repo.RepositoryName}: {(string.IsNullOrWhiteSpace(repo.ResidueMessage) ? "The worktree folder could not be removed." : repo.ResidueMessage)}";
                warnings.Add(new(text.TrimEnd(), repo));
            }
        }

        return warnings;
    }

    /// <summary>True when the Worker could not confirm disk state for one or more repositories. Remove is disabled in that case.</summary>
    private bool AnyRepoStatusUnknown => _plan?.Repositories.Any(r => r.WorktreeStatusUnknown) == true;

    /// <summary>Repositories with uncommitted, staged or conflicting changes (D3). Drives the discard checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> DirtyRepositories =>
        _plan?.Repositories.Where(IsRepositoryDirty).ToList() ?? [];

    /// <summary>Shown only when at least one repository is actually dirty (D3, fixes U-17).</summary>
    private bool ShowDiscardCheckbox => DirtyRepositories.Count > 0;

    /// <summary>Repositories with live commits ahead of the default branch and no merged pull request (D3). Drives the force-delete-branch checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> BranchesNotInDefaultRepositories =>
        _plan?.Repositories.Where(HasUnmergedBranchAheadOfDefault).ToList() ?? [];

    /// <summary>Shown only when at least one repository actually has unmerged commits ahead of the default branch (D3, fixes U-17).</summary>
    private bool ShowForceCheckbox => BranchesNotInDefaultRepositories.Count > 0;

    /// <summary>Repositories reported locked (<c>git worktree lock</c>) by the Worker (D5). Drives the unlock checkbox.</summary>
    private IReadOnlyList<RemoveFeatureRepositoryPlan> LockedRepositories =>
        _plan?.Repositories.Where(HasLockedWorktree).ToList() ?? [];

    /// <summary>Shown only when at least one repository is actually locked (D5). An old Worker never reports a lock, so no checkbox appears.</summary>
    private bool ShowUnlockCheckbox => LockedRepositories.Count > 0;

    private bool ShowDeleteLocalBranchesCheckbox =>
        _plan?.Repositories.Any(HasLocalFeatureBranchToDelete) == true;

    private bool ShowDeleteRemoteBranchesCheckbox =>
        _plan?.Repositories.Any(HasRemoteFeatureBranchToDelete) == true;

    private bool ShowNoRemoteBranchesNote =>
        ShowDeleteLocalBranchesCheckbox && !ShowDeleteRemoteBranchesCheckbox;

    private bool AllRepositoriesNothingPending =>
        _plan is { Repositories.Count: > 0 }
        && _plan.Repositories.All(IsRepositoryNothingPending);

    private IReadOnlyList<RepositoryStatusGroup> RepositoryStatusGroups =>
        _plan is null ? [] : BuildRepositoryStatusGroups(_plan.Repositories);

    private IReadOnlyList<RepositoryStatusGroup> DetailStatusGroups =>
        RepositoryStatusGroups.Where(g => !ShouldSummarizeStatusGroup(g)).ToList();

    private IReadOnlyList<RepositoryStatusGroup> SummaryStatusGroups =>
        RepositoryStatusGroups
            .Where(ShouldSummarizeStatusGroup)
            // Keep the clean/"other" line after non-clean summaries so "other" reads correctly.
            .OrderBy(g => string.Equals(g.Message, NothingPendingStatusMessage, StringComparison.Ordinal) ? 1 : 0)
            .ToList();

    private string AllCleanSummaryText =>
        _plan is null || _plan.Repositories.Count == 0
            ? "All repositories are up to date with nothing pending."
            : _plan.Repositories.Count == 1
                ? "All 1 repository is up to date with nothing pending."
                : $"All {_plan.Repositories.Count} repositories are up to date with nothing pending.";

    /// <summary>
    /// One group of repositories that share an identical <see cref="DescribeRepository"/> message.
    /// </summary>
    internal sealed record RepositoryStatusGroup(
        string Message,
        int Count,
        IReadOnlyList<RemoveFeatureRepositoryPlan> Repositories);

    /// <summary>
    /// Groups repositories by identical status message, preserving first-seen order (D6 follow-up).
    /// Identical statuses are summarized; unique ones stay as per-repo detail.
    /// </summary>
    internal static IReadOnlyList<RepositoryStatusGroup> BuildRepositoryStatusGroups(
        IReadOnlyList<RemoveFeatureRepositoryPlan> repositories)
    {
        if (repositories.Count == 0)
            return [];

        var groups = new List<RepositoryStatusGroup>();
        var indexByMessage = new Dictionary<string, int>(StringComparer.Ordinal);

        foreach (var repo in repositories)
        {
            var message = DescribeRepository(repo);
            if (indexByMessage.TryGetValue(message, out var index))
            {
                var existing = groups[index];
                var repos = existing.Repositories.ToList();
                repos.Add(repo);
                groups[index] = existing with { Count = repos.Count, Repositories = repos };
            }
            else
            {
                indexByMessage[message] = groups.Count;
                groups.Add(new RepositoryStatusGroup(message, 1, [repo]));
            }
        }

        return groups;
    }

    /// <summary>
    /// True when a status group should collapse to one summary line instead of listing each repository.
    /// Identical statuses (count &gt; 1) always summarize; the clean/"nothing pending" group also
    /// always summarizes so mixed plans keep the "N other repositories are up to date…" voice.
    /// </summary>
    internal static bool ShouldSummarizeStatusGroup(RepositoryStatusGroup group) =>
        group.Count > 1
        || string.Equals(group.Message, NothingPendingStatusMessage, StringComparison.Ordinal);

    /// <summary>
    /// Copy for a collapsed identical-status group. Matches the all-clean / "other clean" voice.
    /// </summary>
    internal static string FormatStatusGroupSummary(
        string message,
        int count,
        bool allRepositoriesShareThisStatus)
    {
        if (count <= 0)
            return message;

        if (string.Equals(message, NothingPendingStatusMessage, StringComparison.Ordinal))
        {
            if (allRepositoriesShareThisStatus)
            {
                return count == 1
                    ? "All 1 repository is up to date with nothing pending."
                    : $"All {count} repositories are up to date with nothing pending.";
            }

            // Mixed plan: always "other", whether the remaining statuses are detail rows or summaries.
            return count == 1
                ? "1 other repository is up to date with nothing pending."
                : $"{count} other repositories are up to date with nothing pending.";
        }

        if (string.Equals(message, NoPullRequestStatusMessage, StringComparison.Ordinal))
        {
            if (allRepositoriesShareThisStatus)
            {
                return count == 1
                    ? "1 repository has no pull request opened for this branch."
                    : $"All {count} repositories have no pull request opened for this branch.";
            }

            return count == 1
                ? "1 repository has no pull request opened for this branch."
                : $"{count} repositories have no pull request opened for this branch.";
        }

        if (allRepositoriesShareThisStatus)
        {
            return count == 1
                ? message
                : $"All {count} repositories: {message}.";
        }

        return count == 1
            ? message
            : $"{count} repositories: {message}.";
    }

    internal const string NothingPendingStatusMessage = "Up to date with nothing pending";
    internal const string NoPullRequestStatusMessage = "No pull request has been opened for this branch";

    /// <summary>
    /// True when the Feature still has work the user hasn't safely saved (dirty worktree, or local
    /// commits/branches that would be force-deleted). "Completed" classification only reflects pull
    /// request state, so a Feature can be PR-Completed and still have this kind of pending work; in
    /// that case the headline must not call removal "safe" (fixes the Completed+dirty contradiction).
    /// </summary>
    private bool HasUnsavedWork => ShowDiscardCheckbox || ShowForceCheckbox;

    private bool UseNeutralStatusText =>
        _plan?.Classification == RemoveFeatureClassification.Completed && !HasUnsavedWork;

    private string RemoveCtaClass =>
        _plan is not null && !RemoveCtaIsDestructive(_plan)
            ? "btn remove-feature-btn-safe"
            : "btn btn-danger";

    internal static bool IsRepositoryDirty(RemoveFeatureRepositoryPlan repo) =>
        repo.HasUncommittedChanges || repo.HasStagedChanges || repo.HasConflicts;

    internal static bool HasUnmergedBranchAheadOfDefault(RemoveFeatureRepositoryPlan repo) =>
        (repo.EffectiveAheadOfDefault ?? 0) > 0 && repo.PullRequestMerged != true;

    internal static bool HasLockedWorktree(RemoveFeatureRepositoryPlan repo) => repo.IsLocked;

    internal static bool HasLocalFeatureBranchToDelete(RemoveFeatureRepositoryPlan repo) =>
        repo.FeatureBranchName is not null && repo.FeatureBranchExists != false;

    internal static bool HasRemoteFeatureBranchToDelete(RemoveFeatureRepositoryPlan repo) =>
        repo.FeatureBranchName is not null && repo.FeatureBranchHasUpstream == true;

    /// <summary>
    /// True when <see cref="DescribeRepository"/> would only say "Up to date with nothing pending" (D6).
    /// </summary>
    internal static bool IsRepositoryNothingPending(RemoveFeatureRepositoryPlan repo)
    {
        if (repo.IsOffFeatureBranch)
            return false;
        if (repo.FeatureBranchName is not null && repo.FeatureBranchExists == false)
            return false;
        if (repo.WorktreeStatusUnknown)
            return false;
        if (!repo.WorktreeExists)
            return false;
        if (!repo.LiveStatusEstablished)
            return false;
        if (repo.HasConflicts || repo.HasStagedChanges || repo.HasUncommittedChanges)
            return false;
        if (repo.OutgoingCommits is int outgoing && outgoing > 0)
            return false;
        if ((repo.EffectiveAheadOfDefault ?? 0) > 0 && repo.PullRequestMerged != true)
            return false;
        if (repo.PullRequestNumber is int)
            return false;
        if (repo.HasUpstream)
            return false;
        if (!string.IsNullOrEmpty(repo.Warning))
            return false;
        return true;
    }

    /// <summary>
    /// Green Remove CTA when removal is automatically safe; red when dropping unfinished work (D6).
    /// </summary>
    internal static bool RemoveCtaIsDestructive(RemoveFeaturePlan plan) =>
        !plan.IsAutomaticallySafe;

    /// <summary>
    /// Remove is enabled only when every checkbox the dialog actually shows has been ticked, and never
    /// while any repository's disk state is Unknown (A2). A checkbox that is not shown because its own
    /// risk does not apply never blocks Remove (D3, fixes U-17). Local/remote cleanup checkboxes (D4)
    /// are intent controls and do not gate Remove.
    /// </summary>
    internal static bool CanRemove(
        bool anyRepoStatusUnknown,
        bool showDiscardCheckbox,
        bool allowDiscard,
        bool showForceCheckbox,
        bool allowForce,
        bool showUnlockCheckbox,
        bool allowUnlock)
    {
        if (anyRepoStatusUnknown)
            return false;
        if (showDiscardCheckbox && !allowDiscard)
            return false;
        if (showForceCheckbox && !allowForce)
            return false;
        if (showUnlockCheckbox && !allowUnlock)
            return false;
        return true;
    }

    /// <summary>
    /// True when a repository has live commits ahead of its default branch but no pull request opened
    /// for them yet, so the generic Active headline would be misleading ("hasn't been merged" implies
    /// one exists to merge).
    /// </summary>
    private bool HasOutgoingCommitsWithoutPullRequest =>
        _plan?.Repositories.Any(r => (r.AheadOfDefault ?? 0) > 0 && r.PullRequestNumber is null or 0) == true;

    private bool AllPullRequestsMerged =>
        _plan?.Repositories.Any(r => r.PullRequestNumber is > 0) == true
        && _plan.Repositories.Where(r => r.PullRequestNumber is > 0).All(r => r.PullRequestMerged == true);

    /// <summary>Plain-language summary of the Feature's completion state, replacing the raw enum name in the UI.</summary>
    private string StatusHeadline
    {
        get
        {
            if (_plan?.Classification == RemoveFeatureClassification.Active && HasOutgoingCommitsWithoutPullRequest)
                return "Some repositories have commits that are not in a pull request yet.";

            // Completed only describes pull-request state (merged, or never opened). A Feature can be
            // Completed and still have unsaved worktree changes or local commits ahead of default - in
            // that case don't call it "safe to remove" here, since the warning callout below says the
            // opposite.
            if (_plan?.Classification == RemoveFeatureClassification.Completed && HasUnsavedWork)
            {
                return AllPullRequestsMerged
                    ? "This feature's pull requests are merged, but it still has work that hasn't been saved. Review before removing."
                    : "This feature has no pull request pending, but it still has work that hasn't been saved. Review before removing.";
            }

            return _plan?.Classification switch
            {
                RemoveFeatureClassification.Completed when AllPullRequestsMerged =>
                    "This feature's pull requests are merged. It is safe to remove.",
                RemoveFeatureClassification.Completed =>
                    "This feature is finished and safe to remove.",
                RemoveFeatureClassification.Abandoned =>
                    "This Feature's pull request was closed without merging. Removing it will permanently delete this work.",
                RemoveFeatureClassification.Active =>
                    "This Feature still has work that hasn't been merged yet. Removing it now will discard that work.",
                RemoveFeatureClassification.NeedsRepair =>
                    "GrayMoon couldn't confirm the state of one or more repositories for this Feature. Review the details below before removing it.",
                _ => "Review the details below before removing this Feature."
            };
        }
    }

    private string CalloutClass => _plan?.Classification switch
    {
        RemoveFeatureClassification.Abandoned => "gm-callout--warning",
        RemoveFeatureClassification.NeedsRepair => "gm-callout--warning",
        RemoveFeatureClassification.Completed when HasUnsavedWork => "gm-callout--warning",
        _ => "gm-callout--info"
    };

    /// <summary>Plain-language, per-repository summary replacing raw field dumps like "worktree present; 3 outgoing".</summary>
    internal static string DescribeRepository(RemoveFeatureRepositoryPlan repo)
    {
        var parts = new List<string>();

        // 09 SB-2: tell the owner exactly which branch is kept and which is deleted, before anything
        // about worktree or commit state, since this changes what "safe to remove" means below.
        if (repo.IsOffFeatureBranch)
        {
            var current = string.IsNullOrWhiteSpace(repo.CheckedOutBranch) ? "a detached commit" : $"`{repo.CheckedOutBranch}`";
            parts.Add(
                $"This repository is on {current}, not on its Feature branch `{repo.FeatureBranchName}`. " +
                $"{current} is kept; `{repo.FeatureBranchName}` is deleted.");
        }
        else if (repo.FeatureBranchName is not null && repo.FeatureBranchExists == false)
        {
            parts.Add("The Feature branch is already gone; nothing to delete.");
        }

        if (repo.WorktreeStatusUnknown)
        {
            // The trailing Warning check below already adds the explanation for this repository.
        }
        else if (!repo.WorktreeExists)
        {
            parts.Add("Folder is already missing on disk");
        }
        else if (!repo.LiveStatusEstablished)
        {
            parts.Add("Live worktree status unavailable");
        }
        else
        {
            if (repo.HasConflicts)
                parts.Add("Has unresolved conflicts");
            if (repo.HasStagedChanges)
                parts.Add("Has staged changes");
            if (repo.HasUncommittedChanges)
                parts.Add("Has uncommitted changes");
        }

        if (repo.OutgoingCommits is int outgoing && outgoing > 0)
        {
            parts.Add($"{outgoing} commit{(outgoing == 1 ? "" : "s")} not pushed to the remote");
        }

        if (repo.PullRequestNumber is int prNumber)
        {
            var state = repo.PullRequestMerged == true ? "merged"
                : string.Equals(repo.PullRequestState, "closed", StringComparison.OrdinalIgnoreCase) ? "closed without merging"
                : "still open";
            parts.Add($"Pull request #{prNumber} is {state}");
        }
        else if (repo.HasUpstream)
        {
            parts.Add(NoPullRequestStatusMessage);
        }

        if (!string.IsNullOrEmpty(repo.Warning))
        {
            parts.Add(repo.Warning);
        }

        if (parts.Count == 0)
        {
            parts.Add(NothingPendingStatusMessage);
        }

        return string.Join(" · ", parts);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible || FeatureContextId is null)
            return;

        // Fire-and-forget: title subtitle only, never blocks or fails the removal flow itself.
        if (_featureNameLoadedFor != FeatureContextId.Value.Value)
            _ = LoadFeatureNameAsync(FeatureContextId.Value);

        // After a successful remove the Feature context is gone. Never re-analyze while showing the
        // warnings report (or while the structural overlay is covering the page) - that would surface
        // "WorkspaceFeatureContext N was not found" next to the removal outcome.
        if (_removing || _report is not null)
            return;

        // Page already ran analyze under LoadingOverlay; show that plan immediately (no in-dialog check).
        if (InitialPlan is not null
            && _appliedInitialPlanFor != FeatureContextId.Value.Value)
        {
            ApplyPlan(InitialPlan);
            _appliedInitialPlanFor = FeatureContextId.Value.Value;
            return;
        }

        if (_analyzedFor == FeatureContextId.Value.Value && _plan is not null)
            return;

        // Fallback when opened without a preloaded plan (should not happen from Repositories).
        _analyzing = true;
        _error = null;
        try
        {
            await RefreshPlanAsync();
        }
        finally
        {
            _analyzing = false;
        }
    }

    /// <summary>
    /// Loads the Feature name for the title subtitle, same source as <see cref="FeatureStatusPanel"/>.
    /// Purely cosmetic: failures are swallowed so a transient lookup error never blocks or interrupts
    /// the removal flow.
    /// </summary>
    private async Task LoadFeatureNameAsync(WorkspaceFeatureContextId contextId)
    {
        _featureNameLoadedFor = contextId.Value;
        try
        {
            var status = await FeatureOperations.GetFeatureStatusAsync(contextId);
            if (FeatureContextId?.Value != contextId.Value)
                return;
            _featureName = status?.FeatureName;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load Feature name for Remove Feature dialog title");
        }
    }

    private void ApplyPlan(RemoveFeaturePlan plan)
    {
        _plan = plan;
        _analyzedFor = FeatureContextId?.Value;
        _report = null;
        _blockers = null;
        _allowDiscard = false;
        _allowForce = false;
        _allowUnlock = false;
        _deleteLocalBranches = plan.Repositories.Any(HasLocalFeatureBranchToDelete);
        _deleteRemoteBranches = plan.Repositories.Any(HasRemoteFeatureBranchToDelete);
        _error = plan.Success ? null : plan.Error;
    }

    /// <summary>
    /// Reloads the removal plan. Used on open and after a failed remove so a locked folder's
    /// stored error shows in the open dialog without closing it. Does not clear <see cref="_error"/>.
    /// </summary>
    private async Task RefreshPlanAsync()
    {
        if (FeatureContextId is null)
            return;

        try
        {
            _plan = await FeatureOperations.AnalyzeRemoveFeatureAsync(FeatureContextId.Value);
            _analyzedFor = FeatureContextId.Value.Value;
            if (_plan.Success)
            {
                _deleteLocalBranches = _plan.Repositories.Any(HasLocalFeatureBranchToDelete);
                _deleteRemoteBranches = _plan.Repositories.Any(HasRemoteFeatureBranchToDelete);
            }
            if (!_plan.Success && string.IsNullOrEmpty(_error))
                _error = _plan.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AnalyzeRemoveFeature failed");
            if (string.IsNullOrEmpty(_error))
                _error = ex.Message;
        }
    }

    private async Task RemoveAsync()
    {
        if (FeatureContextId is null)
            return;
        _removing = true;
        _error = null;
        _report = null;
        _blockers = null;
        try
        {
            var result = await FeatureOperations.RemoveFeatureAsync(
                FeatureContextId.Value,
                new RemoveFeatureOptions
                {
                    AllowDiscardUncommitted = _allowDiscard,
                    AllowForceDeleteLocalBranches = _allowForce,
                    AllowUnlockWorktrees = _allowUnlock,
                    DeleteLocalBranches = _deleteLocalBranches,
                    DeleteRemoteBranches = _deleteRemoteBranches,
                    AnalyzedPlan = _plan
                });
            if (!result.Success)
            {
                // Hard failure: error only - never pair with a green/success report. When the Worker found the
                // processes holding a worktree folder, the dialog names them and offers Retry / Refresh blockers.
                _report = null;
                _error = result.Error ?? "Remove Feature failed.";
                _blockers = result.RemoveFeatureBlockers is { Count: > 0 } blockers ? blockers : null;
                await RefreshPlanAsync();
                return;
            }

            var report = result.RemoveFeatureReport ?? [];
            if (!HasReportWarnings(report))
            {
                // Clean success: close immediately; page shows a toast via OnRemoved.
                ResetDialogState();
                await OnRemoved.InvokeAsync();
                return;
            }

            // Success with warnings the user must acknowledge - warnings dialog only (no success headline).
            _plan = null;
            _analyzedFor = null;
            _error = null;
            _report = report;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Remove Feature failed");
            _report = null;
            _error = ex.Message;
        }
        finally
        {
            _removing = false;
        }
    }

    /// <summary>Looks the blockers up again: for the failed Remove's worktrees, or for a removed Feature's leftover folders.</summary>
    private async Task RefreshBlockersAsync()
    {
        if (BlockerActionBusy)
            return;

        _refreshingBlockers = true;
        try
        {
            if (_report is not null)
            {
                var targets = LeftoverBlockerTargets(_report);
                if (targets.Count > 0)
                    _report = ApplyRefreshedBlockers(_report, await FeatureOperations.InspectRemoveFeatureBlockersAsync(targets));
            }
            else if (_blockers is { Count: > 0 })
            {
                _blockers = await FeatureOperations.InspectRemoveFeatureBlockersAsync(_blockers);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing Remove Feature blockers failed");
        }
        finally
        {
            _refreshingBlockers = false;
        }
    }

    /// <summary>Retries deleting a removed Feature's leftover files; closes the dialog when nothing is left to report.</summary>
    private async Task RetryLeftoversAsync()
    {
        if (_report is null || BlockerActionBusy)
            return;

        _retryingLeftovers = true;
        try
        {
            _report = await FeatureOperations.RetryRemoveFeatureResidueAsync(_report);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Retrying Remove Feature leftover cleanup failed");
        }
        finally
        {
            _retryingLeftovers = false;
        }

        if (!HasReportWarnings(_report))
            await Done();
    }

    /// <summary>Leftover folders a refresh can inspect: report entries that still have files and a retry target.</summary>
    internal static IReadOnlyList<RemoveFeatureRepositoryBlockers> LeftoverBlockerTargets(IReadOnlyList<RemoveFeatureRepositoryReport> report) =>
        report
            .Where(r => r.ResidueRemaining && r.ResidueTarget is not null)
            .Select(r => new RemoveFeatureRepositoryBlockers(
                r.WorkspaceRepositoryId,
                r.RepositoryName,
                r.ResidueTarget!.WorktreePath,
                r.BlockingProcesses ?? [],
                r.BlockersMayBeIncomplete,
                r.BlockersDiagnostic))
            .ToList();

    /// <summary>
    /// Folds refreshed blockers back into the report. A leftover folder that no longer exists is no longer residue, so
    /// it drops out of the warnings (and Retry is no longer offered for it).
    /// </summary>
    internal static IReadOnlyList<RemoveFeatureRepositoryReport> ApplyRefreshedBlockers(
        IReadOnlyList<RemoveFeatureRepositoryReport> report,
        IReadOnlyList<RemoveFeatureRepositoryBlockers> refreshed)
    {
        var byRepository = refreshed.ToDictionary(b => b.WorkspaceRepositoryId);
        return report
            .Select(r =>
            {
                if (!byRepository.TryGetValue(r.WorkspaceRepositoryId, out var b))
                    return r;
                if (!b.PathExists)
                {
                    return r with
                    {
                        ResidueRemaining = false,
                        ResidueFileCount = 0,
                        ResidueSampleFiles = null,
                        ResidueMessage = null,
                        BlockingProcesses = null,
                        BlockersMayBeIncomplete = false,
                        BlockersDiagnostic = null,
                        ResidueTarget = null,
                    };
                }

                return r with
                {
                    BlockingProcesses = b.Processes,
                    BlockersMayBeIncomplete = b.MayBeIncomplete,
                    BlockersDiagnostic = b.Diagnostic,
                };
            })
            .ToList();
    }

    private void ResetDialogState()
    {
        _plan = null;
        _blockers = null;
        _refreshingBlockers = false;
        _retryingLeftovers = false;
        _analyzedFor = null;
        _appliedInitialPlanFor = null;
        _featureName = null;
        _featureNameLoadedFor = null;
        _report = null;
        _allowDiscard = false;
        _allowForce = false;
        _allowUnlock = false;
        _deleteLocalBranches = true;
        _deleteRemoteBranches = false;
        _error = null;
    }

    private Task Cancel()
    {
        ResetDialogState();
        return OnCancel.InvokeAsync();
    }

    private async Task Done()
    {
        ResetDialogState();
        await OnRemoved.InvokeAsync();
    }

    /// <summary>Esc closes/acknowledges (while not analyzing/removing); Ctrl/Cmd+Enter is handled globally by modal-default-action.js via data-default-action.</summary>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _analyzing)
            return;

        if (_report is not null)
            await Done();
        else
            await Cancel();
    }
}
