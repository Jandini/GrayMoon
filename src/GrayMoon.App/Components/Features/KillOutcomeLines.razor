@* Result of the last "Kill" in the Remove Feature dialog: how many programs were ended, or why ending them failed. *@

@if (!string.IsNullOrEmpty(Summary))
{
    <p class="text-muted small mb-1">@Summary</p>
}
@if (!string.IsNullOrEmpty(Error))
{
    <div class="gm-callout gm-callout--error mb-2" role="alert">@Error</div>
}

@code {
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string? Error { get; set; }
}
