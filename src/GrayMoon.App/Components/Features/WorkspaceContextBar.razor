@using GrayMoon.Application.Features
@using GrayMoon.App.Components.Features

<div class="workspace-context-bar d-flex gap-2 align-items-center flex-wrap">
    @if (WorkspaceId > 0)
    {
        <WorkspaceFeatureSelector WorkspaceId="WorkspaceId"
                                 SelectedContextId="SelectedContextId"
                                 SelectedContextIdChanged="SelectedContextIdChanged"
                                 OnRequestCreateFeature="OnRequestCreateFeature"
                                 Disabled="Disabled" />
    }
    @ChildContent
</div>

@code {
    [Parameter] public int WorkspaceId { get; set; }
    [Parameter] public WorkspaceFeatureContextId? SelectedContextId { get; set; }
    [Parameter] public EventCallback<WorkspaceFeatureContextId> SelectedContextIdChanged { get; set; }
    [Parameter] public EventCallback<string> OnRequestCreateFeature { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
