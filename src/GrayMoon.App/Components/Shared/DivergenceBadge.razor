@using GrayMoon.App.Services
@using Microsoft.AspNetCore.Components.Web

<div class="divergence-container">
    <span class="divergence-inner">
        @if (IsOnTag)
        {
            <span>&nbsp;</span>
        }
        else if (string.IsNullOrWhiteSpace(BranchName) || (!DefaultBehind.HasValue && !DefaultAhead.HasValue))
        {
            @("-")
        }
        else
        {
            var behind = DefaultBehind ?? 0;
            var ahead = DefaultAhead ?? 0;
            var hasRepoUrl = !string.IsNullOrWhiteSpace(RepositoryUrl);
            var hasDefaultBranch = !string.IsNullOrWhiteSpace(DefaultBranchName);
            // On the default branch, behind vs origin/default is the same as incoming vs upstream.
            // Pull already handles that; "update from default" would merge a branch into itself.
            var isOnDefault = hasDefaultBranch
                && !string.IsNullOrWhiteSpace(BranchName)
                && string.Equals(BranchName, DefaultBranchName, StringComparison.OrdinalIgnoreCase);
            string? aheadUrl = null;
            string? behindUrl = null;
            if (hasRepoUrl && hasDefaultBranch && !string.IsNullOrWhiteSpace(BranchName) && !isOnDefault)
            {
                var encDefault = Uri.EscapeDataString(DefaultBranchName!);
                var encBranch = Uri.EscapeDataString(BranchName);
                aheadUrl = $"{RepositoryUrl}/compare/{encDefault}...{encBranch}";
                behindUrl = $"{RepositoryUrl}/compare/{encBranch}...{encDefault}";
            }
            var aheadTitle = hasDefaultBranch
                ? (ahead == 1
                    ? $"This branch is 1 commit ahead of {DefaultBranchName}"
                    : $"This branch is {ahead} commits ahead of {DefaultBranchName}")
                : (ahead == 1
                    ? "This branch is 1 commit ahead of the default branch"
                    : $"This branch is {ahead} commits ahead of the default branch");
            var behindTitle = hasDefaultBranch
                ? (behind == 1
                    ? $"This branch is 1 commit behind {DefaultBranchName}"
                    : $"This branch is {behind} commits behind {DefaultBranchName}")
                : (behind == 1
                    ? "This branch is 1 commit behind the default branch"
                    : $"This branch is {behind} commits behind the default branch");

            @if (behind > 0 && !isOnDefault && OnUpdateBranchClick.HasDelegate)
            {
                <button type="button" class="divergence-link divergence-link-behind divergence-link-behind--actionable" title="@behindTitle" @onclick="OnUpdateBranchClick">@behind</button>
            }
            else if (!string.IsNullOrWhiteSpace(behindUrl))
            {
                <a href="@behindUrl" target="_blank" rel="noopener noreferrer" class="divergence-link divergence-link-behind" title="@behindTitle">@behind</a>
            }
            else
            {
                <span class="divergence-link divergence-link-behind" title="@behindTitle">@behind</span>
            }
            <span class="divergence-separator"> | </span>
            if (!string.IsNullOrWhiteSpace(aheadUrl))
            {
                <a href="@aheadUrl" target="_blank" rel="noopener noreferrer" class="divergence-link divergence-link-ahead" title="@aheadTitle">@ahead</a>
            }
            else
            {
                <span class="divergence-link divergence-link-ahead" title="@aheadTitle">@ahead</span>
            }
        }
    </span>
</div>

@code {
    [Parameter] public int? DefaultBehind { get; set; }
    [Parameter] public int? DefaultAhead { get; set; }
    [Parameter] public string? BranchName { get; set; }
    [Parameter] public string? RepositoryUrl { get; set; }
    [Parameter] public string? DefaultBranchName { get; set; }
    /// <summary>True when the repository is checked out at a tag (detached HEAD); divergence vs. default branch is not meaningful, render blank.</summary>
    [Parameter] public bool IsOnTag { get; set; }
    /// <summary>When set, the behind count on a non-default branch renders as an actionable red button that invokes this callback instead of opening GitHub. Ignored when the current branch is the default branch - that case is a pull, not an update-from-default.</summary>
    [Parameter] public EventCallback OnUpdateBranchClick { get; set; }
}
