@using GrayMoon.App.Services
@using Microsoft.AspNetCore.Components.Web

<div class="divergence-container">
    <span class="divergence-inner">
        @if (IsOnTag)
        {
            <span>&nbsp;</span>
        }
        else if (string.IsNullOrWhiteSpace(BranchName) || (!DefaultBehind.HasValue && !DefaultAhead.HasValue))
        {
            <span>&nbsp;</span>
        }
        else
        {
            var behind = DefaultBehind ?? 0;
            var ahead = DefaultAhead ?? 0;
            var hasRepoUrl = !string.IsNullOrWhiteSpace(RepositoryUrl);
            var comparisonBase = !string.IsNullOrWhiteSpace(ComparisonBaseBranchName)
                ? ComparisonBaseBranchName
                : DefaultBranchName;
            var hasComparisonBase = !string.IsNullOrWhiteSpace(comparisonBase);
            // On the comparison base branch, behind vs origin/base is the same as incoming vs upstream.
            // Pull already handles that; "update from base" would merge a branch into itself.
            var isOnComparisonBase = hasComparisonBase
                && !string.IsNullOrWhiteSpace(BranchName)
                && string.Equals(BranchName, comparisonBase, StringComparison.OrdinalIgnoreCase);
            string? aheadUrl = null;
            string? behindUrl = null;
            if (hasRepoUrl && hasComparisonBase && !string.IsNullOrWhiteSpace(BranchName) && !isOnComparisonBase)
            {
                var encBase = Uri.EscapeDataString(comparisonBase!);
                var encBranch = Uri.EscapeDataString(BranchName);
                aheadUrl = $"{RepositoryUrl}/compare/{encBase}...{encBranch}";
                behindUrl = $"{RepositoryUrl}/compare/{encBranch}...{encBase}";
            }
            var aheadTitle = hasComparisonBase
                ? (ahead == 1
                    ? $"This branch is 1 commit ahead of {comparisonBase}"
                    : $"This branch is {ahead} commits ahead of {comparisonBase}")
                : (ahead == 1
                    ? "This branch is 1 commit ahead of the default branch"
                    : $"This branch is {ahead} commits ahead of the default branch");
            var behindTitle = hasComparisonBase
                ? (behind == 1
                    ? $"This branch is 1 commit behind {comparisonBase}"
                    : $"This branch is {behind} commits behind {comparisonBase}")
                : (behind == 1
                    ? "This branch is 1 commit behind the default branch"
                    : $"This branch is {behind} commits behind the default branch");

            @if (behind > 0 && !isOnComparisonBase && OnUpdateBranchClick.HasDelegate)
            {
                @* Yellow only when an open PR is not mergeable (conflict); otherwise gray but still clickable. *@
                var behindActionClass = IsPrMergeBlocked
                    ? "divergence-link divergence-link-behind divergence-link-behind--actionable divergence-link-behind--conflict"
                    : "divergence-link divergence-link-behind divergence-link-behind--actionable";
                <button type="button" class="@behindActionClass" title="@behindTitle" @onclick="OnUpdateBranchClick">@behind</button>
            }
            else if (!string.IsNullOrWhiteSpace(behindUrl))
            {
                <a href="@behindUrl" target="_blank" rel="noopener noreferrer" class="divergence-link divergence-link-behind" title="@behindTitle">@behind</a>
            }
            else
            {
                <span class="divergence-link divergence-link-behind" title="@behindTitle">@behind</span>
            }
            <span class="divergence-separator"> | </span>
            if (!string.IsNullOrWhiteSpace(aheadUrl))
            {
                <a href="@aheadUrl" target="_blank" rel="noopener noreferrer" class="divergence-link divergence-link-ahead" title="@aheadTitle">@ahead</a>
            }
            else
            {
                <span class="divergence-link divergence-link-ahead" title="@aheadTitle">@ahead</span>
            }
        }
    </span>
</div>

@code {
    [Parameter] public int? DefaultBehind { get; set; }
    [Parameter] public int? DefaultAhead { get; set; }
    [Parameter] public string? BranchName { get; set; }
    [Parameter] public string? RepositoryUrl { get; set; }
    [Parameter] public string? DefaultBranchName { get; set; }
    /// <summary>
    /// When set (Feature parent / PR base), titles and compare links use this instead of
    /// <see cref="DefaultBranchName"/>. Counts are expected to already be vs this base.
    /// </summary>
    [Parameter] public string? ComparisonBaseBranchName { get; set; }
    /// <summary>True when the repository is checked out at a tag (detached HEAD); divergence vs. default branch is not meaningful, render blank.</summary>
    [Parameter] public bool IsOnTag { get; set; }
    /// <summary>When set, the behind count on a non-base branch renders as an actionable button that invokes this callback instead of opening GitHub. Ignored when the current branch is the comparison base - that case is a pull, not an update-from-base.</summary>
    [Parameter] public EventCallback OnUpdateBranchClick { get; set; }
    /// <summary>
    /// True when there is an open PR that GitHub reports as not mergeable (typically a conflict).
    /// Drives yellow styling on the actionable behind count; otherwise the actionable behind count stays gray.
    /// </summary>
    [Parameter] public bool IsPrMergeBlocked { get; set; }
}
