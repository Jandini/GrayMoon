@implements IDisposable
@inject NavigationManager NavigationManager
@inject WorkspaceGitChangesRouteActivity RouteActivity
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@* No markup - mounted once per circuit (MainLayout.razor) so any /workspaces/{id}/... page keeps
   Git Changes activity (and Worker watchers) warm without page-level activation leases.
   MainLayout itself is rendered statically, so this component must be an interactive island
   (prerender: false): in the static request scope the lease was gained and released within one
   request and an open page never held it. As an island it lives as long as the circuit. *@

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        SyncFromCurrentUri();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SyncFromCurrentUri();
    }

    private void SyncFromCurrentUri()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        RouteActivity.Sync(WorkspaceRouteParser.TryGetWorkspaceId(relativePath));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        // Release the lease when this component goes away first. If the circuit scope already
        // disposed RouteActivity, Sync is a no-op because that Dispose released the lease.
        RouteActivity.Sync(null);
    }
}
