@using GrayMoon.App.Models
@using Microsoft.AspNetCore.Components.Web

@* PR column badge: uncommitted count (red, highest priority), none (dark gray), create (yellow, black text), #number (green), merged (purple), closed (red). Default "none" until data loads. *@
@if (ShowsUncommittedChangesBadge(UncommittedChangedFileCount))
{
    var filesWord = UncommittedChangedFileCount == 1 ? "file" : "files";
    <a href="@ChangesUrl"
       class="badge pr-badge pr-badge-uncommitted"
       title="@($"{UncommittedChangedFileCount} uncommitted {filesWord}")"
       @onclick:stopPropagation>@UncommittedChangedFileCount</a>
}
else if (IsOnTag && HasNewerTag)
{
    <span class="badge pr-badge pr-badge-create"
          role="button"
          tabindex="0"
          title="Newer tag available - click to upgrade"
          style="cursor: pointer;"
          @onclick="HandleUpgradeClick"
          @onclick:preventDefault
          @onclick:stopPropagation>upgrade</span>
}
else if (IsOnTag)
{
    <span>&nbsp;</span>
}
else if (PullRequest != null && (PullRequest.IsMerged || PullRequest.IsClosed || string.Equals(PullRequest.State, "open", StringComparison.OrdinalIgnoreCase)))
{
    <PullRequestChip Pr="@PullRequest"
                     ParentRepositoryName="@ParentRepositoryName"
                     OnMergeClick="@OnMergeClick" />
    @if (PullRequest.ParentPullRequest is { } upstreamPr)
    {
        @* Fork and upstream both have a pull request: the upstream one follows, link-only. *@
        <span class="pr-upstream-chip">
            <PullRequestChip Pr="@upstreamPr"
                             ParentRepositoryName="@ParentRepositoryName" />
        </span>
    }
}
else if (ShowsCreateBadge(IsOnTag, IsPrVerified, PullRequest, DefaultBranchAheadCommits, HeadCommit, FeatureBaseCommitSha))
{
    <span class="badge pr-badge pr-badge-create"
          role="button"
          tabindex="0"
          title="Create pull request"
          style="cursor: pointer;"
          @onclick="HandleCreateClick"
          @onclick:preventDefault
          @onclick:stopPropagation>create</span>
}
else
{
    <span class="badge pr-badge pr-badge-none" title="No pull request">none</span>
}

@code {
    [Parameter] public PullRequestInfo? PullRequest { get; set; }
    /// <summary>Name (<c>owner/repo</c>) of the upstream repository for a fork, used in the titles of upstream pull request chips.</summary>
    [Parameter] public string? ParentRepositoryName { get; set; }
    [Parameter] public int UncommittedChangedFileCount { get; set; }
    /// <summary>Git Changes page URL. Used by the red uncommitted-count badge.</summary>
    [Parameter] public string? ChangesUrl { get; set; }
    [Parameter] public int? DefaultBranchAheadCommits { get; set; }
    /// <summary>HEAD SHA when viewing a Feature - compared to <see cref="FeatureBaseCommitSha"/> for Create PR.</summary>
    [Parameter] public string? HeadCommit { get; set; }
    /// <summary>Feature creation tip SHA; when set, Create PR uses HEAD vs this tip instead of ahead-of-default.</summary>
    [Parameter] public string? FeatureBaseCommitSha { get; set; }
    /// <summary>Deprecated. The create badge now invokes <see cref="OnCreateClick"/> instead of navigating to a URL.</summary>
    [Parameter] public string? CreatePrUrl { get; set; }
    /// <summary>Raised when the user clicks the yellow "create" badge.</summary>
    [Parameter] public EventCallback OnCreateClick { get; set; }
    /// <summary>When false, never show "create"; show "none" until PR state has been verified via API.</summary>
    [Parameter] public bool IsPrVerified { get; set; }
    /// <summary>True when the repository is checked out at a tag (detached HEAD); PRs require a branch, so render blank.</summary>
    [Parameter] public bool IsOnTag { get; set; }
    /// <summary>True when the repo is on a tag and at least one newer tag exists. Shows the yellow "upgrade" badge.</summary>
    [Parameter] public bool HasNewerTag { get; set; }
    /// <summary>Raised when the user clicks the yellow "upgrade" badge.</summary>
    [Parameter] public EventCallback OnUpgradeClick { get; set; }
    /// <summary>Raised with the PR number when the user clicks the "merge" segment of an open PR's chip.</summary>
    [Parameter] public EventCallback<int> OnMergeClick { get; set; }

    /// <summary>True when the red uncommitted-count badge is shown: any unique persisted uncommitted path.</summary>
    internal static bool ShowsUncommittedChangesBadge(int uncommittedChangedFileCount) =>
        uncommittedChangedFileCount > 0;

    /// <summary>
    /// True when the yellow "create" badge is shown: PR state is verified, no PR already exists
    /// (open, merged, or closed), and the branch is ahead of its comparison base.
    /// Workspace: ahead of the repository default branch.
    /// Feature: ahead of the Feature parent / PR-base branch (same <paramref name="defaultBranchAheadCommits"/>
    /// field; Feature sync stores counts vs parent, not vs main).
    /// </summary>
    internal static bool ShowsCreateBadge(
        bool isOnTag,
        bool isPrVerified,
        PullRequestInfo? pullRequest,
        int? defaultBranchAheadCommits,
        string? headCommit = null,
        string? featureBaseCommitSha = null)
    {
        if (isOnTag)
            return false;
        if (!isPrVerified)
            return false;
        if (pullRequest is { IsMerged: true })
            return false;
        if (pullRequest is { IsClosed: true })
            return false;
        if (pullRequest != null && string.Equals(pullRequest.State, "open", StringComparison.OrdinalIgnoreCase))
            return false;

        // Primary signal: ahead of comparison base (parent on Feature, default on Workspace).
        if ((defaultBranchAheadCommits ?? 0) > 0)
            return true;

        // Fallback when ahead counts are missing but Feature HEAD has moved since create
        // (e.g. commit hook has not refreshed counts yet).
        if (!string.IsNullOrWhiteSpace(featureBaseCommitSha)
            && !string.IsNullOrWhiteSpace(headCommit)
            && !string.Equals(headCommit.Trim(), featureBaseCommitSha.Trim(), StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private async Task HandleCreateClick()
    {
        if (OnCreateClick.HasDelegate)
            await OnCreateClick.InvokeAsync();
    }

    private async Task HandleUpgradeClick()
    {
        if (OnUpgradeClick.HasDelegate)
            await OnUpgradeClick.InvokeAsync();
    }
}
