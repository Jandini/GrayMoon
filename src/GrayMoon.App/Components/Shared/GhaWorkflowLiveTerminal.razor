@using GrayMoon.App.Services
@using GrayMoon.App.Models
@inject GhaWorkflowLiveFeedService GhaWorkflowLiveFeedService
@inject LoadingOverlayUiSettingsService OverlayUiSettings
@inject ILogger<GhaWorkflowLiveTerminal> Logger
@implements IAsyncDisposable

@if (RunId > 0 && !string.IsNullOrWhiteSpace(ConnectorName) && !string.IsNullOrWhiteSpace(Owner) && !string.IsNullOrWhiteSpace(RepositoryName))
{
    var schemeClass = OverlayUiSettings.TerminalColorScheme == TerminalColorScheme.Yellow
        ? "loading-overlay-terminal--scheme-yellow"
        : "";
    <div class="actions-gha-terminal">
        <div class="actions-gha-terminal__wrap">
            <div class="loading-overlay-terminal @schemeClass actions-gha-terminal__terminal">
                <div class="actions-gha-terminal__caption" title="@_boardCaption">
                    <span class="actions-gha-terminal__caption-main">
                        <span class="actions-gha-terminal__caption-prefix">▶</span><span class="actions-gha-terminal__caption-text">@_boardCaption</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_stepProgress))
                    {
                        <span class="actions-gha-terminal__caption-steps">@_stepProgress</span>
                    }
                    <div class="actions-gha-terminal__progress" style="width:@(_progressDisplayPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
                <div class="loading-overlay-terminal__inner actions-gha-terminal__scroll" aria-live="polite">
                    @for (var i = 0; i < BodyLineCount; i++)
                    {
                        var line = i == _spinnerBoardIdx
                            ? _boardSlots[i] + _spinnerText
                            : _boardSlots[i];
                        var timing = _timingSlots[i];
                        <p class="loading-overlay-terminal__line loading-overlay-terminal__line--out actions-gha-terminal__line">
                            @if (string.IsNullOrWhiteSpace(line))
                            {
                                <span class="loading-overlay-terminal__text">&nbsp;</span>
                            }
                            else
                            {
                                <span class="loading-overlay-terminal__prefix">[step]</span>
                                <span class="loading-overlay-terminal__text actions-gha-terminal__step-text">@line</span>
                                @if (!string.IsNullOrWhiteSpace(timing))
                                {
                                    <span class="actions-gha-terminal__step-timing@(i == _spinnerBoardIdx ? " actions-gha-terminal__step-timing--active" : "")">@timing</span>
                                }
                            }
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string ConnectorName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Owner { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RepositoryName { get; set; } = string.Empty;
    [Parameter] public long RunId { get; set; }
    [Parameter] public string? WorkflowDisplayName { get; set; }

    private readonly string[] _boardSlots  = new string[BodyLineCount];
    private readonly string[] _timingSlots = new string[BodyLineCount];
    private const string WaitingCaption = "Steps · Waiting…";
    private string _boardCaption = WaitingCaption;
    private string? _stepProgress;

    // Spinner - runs on its own 200ms loop, independent of the API poll
    private static readonly char[] SpinnerFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧'];
    private int _spinnerFrame;
    private string? _spinnerStepKey;
    private int _spinnerBoardIdx = -1;  // board slot index of current in-progress step (-1 = none)
    private string _spinnerText = "";   // "  ...⠙" suffix appended to the in-progress slot

    private GhaWorkflowLiveFeedState? _feedState;
    // The run the loops were started for; a different run on the same instance restarts them.
    private LiveTerminalTarget? _polledTarget;
    private CancellationTokenSource? _cts;
    private Task? _pollTask;
    private Task? _spinnerTask;
    private Task? _progressTask;

    private const int BodyLineCount = 8;
    private const int SpinnerFrameMs = 200; // 8 frames × 200ms = 1.6s per revolution

    // Top-border progress bar: creeps toward the current step's target percentage rather than
    // jumping straight to it, then stops and waits until the step (or the target) advances.
    // Movement speeds up when it's far behind the target (catching up after a step completed)
    // and eases back into the slow constant crawl as it closes the gap.
    private double _progressTargetPct;
    private double _progressDisplayPct;
    private bool _progressInitialized;
    private const int ProgressTickMs = 150;
    private const double ProgressSpeedPctPerSec = 1.5;   // slow crawl floor
    private const double ProgressCatchUpFraction = 0.12; // fraction of remaining gap closed per tick when catching up

    protected override void OnInitialized()
    {
        OverlayUiSettings.Changed += OnOverlayUiSettingsChanged;
    }

    private void OnOverlayUiSettingsChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    protected override Task OnParametersSetAsync()
    {
        var target = new LiveTerminalTarget(ConnectorName, Owner, RepositoryName, RunId);
        if (!LiveTerminalPolling.ShouldRestart(_polledTarget, target))
            return Task.CompletedTask;

        // The run (or repository) changed under the same component instance: stop the loops of the old run and
        // start over, or the terminal keeps showing the steps of a run that is no longer the one on screen.
        StopLoops();
        _polledTarget = target.IsPollable ? target : null;
        if (!target.IsPollable)
            return Task.CompletedTask;

        _feedState = new GhaWorkflowLiveFeedState
        {
            ConnectorName = ConnectorName,
            Owner = Owner,
            RepositoryName = RepositoryName,
            RunId = RunId,
            WorkflowDisplayName = WorkflowDisplayName
        };
        _boardCaption = WaitingCaption;
        _stepProgress = null;
        _progressInitialized = false;
        _progressTargetPct = 0;
        _progressDisplayPct = 0;
        _spinnerStepKey = null;
        UpdateBoard();

        _cts = new CancellationTokenSource();
        _pollTask     = PollLoopAsync(_feedState, _cts.Token);
        _spinnerTask  = SpinnerLoopAsync(_cts.Token);
        _progressTask = ProgressLoopAsync(_cts.Token);
        return Task.CompletedTask;
    }

    /// <summary>Cancels the current loops. They end on their own; nothing here waits for them.</summary>
    private void StopLoops()
    {
        var cts = _cts;
        _cts = null;
        _pollTask = null;
        _spinnerTask = null;
        _progressTask = null;
        if (cts == null) return;
        try { cts.Cancel(); }
        catch (ObjectDisposedException) { }
        cts.Dispose();
    }

    private async Task PollLoopAsync(GhaWorkflowLiveFeedState feedState, CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            int delayMs;
            try
            {
                delayMs = await PollOnceAsync(feedState, cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return; // disposed, or restarted for another run
            }
            catch (Exception ex)
            {
                // One failed poll (network, GitHub 5xx, a request timeout) is "not yet": log it and ask again.
                // Ending the loop here froze the terminal on its last frame until the page was reopened.
                Logger.LogDebug(ex, "Live workflow poll failed for run {RunId} of {Owner}/{Repository}",
                    feedState.RunId, feedState.Owner, feedState.RepositoryName);
                delayMs = LiveTerminalPolling.RetryDelayAfterFailureMs;
            }

            try
            {
                await Task.Delay(delayMs, cancellationToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    private async Task SpinnerLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(SpinnerFrameMs, cancellationToken);
                await InvokeAsync(() =>
                {
                    if (_spinnerBoardIdx < 0)
                        return;

                    _spinnerFrame = (_spinnerFrame + 1) % SpinnerFrames.Length;
                    _spinnerText = $"  {SpinnerFrames[_spinnerFrame]}";
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* disposed */ }
    }

    private async Task<int> PollOnceAsync(GhaWorkflowLiveFeedState feedState, CancellationToken cancellationToken)
    {
        var update = await GhaWorkflowLiveFeedService.PollOnceAsync(feedState, cancellationToken);

        // All state mutations run on the Blazor circuit thread to stay consistent with the spinner loop
        await InvokeAsync(() =>
        {
            // A poll that finished after the run changed belongs to the old run: do not paint it.
            if (cancellationToken.IsCancellationRequested || !ReferenceEquals(_feedState, feedState))
                return;

            if (!string.Equals(_boardCaption, update.Caption, StringComparison.Ordinal)
                || !string.Equals(_stepProgress, update.StepProgress, StringComparison.Ordinal))
            {
                _boardCaption = update.Caption;
                _stepProgress = update.StepProgress;
            }
            UpdateBoard();
            UpdateProgressTarget();
            StateHasChanged();
        });

        return update.DelayMs;
    }

    // Recomputes the top-border progress bar from completed steps / total steps so 100% is reached
    // only when the last step has finished, not while it is still in_progress (StepIndex/StepCount
    // both equal the last step in either case, so they cannot tell those two states apart).
    // A drop below the current display (new job's steps replacing the previous job's) snaps immediately
    // instead of animating backwards; forward movement is left to ProgressLoopAsync's slow crawl.
    // The very first update after this component instance is created snaps the display straight to the
    // current percentage instead of crawling up from zero, so a page refresh or grid re-render never
    // shows the bar "restarting from the beginning" - it always resumes from the true current position.
    private void UpdateProgressTarget()
    {
        var steps = _feedState?.ActiveJob?.Steps;
        var target = 0.0;
        if (steps is { Count: > 0 })
        {
            var completed = 0;
            foreach (var step in steps)
            {
                if (string.Equals(step.Status, "completed", StringComparison.OrdinalIgnoreCase))
                    completed++;
            }

            target = Math.Clamp(100.0 * completed / steps.Count, 0, 100);
        }

        if (!_progressInitialized)
        {
            _progressDisplayPct = target;
            _progressInitialized = true;
        }
        else if (target < _progressDisplayPct)
        {
            _progressDisplayPct = target;
        }

        _progressTargetPct = target;
    }

    private async Task ProgressLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(ProgressTickMs, cancellationToken);
                await InvokeAsync(() =>
                {
                    var gap = _progressTargetPct - _progressDisplayPct;
                    if (gap <= 0)
                        return;

                    var floorStep = ProgressSpeedPctPerSec * (ProgressTickMs / 1000.0);
                    var step = Math.Max(floorStep, gap * ProgressCatchUpFraction);
                    _progressDisplayPct = Math.Min(_progressTargetPct, _progressDisplayPct + step);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* disposed */ }
    }

    private static string FormatDuration(DateTimeOffset? start, DateTimeOffset? end)
    {
        if (start == null || end == null) return "";
        var elapsed = end.Value - start.Value;
        if (elapsed < TimeSpan.Zero) return "";
        if (elapsed.TotalSeconds < 60)
            return elapsed.TotalSeconds < 10
                ? $"{elapsed.TotalSeconds:F1}s"
                : $"{(int)elapsed.TotalSeconds}s";
        return $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds}s";
    }

    private void UpdateBoard()
    {
        var job = _feedState?.ActiveJob;
        var steps = job?.Steps;

        if (job == null || steps == null || steps.Count == 0)
        {
            for (var i = 0; i < BodyLineCount; i++) { _boardSlots[i] = ""; _timingSlots[i] = ""; }
            _spinnerBoardIdx = -1;
            return;
        }

        var activeIdx = steps.FindIndex(s =>
            string.Equals(s.Status, "in_progress", StringComparison.OrdinalIgnoreCase));
        if (activeIdx < 0)
            activeIdx = steps.FindLastIndex(s =>
                string.Equals(s.Status, "completed", StringComparison.OrdinalIgnoreCase));

        var startIdx = 0;
        if (steps.Count > BodyLineCount && activeIdx >= 0)
            startIdx = Math.Max(0, Math.Min(activeIdx - BodyLineCount / 2 + 1, steps.Count - BodyLineCount));

        var newSpinnerIdx = -1;

        for (var i = 0; i < BodyLineCount; i++)
        {
            var si = startIdx + i;
            if (si >= steps.Count)
            {
                _boardSlots[i]  = "";
                _timingSlots[i] = "";
                continue;
            }

            var step = steps[si];
            var isInProgress = step.Status.Equals("in_progress", StringComparison.OrdinalIgnoreCase);
            var isCompleted  = step.Status.Equals("completed",   StringComparison.OrdinalIgnoreCase);

            _timingSlots[i] = isCompleted
                ? FormatDuration(step.StartedAt, step.CompletedAt)
                : isInProgress
                    ? FormatDuration(step.StartedAt, DateTimeOffset.UtcNow)
                    : "";

            if (isInProgress)
            {
                var stepKey = $"{job.Id}:{step.Number}";
                if (!string.Equals(_spinnerStepKey, stepKey, StringComparison.Ordinal))
                {
                    // New step started - reset spinner
                    _spinnerStepKey = stepKey;
                    _spinnerFrame   = 0;
                    _spinnerText    = "";
                }
                newSpinnerIdx  = i;
                _boardSlots[i] = $"▶ {step.Name}";
            }
            else
            {
                _boardSlots[i] = $"{StepIcon(step)} {step.Name}";
            }
        }

        _spinnerBoardIdx = newSpinnerIdx;
    }

    private static string StepIcon(GitHubWorkflowJobStepDto step)
    {
        if (string.Equals(step.Status, "in_progress", StringComparison.OrdinalIgnoreCase))
            return "▶";
        if (string.Equals(step.Status, "completed", StringComparison.OrdinalIgnoreCase))
        {
            return (step.Conclusion ?? "").ToLowerInvariant() switch
            {
                "success"                => "✓",
                "failure" or "cancelled" => "✗",
                "skipped"                => "↩",
                _                        => "·"
            };
        }
        return "○";
    }

    public async ValueTask DisposeAsync()
    {
        OverlayUiSettings.Changed -= OnOverlayUiSettingsChanged;
        var tasks = new[] { _pollTask, _spinnerTask, _progressTask }.Where(t => t != null).Cast<Task>().ToList();
        var cts = _cts;
        _cts = null;
        try
        {
            cts?.Cancel();
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            // Disposal must not throw: a loop that faulted (renderer already gone, a late poll error) is only logged.
            if (ex is not OperationCanceledException)
                Logger.LogDebug(ex, "Live workflow terminal loop ended with an error during dispose");
        }
        finally
        {
            cts?.Dispose();
        }
    }
}
