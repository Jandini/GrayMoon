@using Microsoft.AspNetCore.Components.Web

@if (IsOnTag)
{
    <span>&nbsp;</span>
}
else if (ShowPlaceholder)
{
    <span>&nbsp;</span>
}
else
{
<span class="@CssClass"
      style="@($"background-color: {BgColor}; color: {TextColor};{(Clickable ? " cursor: pointer;" : "")}")"
      @onclick="HandleClick"
      title="@Title">
    @if (NotUpstreamed && X > 0)
    {
        @($"↑{X}")
    }
    else if (NotUpstreamed)
    {
        <span class="commits-badge-icon-up commits-badge-icon-up--white">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
        </span>
    }
    else
    {
        @DisplayText
    }
</span>
}

@code {
    [Parameter] public int RepositoryId { get; set; }
    [Parameter] public int? Outgoing { get; set; }
    [Parameter] public int? Incoming { get; set; }
    [Parameter] public bool? BranchHasUpstream { get; set; }
    [Parameter] public string? BranchName { get; set; }
    [Parameter] public EventCallback OnPushClick { get; set; }
    [Parameter] public EventCallback OnPullClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>True when the repository is checked out at a tag (detached HEAD). Suppresses the "Push to set upstream" UI and renders a placeholder; the row has no branch to push.</summary>
    [Parameter] public bool IsOnTag { get; set; }
    /// <summary>True for a read-only repository: incoming commits can be pulled, outgoing commits are shown but never pushed.</summary>
    [Parameter] public bool PullOnly { get; set; }
    /// <summary>Why outgoing commits are not pushed, when the reason is not a read-only repository (an archived one).</summary>
    [Parameter] public string? PullOnlyTitle { get; set; }

    private int X => Outgoing ?? 0;
    private int Y => BranchHasUpstream == false ? 0 : (Incoming ?? 0);
    private bool NotUpstreamed => !IsOnTag && BranchHasUpstream == false;
    private bool HasCommits => Y > 0 || X > 0;

    /// <summary>
    /// True when incoming or outgoing commit counts are present and commit-sync can act on them.
    /// The no-upstream ("Push to set upstream") state is excluded - that is not commit sync.
    /// </summary>
    internal static bool HasIncomingOrOutgoingCommits(bool isOnTag, bool? branchHasUpstream, int? outgoing, int? incoming)
    {
        if (isOnTag)
            return false;
        if (branchHasUpstream == false)
            return false;
        return (outgoing ?? 0) > 0 || (incoming ?? 0) > 0;
    }

    private bool Clickable => !Disabled && !IsOnTag && (PullOnly ? Y > 0 : (HasCommits || NotUpstreamed));
    private string BgColor => DetermineColors(X, Y, NotUpstreamed).Background;
    private string TextColor => DetermineColors(X, Y, NotUpstreamed).Text;
    private string CssClass => NotUpstreamed && X == 0 ? "badge commits-badge commits-badge-not-upstreamed" : "badge";

    /// <summary>
    /// Badge colors: red for incoming commits, yellow for outgoing commits, green when in sync.
    /// A branch with no upstream and no commits of its own is gray with a white cloud: a push skips it,
    /// so it is information, not a call to act.
    /// </summary>
    internal static (string Background, string Text) DetermineColors(int outgoing, int incoming, bool notUpstreamed)
    {
        if (incoming > 0) return ("#dc3545", "#fff");
        if (outgoing > 0) return ("#ffc107", "#000");
        if (notUpstreamed) return ("#6c757d", "#fff");
        return ("#198754", "#fff");
    }
    private string DisplayText => $"↑{X} ↓{Y}";
    private string Title => PullOnly && Y == 0
        ? PullOnlyTitle ?? "Read only repository. GrayMoon does not push it."
        : NotUpstreamed ? "Push to set upstream" : (Y > 0 ? "Click to pull" : "Click to push");
    private bool ShowPlaceholder => IsOnTag || (!Outgoing.HasValue && !Incoming.HasValue && BranchHasUpstream != false);

    private async Task HandleClick()
    {
        if (!Clickable) return;
        if (Y > 0)
            await OnPullClick.InvokeAsync();
        else if (!PullOnly && (NotUpstreamed || X > 0))
            await OnPushClick.InvokeAsync();
    }
}
