@page "/workspaces"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using GrayMoon.App.Models
@using WorkspaceModel = GrayMoon.App.Models.Workspace
@using GrayMoon.App.Repositories
@using GrayMoon.App.Services.Queries
@using GrayMoon.App.Components.Shared
@using GrayMoon.App.Components.Modals
@using Microsoft.AspNetCore.Components.Web
@using GrayMoon.App.Services
@inject WorkspaceRepository WorkspaceRepository
@inject WorkspaceProjectRepository WorkspaceProjectRepository
@inject WorkspacePendingActionsService PendingActionsService
@inject ConnectorRepository ConnectorRepository
@inject IRepositoryListQueryService RepositoryListQueryService
@inject GitHubRepositoryService RepositoryService
@inject WorkspaceService WorkspaceService
@inject IWorkerBridge WorkerBridge
@inject WorkerConnectionTracker WorkerConnectionTracker
@inject ILogger<Workspaces> Logger
@inject WorkspaceContextNavigationService ContextNavigation
@using GrayMoon.Abstractions.Workspaces
@using GrayMoon.App.Services.Features
@using GrayMoon.App.Services.Workspaces
@using GrayMoon.Application
@using GrayMoon.Application.Features
@inject IWorkspaceFeatureOperations FeatureOperations
@using GrayMoon.App.Services.Ui
@using GrayMoon.App.Services.WorkspaceManifest
@using GrayMoon.Application.WorkspaceManifest
@inject IWorkspaceManifestService ManifestService
@inject IToastService ToastService
@using GrayMoon.App.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject GrayMoon.Application.Workspaces.IWorkspaceRepositoryOperations WorkspaceRepositoryOperations

<PageTitle>Workspaces - GrayMoon</PageTitle>

<div class="container-fluid page-container grid-page">
    <div class="grid-page-header">
        <div class="workspace-repos-header workspace-workspaces-header">
            <div class="workspace-repos-title-row">
                <h2 class="workspace-repos-title">Workspaces</h2>
                <p class="text-muted mb-0 workspace-repos-subtitle workspace-workspaces__subtitle">
                    @if (workspaces != null && workspaces.Count > 0)
                    {
                        var wsSuffix = HasSearchFilter ? " found" : "";
                        var wsCount = HasSearchFilter ? FilteredWorkspaceCount : workspaces.Count;
                        <span>@($"{wsCount} {(wsCount == 1 ? "workspace" : "workspaces")}{wsSuffix}")</span>
                    }
                    else if (workspaces != null)
                    {
                        <span>0 workspaces</span>
                    }
                    else
                    {
                        <span>&nbsp;</span>
                    }
                </p>
                <span class="workspace-repos-title-spacer"></span>
            </div>
            <div class="d-flex gap-2 align-items-center workspace-repos-header-actions">
                <div class="workspace-grid-search-wrapper">
                    <FilterSearchInput @bind-Value="searchTerm"
                                       InputId="workspaces-list-search"
                                       InputAdditionalClass="workspace-grid-search"
                                       Placeholder="Search workspaces…"
                                       Disabled="@(workspaces == null || workspaces.Count == 0)"
                                       OnKeyDown="OnSearchKeyDown"
                                       OnClear="ClearSearchFilter" />
                </div>
                <button class="btn btn-outline-primary text-nowrap flex-shrink-0" @onclick="ShowRestoreModal">
                    Restore from repository
                </button>
                <button class="btn btn-primary flex-shrink-0" @onclick="ShowCreateModalAsync">
                    Add Workspace
                </button>
            </div>
        </div>
        @if (errorMessage != null)
        {
            <div class="gm-callout gm-callout--error" role="alert">@errorMessage</div>
        }
    </div>
    @if (errorMessage == null)
    {
        <div class="grid-page-body">
            <div class="card page-card mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 workspaces-table resizable-columns">
                        <thead class="table-dark">
                            <tr>
                                <th class="col-name">Name</th>
                                <th class="col-path">Path</th>
                                <th class="col-count">Repos</th>
                                <th class="col-count">Projects</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (workspaces == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Loading workspaces...
                                    </td>
                                </tr>
                            }
                            else if (workspaces.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No workspaces found. Add your first workspace to get started.
                                    </td>
                                </tr>
                            }
                            else if (NoWorkspacesMatchSearch)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No workspaces match your search.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var workspace in FilteredWorkspaces)
                                {
                                    <tr>
                                        <td class="col-name">
                                            <div class="d-flex align-items-center">
                                                <button class="btn btn-sm btn-link default-star-button me-2 d-flex align-items-center"
                                                        @onclick="() => ToggleDefaultAsync(workspace.WorkspaceId, workspace.Name)"
                                                        disabled="@isTogglingDefault"
                                                        title="Toggle default workspace">
                                                    @if (workspace.IsDefault)
                                                    {
                                                        <i class="bi bi-star-fill default-star-icon" aria-hidden="true"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star default-star-icon" aria-hidden="true"></i>
                                                    }
                                                </button>
                                                <NavLink class="link-primary text-decoration-none"
                                                         href="@WorkspaceEntryHref(workspace.WorkspaceId)">
                                                    <strong>@workspace.Name</strong>
                                                </NavLink>
                                                @if (workspace.IsDefault)
                                                {
                                                    <span class="badge badge-default ms-2">Default</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="col-path text-muted">@WorkspaceService.GetWorkspacePath(workspace.Name, workspace.RootPath)</td>
                                        <td class="col-count">@workspace.Repositories.Count</td>
                                        <td class="col-count">@workspace.Repositories.Sum(r => r.Projects ?? 0)</td>
                                        <td class="col-actions">
                                            <button class="btn btn-sm btn-outline-primary me-2"
                                                    @onclick="() => ShowEditModalAsync(workspace.WorkspaceId)">
                                                Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary me-2"
                                                    @onclick="() => ShowAddRepositoriesModalAsync(workspace.WorkspaceId)">
                                                Repositories
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary btn-remove"
                                                    @onclick="() => ShowDeleteModal(workspace)">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    }
</div>

<WorkspaceModal IsVisible="@showEditorModal"
               Title="@editorTitle"
               WorkspaceName="@workspaceName"
               WorkspaceNameChanged="@OnWorkspaceNameChangedAsync"
               WorkspacePath="@GetWorkspacePath()"
               DirectoryAlreadyExists="@(editingWorkspaceId == null && directoryExists)"
               ExistingRepositoryCount="@existingRepositoryCount"
               IsNameDisabled="@(editingWorkspaceId != null && editingWorkspaceHasFeatures)"
               NameDisabledHint="@(editingWorkspaceHasFeatures ? "Rename and root changes are not possible while Features exist. Remove Features first." : null)"
               Type="@editorType"
               TypeChanged="value => editorType = value"
               UseGitVersion="@editorUseGitVersion"
               UseGitVersionChanged="value => editorUseGitVersion = value"
               UseGitHubActions="@editorUseGitHubActions"
               UseGitHubActionsChanged="value => editorUseGitHubActions = value"
               IsTypeDisabled="@(editingWorkspaceId != null && editingWorkspaceHasFeatures)"
               TypeDisabledHint="@(editingWorkspaceHasFeatures ? "Rename and root changes are not possible while Features exist. Remove Features first." : null)"
               WorkspaceRepositoryId="@editorWorkspaceRepositoryId"
               WorkspaceRepositoryIdChanged="value => editorWorkspaceRepositoryId = value"
               WorkspaceRepositoryChoices="@editorWorkspaceRepositoryChoices"
               IsWorkspaceRepositoryDisabled="@(editingWorkspaceId != null && editingWorkspaceHasFeatures)"
               WorkspaceRepositoryDisabledHint="@(editingWorkspaceHasFeatures ? WorkspaceRepositoryFeaturesExistMessage : null)"
               IsSaving="@isSaving"
               IsCheckingDirectory="@isLoadingDirectoryInfo"
               ErrorMessage="@editorErrorMessage"
               SaveDisabled="@EditorSaveDisabled"
               OnSave="@SaveWorkspaceAsync"
               OnCancel="@CloseEditorModal" />

<RestoreWorkspaceModal IsVisible="@showRestoreModal"
                        OnCancel="@CloseRestoreModal"
                        OnRestored="@OnWorkspaceRestoredAsync" />

<WorkspaceImportModal IsVisible="@showImportModal"
                      MatchingCount="@importMatchingCount"
                      OnConfirm="@ConfirmImportAsync"
                      OnCancel="@CancelImportAsync" />

<WorkspaceRepositoriesModal IsVisible="@showRepositoriesModal"
                            Title="@($"Select repositories for {repositoriesModalWorkspaceName}")"
                            SelectedRepositoryIds="@selectedRepositoryIds"
                            ExcludedRepositoryIds="@excludedRepositoryIds"
                            HasConnectors="@hasConnectors"
                            IsSaving="@isSavingRepositories"
                            IsFetching="@isPersisting"
                            ErrorMessage="@repositoriesModalErrorMessage"
                            RenameWarnings="@repositoriesModalRenameWarnings"
                            RefreshGeneration="@repositoriesModalRefreshGeneration"
                            OnSave="@SaveRepositoriesAsync"
                            OnCancel="@CloseRepositoriesModal"
                            OnFetchRepositories="@FetchRepositoriesAsync" />

@if (showDeleteModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);"
         @onkeydown="HandleDeleteModalKeyDown"
         @ref="_deleteModalElement">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Remove Workspace</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Remove workspace <strong>@workspaceToDelete?.Name</strong>?</p>
                    <p class="mb-0 text-muted">Only the GrayMoon workspace will be removed. Repositories on disk will stay untouched.</p>
                    @if (deleteBlockedMessage != null)
                    {
                        <div class="alert alert-warning mt-3 mb-0" role="alert">@deleteBlockedMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" data-default-action @onclick="DeleteWorkspaceAsync" disabled="@(isDeleting || deleteBlockedMessage != null)">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Remove
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<LoadingOverlay IsVisible="@isPersisting" Message="@(fetchedRepositoryCount is null || fetchedRepositoryCount == 0 ? "Fetching repositories..." : $"Fetched {fetchedRepositoryCount} {(fetchedRepositoryCount == 1 ? "repository" : "repositories")}")" OnAbort="AbortFetchRepositories" />

@code {
    private List<WorkspaceModel>? workspaces;
    private Dictionary<int, string> workspaceEntryHrefs = new();
    private string searchTerm = string.Empty;
    private int repositoriesModalRefreshGeneration;
    private string? errorMessage;

    private bool HasSearchFilter => !string.IsNullOrWhiteSpace(searchTerm);

    private IReadOnlyList<WorkspaceModel> FilteredWorkspaces => GetFilteredWorkspaces();

    private int FilteredWorkspaceCount => FilteredWorkspaces.Count;

    private bool NoWorkspacesMatchSearch =>
        workspaces != null && workspaces.Count > 0 && HasSearchFilter && FilteredWorkspaces.Count == 0;

    private IReadOnlyList<WorkspaceModel> GetFilteredWorkspaces()
    {
        if (workspaces == null)
        {
            return Array.Empty<WorkspaceModel>();
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return workspaces;
        }

        return workspaces
            .Where(w => WorkspaceListSearchMatcher.Matches(
                w,
                WorkspaceService.GetWorkspacePath(w.Name, w.RootPath),
                searchTerm))
            .ToList();
    }

    private void ClearSearchFilter()
    {
        searchTerm = string.Empty;
        StateHasChanged();
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            searchTerm = string.Empty;
            StateHasChanged();
        }
    }

    private bool showEditorModal;
    private bool showRepositoriesModal;
    private ElementReference _deleteModalElement;
    private bool showDeleteModal;
    private bool isSaving;
    private bool isSavingRepositories;
    private bool isDeleting;
    private bool isPersisting;
    private bool isTogglingDefault;
    private bool hasConnectors;
    private string workspaceName = string.Empty;
    private string repositoriesModalWorkspaceName = string.Empty;
    private string? editorErrorMessage;
    private string? repositoriesModalErrorMessage;
    private IReadOnlyList<RenamedRepositoryInfo>? repositoriesModalRenameWarnings;
    private string editorTitle = "Add Workspace";
    private int? editingWorkspaceId;
    private string? editingWorkspaceRootPath;
    private bool editingWorkspaceHasFeatures;
    private WorkspaceType editorType = WorkspaceType.DotNetDependency;
    private bool editorUseGitVersion = true;
    private bool editorUseGitHubActions = true;
    private int? editorWorkspaceRepositoryId;
    private int? editingWorkspaceRepositoryOriginalId;
    private IReadOnlyList<WorkspaceModal.WorkspaceRepositoryChoice> editorWorkspaceRepositoryChoices = Array.Empty<WorkspaceModal.WorkspaceRepositoryChoice>();
    private const string WorkspaceRepositoryFeaturesExistMessage = "Rename and root changes are not possible while Features exist. Remove Features first.";
    private string? deleteBlockedMessage;
    private HashSet<int> editingWorkspaceRepositoryIds = new();
    private WorkspaceModel? workspaceToDelete;
    private HashSet<int> selectedRepositoryIds = new();
    private HashSet<int> excludedRepositoryIds = new();
    private int? fetchedRepositoryCount;
    private CancellationTokenSource? _fetchRepositoriesCts;
    private bool directoryExists;
    private int existingRepositoryCount;
    private CancellationTokenSource? _directoryInfoCts;
    private CancellationTokenSource? _directoryInfoDebounceCts;
    private bool isLoadingDirectoryInfo;
    private bool isDirectoryInfoDirty;
    private int _directoryInfoRequestId;
    private bool showImportModal;
    private int importMatchingCount;
    private List<int> importRepositoryIds = new();
    private bool _disposed;

    protected override void OnInitialized()
    {
        WorkerConnectionTracker.OnStateChanged(OnWorkerConnectionStateChanged);
    }

    private void OnWorkerConnectionStateChanged(WorkerConnectionState state)
    {
        if (_disposed) return;
        if (state is WorkerConnectionState.Online or WorkerConnectionState.VersionMismatch)
            _ = InvokeAsync(async () =>
            {
                await WorkspaceService.GetRootPathAsync();
                if (!_disposed)
                    StateHasChanged();
            });
    }

    public void Dispose()
    {
        _disposed = true;
        _fetchRepositoriesCts?.Cancel();
        _fetchRepositoriesCts?.Dispose();
        _directoryInfoCts?.Cancel();
        _directoryInfoCts?.Dispose();
        _directoryInfoDebounceCts?.Cancel();
        _directoryInfoDebounceCts?.Dispose();
    }

    private bool EditorSaveDisabled =>
        editingWorkspaceId == null
        && (!WorkerBridge.IsWorkerConnected
            || string.IsNullOrWhiteSpace(workspaceName)
            || isDirectoryInfoDirty
            || isLoadingDirectoryInfo);

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspacesAsync();
        if (WorkerBridge.IsWorkerConnected)
            await WorkspaceService.GetRootPathAsync();
    }

    private string WorkspaceEntryHref(int workspaceId)
        => workspaceEntryHrefs.TryGetValue(workspaceId, out var href)
            ? href
            : $"workspaces/{workspaceId}";

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            errorMessage = null;
            workspaces = await WorkspaceRepository.GetAllAsync();
            await LoadWorkspaceEntryHrefsAsync(workspaces);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading workspaces");
            errorMessage = "Failed to load workspaces. Please try again later.";
            workspaces = new List<WorkspaceModel>();
            workspaceEntryHrefs = new();
        }
    }

    private async Task LoadWorkspaceEntryHrefsAsync(IReadOnlyList<WorkspaceModel> items)
    {
        var hrefs = new Dictionary<int, string>(items.Count);
        foreach (var workspace in items)
        {
            hrefs[workspace.WorkspaceId] = await ContextNavigation.BuildWorkspaceEntryHrefAsync(
                workspace.WorkspaceId,
                $"workspaces/{workspace.WorkspaceId}");
        }

        workspaceEntryHrefs = hrefs;
    }

    private async Task ShowCreateModalAsync()
    {
        editingWorkspaceId = null;
        editingWorkspaceRootPath = null;
        editingWorkspaceHasFeatures = false;
        editorType = WorkspaceType.DotNetDependency;
        editorUseGitVersion = true;
        editorUseGitHubActions = true;
        editorWorkspaceRepositoryId = null;
        editingWorkspaceRepositoryOriginalId = null;
        editorWorkspaceRepositoryChoices = await LoadWorkspaceRepositoryChoicesAsync(new HashSet<int>());
        editorTitle = "Add Workspace";
        workspaceName = string.Empty;
        directoryExists = false;
        existingRepositoryCount = 0;
        isDirectoryInfoDirty = false;
        isLoadingDirectoryInfo = false;

        if (!WorkerBridge.IsWorkerConnected)
        {
            editorErrorMessage = "Worker is not available. Please start the GrayMoon Worker to add workspaces.";
        }
        else
        {
            var rootPath = await WorkspaceService.GetRootPathAsync();
            editorErrorMessage = string.IsNullOrWhiteSpace(rootPath)
                ? "Workspace root path is not configured. Go to Settings to configure it before adding workspaces."
                : null;
        }

        showEditorModal = true;
    }

    private bool showRestoreModal;

    private void ShowRestoreModal() => showRestoreModal = true;

    private void CloseRestoreModal() => showRestoreModal = false;

    private async Task OnWorkspaceRestoredAsync()
    {
        await LoadWorkspacesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowEditModalAsync(int workspaceId)
    {
        _directoryInfoDebounceCts?.Cancel();
        _directoryInfoCts?.Cancel();
        var workspace = await WorkspaceRepository.GetByIdAsync(workspaceId);
        if (workspace == null)
        {
            return;
        }

        editingWorkspaceId = workspaceId;
        editingWorkspaceRootPath = workspace.RootPath;
        editorTitle = "Edit Workspace";
        workspaceName = workspace.Name;
        editorErrorMessage = null;
        editingWorkspaceRepositoryIds = workspace.Repositories
            .Select(link => link.RepositoryId)
            .ToHashSet();

        var features = await FeatureOperations.ListFeaturesAsync(workspaceId);
        editingWorkspaceHasFeatures = features.Count > 0;
        editorType = workspace.Type;
        editorUseGitVersion = workspace.VersioningMode == WorkspaceVersioningMode.GitVersion;
        editorUseGitHubActions = workspace.CiProvider == WorkspaceCiProvider.GitHubActions;
        var workspaceRepositoryLink = workspace.Repositories.FirstOrDefault(l => l.Role == WorkspaceRepositoryRole.Workspace);
        editingWorkspaceRepositoryOriginalId = workspaceRepositoryLink?.RepositoryId;
        editorWorkspaceRepositoryId = workspaceRepositoryLink?.RepositoryId;
        editorWorkspaceRepositoryChoices = await LoadWorkspaceRepositoryChoicesAsync(
            workspace.Repositories
                .Where(l => l.Role != WorkspaceRepositoryRole.Workspace)
                .Select(l => l.RepositoryId)
                .ToHashSet());

        directoryExists = false;
        existingRepositoryCount = 0;
        isDirectoryInfoDirty = false;
        isLoadingDirectoryInfo = false;
        showEditorModal = true;
    }

    private async Task ShowAddRepositoriesModalAsync(int workspaceId)
    {
        var workspace = await WorkspaceRepository.GetByIdAsync(workspaceId);
        if (workspace == null)
        {
            return;
        }

        editingWorkspaceId = workspaceId;
        repositoriesModalWorkspaceName = workspace.Name;
        repositoriesModalErrorMessage = null;
        repositoriesModalRenameWarnings = null;
        // The Workspace repository is neither selectable nor removable in the membership modal (D13).
        selectedRepositoryIds = workspace.Repositories
            .Where(link => link.Role != WorkspaceRepositoryRole.Workspace)
            .Select(link => link.RepositoryId)
            .ToHashSet();
        excludedRepositoryIds = workspace.Repositories
            .Where(link => link.Role == WorkspaceRepositoryRole.Workspace)
            .Select(link => link.RepositoryId)
            .ToHashSet();

        try
        {
            var connectors = await ConnectorRepository.GetAllAsync();
            hasConnectors = connectors.Count > 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load connectors for repositories modal.");
            repositoriesModalErrorMessage = "Failed to load repositories. Please try again.";
        }

        repositoriesModalRefreshGeneration++;
        showRepositoriesModal = true;
    }

    private void CloseEditorModal()
    {
        _directoryInfoDebounceCts?.Cancel();
        _directoryInfoCts?.Cancel();
        showEditorModal = false;
        editorErrorMessage = null;
    }

    private void CloseRepositoriesModal()
    {
        showRepositoriesModal = false;
        repositoriesModalErrorMessage = null;
        repositoriesModalRenameWarnings = null;
    }

    private async Task SaveWorkspaceAsync()
    {
        if (string.IsNullOrWhiteSpace(workspaceName))
        {
            editorErrorMessage = "Workspace name is required.";
            return;
        }

        if (editingWorkspaceId == null && !WorkerBridge.IsWorkerConnected)
        {
            editorErrorMessage = "Worker is not available. Please start the GrayMoon Worker to add workspaces.";
            return;
        }

        if (editingWorkspaceId == null)
        {
            var rootPath = await WorkspaceService.GetRootPathAsync();
            if (string.IsNullOrWhiteSpace(rootPath))
            {
                editorErrorMessage = "Workspace root path is not configured. Go to Settings to configure it before adding workspaces.";
                return;
            }

            var workspacePath = WorkspaceService.GetWorkspacePath(workspaceName, editingWorkspaceRootPath);
            var (isValid, pathError) = await WorkspaceService.ValidatePathAsync(workspacePath);
            if (!isValid)
            {
                editorErrorMessage = pathError ?? "The workspace path is not valid or cannot be created.";
                return;
            }
        }

        try
        {
            if (editingWorkspaceId == null && (isDirectoryInfoDirty || isLoadingDirectoryInfo))
            {
                _directoryInfoDebounceCts?.Cancel();
                await LoadDirectoryInfoAsync();
            }

            isSaving = true;
            editorErrorMessage = null;

            if (editingWorkspaceId == null)
            {
                Logger.LogInformation("User created workspace {WorkspaceName}", workspaceName);
                var workspace = await WorkspaceRepository.AddAsync(
                    workspaceName,
                    [],
                    editorType,
                    editorUseGitVersion ? WorkspaceVersioningMode.GitVersion : WorkspaceVersioningMode.None,
                    editorUseGitHubActions ? WorkspaceCiProvider.GitHubActions : WorkspaceCiProvider.None);
                editingWorkspaceId = workspace.WorkspaceId;

                var createWorkspaceRepositoryError = await ApplyWorkspaceRepositoryChangeAsync(workspace.WorkspaceId);
                if (createWorkspaceRepositoryError is not null)
                {
                    editorErrorMessage = createWorkspaceRepositoryError;
                    ToastService.ShowError(createWorkspaceRepositoryError);
                    return;
                }

                if (existingRepositoryCount > 0)
                    await TrySuggestImportsAsync(workspace.WorkspaceId, workspace.Name);
            }
            else
            {
                Logger.LogInformation("User edited workspace {WorkspaceName}", workspaceName);
                await WorkspaceRepository.UpdateAsync(
                    editingWorkspaceId.Value,
                    workspaceName,
                    editingWorkspaceRepositoryIds,
                    editingWorkspaceRootPath,
                    editorType,
                    editorUseGitVersion ? WorkspaceVersioningMode.GitVersion : WorkspaceVersioningMode.None,
                    editorUseGitHubActions ? WorkspaceCiProvider.GitHubActions : WorkspaceCiProvider.None);
                await SyncWorkspaceDefinitionAsync(editingWorkspaceId.Value);
                await PendingActionsService.RefreshAsync(editingWorkspaceId.Value, WorkspaceRepository, WorkspaceProjectRepository);

                var editWorkspaceRepositoryError = await ApplyWorkspaceRepositoryChangeAsync(editingWorkspaceId.Value);
                if (editWorkspaceRepositoryError is not null)
                {
                    editorErrorMessage = editWorkspaceRepositoryError;
                    ToastService.ShowError(editWorkspaceRepositoryError);
                    return;
                }
            }

            if (!showImportModal)
            {
                CloseEditorModal();
                await LoadWorkspacesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace");
            editorErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveRepositoriesAsync()
    {
        if (editingWorkspaceId == null) return;
        if (isSavingRepositories) return;

        var removedInvalidSelections = await PruneInvalidSelectedRepositoryIdsAsync();
        if (removedInvalidSelections > 0)
        {
            Logger.LogWarning("Removed {Count} stale repository selections before saving workspace {WorkspaceId}",
                removedInvalidSelections,
                editingWorkspaceId.Value);
        }

        if (selectedRepositoryIds.Count == 0)
        {
            repositoriesModalErrorMessage = "Select at least one repository.";
            return;
        }

        isSavingRepositories = true;
        repositoriesModalErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            Logger.LogInformation("User added {Count} repositories to workspace {WorkspaceName}", selectedRepositoryIds.Count, repositoriesModalWorkspaceName);
            await WorkspaceRepository.UpdateAsync(editingWorkspaceId.Value, repositoriesModalWorkspaceName, selectedRepositoryIds, editingWorkspaceRootPath);
            await SyncWorkspaceDefinitionAsync(editingWorkspaceId.Value);
            await PendingActionsService.RefreshAsync(editingWorkspaceId.Value, WorkspaceRepository, WorkspaceProjectRepository);

            CloseRepositoriesModal();
            await LoadWorkspacesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving repositories");
            repositoriesModalErrorMessage = ex.Message;
        }
        finally
        {
            isSavingRepositories = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showDeleteModal)
            await _deleteModalElement.FocusAsync();
    }

    private async Task ShowDeleteModal(WorkspaceModel workspace)
    {
        workspaceToDelete = workspace;
        deleteBlockedMessage = null;
        showDeleteModal = true;

        // A Workspace that still has Features cannot be deleted; say so up front instead of after Remove.
        var features = await FeatureOperations.ListFeaturesAsync(workspace.WorkspaceId);
        if (features.Count > 0 && workspaceToDelete == workspace)
        {
            deleteBlockedMessage = WorkspaceRepository.WorkspaceDeleteBlockedByFeaturesMessage;
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        workspaceToDelete = null;
        deleteBlockedMessage = null;
    }

    private async Task HandleDeleteModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDeleteModal();
        }
        else if (ModalKeyboard.IsPlainEnter(e))
        {
            await DeleteWorkspaceAsync();
        }
    }

    private async Task DeleteWorkspaceAsync()
    {
        if (workspaceToDelete == null || deleteBlockedMessage != null)
        {
            return;
        }

        try
        {
            isDeleting = true;
            Logger.LogInformation("User deleted workspace {WorkspaceName}", workspaceToDelete.Name);
            await WorkspaceRepository.DeleteAsync(workspaceToDelete.WorkspaceId);
            CloseDeleteModal();
            await LoadWorkspacesAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message == WorkspaceRepository.WorkspaceDeleteBlockedByFeaturesMessage)
        {
            // A Feature was created after the dialog opened; keep the dialog open and explain.
            deleteBlockedMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting workspace");
            errorMessage = "Failed to delete workspace. Please try again later.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void AbortFetchRepositories()
    {
        _fetchRepositoriesCts?.Cancel();
    }

    private async Task FetchRepositoriesAsync()
    {
        if (!hasConnectors || isPersisting)
        {
            return;
        }

        _fetchRepositoriesCts?.Cancel();
        _fetchRepositoriesCts = new CancellationTokenSource();

        try
        {
            isPersisting = true;
            fetchedRepositoryCount = null;
            repositoriesModalErrorMessage = null;
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<int>(count =>
            {
                fetchedRepositoryCount = count;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await RepositoryService.RefreshRepositoriesAsync(progress, _fetchRepositoriesCts.Token);
            repositoriesModalRenameWarnings = result.RenamedRepositories.Count > 0 ? result.RenamedRepositories : null;
            if (result.MergedRepositoryIdMap.Count > 0)
                TranslateStaleRepositoryIds(result.MergedRepositoryIdMap);
            await PruneInvalidSelectedRepositoryIdsAsync();
            repositoriesModalRefreshGeneration++;
        }
        catch (OperationCanceledException)
        {
            await PruneInvalidSelectedRepositoryIdsAsync();
            repositoriesModalRefreshGeneration++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching repositories");
            repositoriesModalErrorMessage = "Failed to fetch repositories. Please try again later.";
        }
        finally
        {
            isPersisting = false;
        }
    }

    private async Task<int> PruneInvalidSelectedRepositoryIdsAsync()
    {
        if (selectedRepositoryIds.Count == 0)
        {
            return 0;
        }

        var valid = await RepositoryListQueryService.FilterExistingIdsAsync(selectedRepositoryIds);
        var validSet = valid.ToHashSet();
        var before = selectedRepositoryIds.Count;
        selectedRepositoryIds.RemoveWhere(repositoryId => !validSet.Contains(repositoryId));
        return before - selectedRepositoryIds.Count;
    }

    private void TranslateStaleRepositoryIds(IReadOnlyDictionary<int, int> mergedIdMap)
    {
        var staleIds = selectedRepositoryIds.Where(id => mergedIdMap.ContainsKey(id)).ToList();
        foreach (var staleId in staleIds)
        {
            selectedRepositoryIds.Remove(staleId);
            selectedRepositoryIds.Add(mergedIdMap[staleId]);
            Logger.LogInformation(
                "Translated stale repository ID {StaleId} → canonical ID {CanonicalId} after rename merge.",
                staleId, mergedIdMap[staleId]);
        }
    }

    private async Task ToggleDefaultAsync(int workspaceId, string workspaceName)
    {
        try
        {
            isTogglingDefault = true;
            errorMessage = null;
            Logger.LogInformation("User toggled default workspace {WorkspaceName}", workspaceName);
            await WorkspaceRepository.ToggleDefaultAsync(workspaceId);
            await LoadWorkspacesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling default workspace");
            errorMessage = "Failed to update default workspace. Please try again later.";
        }
        finally
        {
            isTogglingDefault = false;
        }
    }

    private string GetWorkspacePath()
    {
        if (string.IsNullOrWhiteSpace(workspaceName))
            return editingWorkspaceRootPath ?? WorkspaceService.RootPath ?? string.Empty;
        return WorkspaceService.GetWorkspacePath(workspaceName, editingWorkspaceRootPath);
    }

    private async Task OnWorkspaceNameChangedAsync(string value)
    {
        workspaceName = value;
        if (editingWorkspaceId != null)
            return;

        isDirectoryInfoDirty = true;
        StateHasChanged();

        _directoryInfoDebounceCts?.Cancel();
        _directoryInfoDebounceCts = new CancellationTokenSource();
        var ct = _directoryInfoDebounceCts.Token;

        try
        {
            await Task.Delay(200, ct);
            await LoadDirectoryInfoAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadDirectoryInfoAsync()
    {
        if (editingWorkspaceId != null)
            return;

        if (string.IsNullOrWhiteSpace(workspaceName))
        {
            directoryExists = false;
            existingRepositoryCount = 0;
            isLoadingDirectoryInfo = false;
            isDirectoryInfoDirty = false;
            StateHasChanged();
            return;
        }

        _directoryInfoCts?.Cancel();
        _directoryInfoCts = new CancellationTokenSource();
        var requestId = ++_directoryInfoRequestId;
        var ct = _directoryInfoCts.Token;

        try
        {
            isLoadingDirectoryInfo = true;
            var existsTask = WorkspaceService.DirectoryExistsAsync(workspaceName, editingWorkspaceRootPath, ct);
            var countTask = WorkspaceService.GetRepositoryCountAsync(workspaceName, editingWorkspaceRootPath, ct);
            directoryExists = await existsTask;
            existingRepositoryCount = await countTask;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load directory info for {WorkspaceName}", workspaceName);
            if (requestId == _directoryInfoRequestId)
            {
                directoryExists = false;
                existingRepositoryCount = 0;
            }
        }
        finally
        {
            if (requestId == _directoryInfoRequestId)
            {
                isLoadingDirectoryInfo = false;
                isDirectoryInfoDirty = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task TrySuggestImportsAsync(int workspaceId, string workspaceName)
    {
        try
        {
            var infos = await WorkspaceService.GetWorkspaceRepositoryInfosAsync(workspaceName, editingWorkspaceRootPath);
            if (infos.Count == 0)
                return;

            var urls = infos
                .Select(i => i.OriginUrl)
                .Where(u => !string.IsNullOrWhiteSpace(u))
                .Select(u => u!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (urls.Count == 0)
                return;

            var byUrl = await RepositoryListQueryService.GetIdsByCloneUrlsAsync(urls);

            var matchedIds = new HashSet<int>();
            foreach (var url in urls)
            {
                if (byUrl.TryGetValue(url, out var repoId))
                    matchedIds.Add(repoId);
            }

            if (matchedIds.Count == 0)
                return;

            importRepositoryIds = matchedIds.ToList();
            importMatchingCount = importRepositoryIds.Count;
            showImportModal = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to suggest imports for workspace {WorkspaceName}", workspaceName);
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (editingWorkspaceId is null || importRepositoryIds.Count == 0)
        {
            showImportModal = false;
            CloseEditorModal();
            await LoadWorkspacesAsync();
            return;
        }

        try
        {
            await WorkspaceRepository.AddRepositoriesAsync(editingWorkspaceId.Value, importRepositoryIds);
            await SyncWorkspaceDefinitionAsync(editingWorkspaceId.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import repositories into workspace {WorkspaceId}", editingWorkspaceId);
        }
        finally
        {
            showImportModal = false;
            CloseEditorModal();
            await LoadWorkspacesAsync();
        }
    }

    /// <summary>
    /// Imported repositories offered by the "Workspace repository" select: everything that is not a Source of this
    /// Workspace (D13). Uses a short-lived factory context (AGENTS.md DbContext handling).
    /// </summary>
    private async Task<IReadOnlyList<WorkspaceModal.WorkspaceRepositoryChoice>> LoadWorkspaceRepositoryChoicesAsync(
        IReadOnlySet<int> sourceRepositoryIds)
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var rows = await db.Repositories.AsNoTracking()
                .Where(r => r.Connector != null && r.Connector.ConnectorType == ConnectorType.GitHub)
                .Select(r => new { r.RepositoryId, r.RepositoryName, r.OrgName })
                .ToListAsync();
            return WorkspaceModal.BuildWorkspaceRepositoryChoices(
                rows.Select(r => (r.RepositoryId, r.RepositoryName, r.OrgName)),
                sourceRepositoryIds);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load repositories for the Workspace repository select.");
            return Array.Empty<WorkspaceModal.WorkspaceRepositoryChoice>();
        }
    }

    private async Task<int?> GetCurrentWorkspaceRepositoryIdAsync(int workspaceId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        return await db.WorkspaceRepositories.AsNoTracking()
            .Where(l => l.WorkspaceId == workspaceId && l.Role == WorkspaceRepositoryRole.Workspace)
            .Select(l => (int?)l.RepositoryId)
            .FirstOrDefaultAsync();
    }

    /// <summary>
    /// Applies a changed "Workspace repository" selection after the Workspace itself is saved (D13): disable the old
    /// one, then enable the new one. Returns the error to show, or null when nothing was wrong (including no change).
    /// The saved link state is re-read afterwards so a retry starts from what is actually in the database.
    /// </summary>
    private async Task<string?> ApplyWorkspaceRepositoryChangeAsync(int workspaceId)
    {
        if (editorWorkspaceRepositoryId == editingWorkspaceRepositoryOriginalId)
            return null;

        if (editingWorkspaceHasFeatures)
            return WorkspaceRepositoryFeaturesExistMessage;

        try
        {
            if (editingWorkspaceRepositoryOriginalId is not null)
            {
                var disabled = await WorkspaceRepositoryOperations.DisableWorkspaceRepositoryAsync(workspaceId);
                editingWorkspaceRepositoryOriginalId = await GetCurrentWorkspaceRepositoryIdAsync(workspaceId);
                if (!disabled.Success)
                    return disabled.Error ?? "Could not disable the Workspace repository.";
            }

            if (editorWorkspaceRepositoryId is { } repositoryId)
            {
                var enabled = await WorkspaceRepositoryOperations.EnableWorkspaceRepositoryAsync(workspaceId, repositoryId);
                editingWorkspaceRepositoryOriginalId = await GetCurrentWorkspaceRepositoryIdAsync(workspaceId);
                if (!enabled.Success)
                    return enabled.Error ?? "Could not enable the Workspace repository.";
            }

            return null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Changing the Workspace repository failed for workspace {WorkspaceId}", workspaceId);
            return ex.Message;
        }
    }

    // Source membership or the profile changed: keep the managed .gitignore section and the Workspace definition in step (D12).
    private async Task SyncWorkspaceDefinitionAsync(int workspaceId)
    {
        var error = await ManifestService.SyncDefinitionToDiskAsync(workspaceId);
        if (error is not null)
            ToastService.ShowError(error);
    }

    private async Task CancelImportAsync()
    {
        showImportModal = false;
        CloseEditorModal();
        await LoadWorkspacesAsync();
        await InvokeAsync(StateHasChanged);
    }
}
