@page "/workspaces/{WorkspaceId:int}/packages"
@rendermode InteractiveServer
@using GrayMoon.App.Models
@using GrayMoon.App.Repositories
@using GrayMoon.App.Services
@using GrayMoon.App.Components.Shared
@using GrayMoon.App.Components.Features
@using GrayMoon.Application.Features
@using GrayMoon.App.Services.Features
@using GrayMoon.App.Services.GitHub
@using Microsoft.AspNetCore.Components.Web
@inject WorkspaceRepository WorkspaceRepository
@inject WorkspaceProjectRepository WorkspaceProjectRepository
@inject PackageRegistrySyncService PackageRegistrySyncService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject ILogger<WorkspacePackages> Logger
@using WorkspaceModel = GrayMoon.App.Models.Workspace

<PageTitle>Packages - GrayMoon</PageTitle>

<WorkspacePageGate Page="WorkspacePage.Packages" WorkspaceId="WorkspaceId" Outcome="_pageAccess" ContextQuery="ContextQuery">
    <div class="container-fluid page-container grid-page">
        <div class="grid-page-header">
            <div class="workspace-repos-header workspace-packages-header">
                <div class="workspace-repos-title-row">
                    <h2 class="workspace-repos-title">Packages</h2>
                    <p class="text-muted mb-0 workspace-repos-subtitle workspace-packages__subtitle">
                        <WorkspaceSubtitleName Name="@(workspace?.Name)" />
                        @if (!isLoading && packages.Count > 0)
                        {
                            var pkgSuffix = HasSearchFilter ? " found" : "";
                            var pkgCount = HasSearchFilter ? FilteredPackageCount : packages.Count;
                            <span>@($"{pkgCount} {(pkgCount == 1 ? "package" : "packages")}{pkgSuffix}")</span>
                        }
                        else if (!isLoading && workspace != null)
                        {
                            <span>0 packages</span>
                        }
                        else if (isLoading)
                        {
                            <span>&nbsp;</span>
                        }
                    </p>
                    <span class="workspace-repos-title-spacer"></span>
                </div>
                <div class="d-flex gap-2 align-items-center workspace-repos-header-actions flex-wrap">
                    <WorkspaceContextBar WorkspaceId="WorkspaceId"
                                         WorkspaceName="@(workspace?.Name)"
                                         SelectedContextId="_selectedContextId"
                                         SelectedContextIdChanged="OnSelectedContextChangedAsync">
                        <FilterSearchInput @bind-Value="searchTerm"
                                           InputId="workspace-packages-search"
                                           InputAdditionalClass="workspace-grid-search"
                                           Placeholder="Search package id..."
                                           Disabled="@isLoading"
                                           AutoFocus="true"
                                           OnKeyDown="OnSearchKeyDown"
                                           OnClear="ClearSearchFilter" />
                    </WorkspaceContextBar>
                    <button class="btn btn-outline-primary"
                            @onclick="SyncRegistriesAsync"
                            disabled="@(isSyncingRegistries || packages.Count == 0)">
                        Sync registries
                    </button>
                </div>
            </div>
            @if (errorMessage != null)
            {
                <div class="gm-callout gm-callout--error" role="alert">@errorMessage</div>
            }
        </div>
        @if (errorMessage == null)
        {
            <div class="grid-page-body">
                <div class="card page-card mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0 packages-table resizable-columns" data-workspace-id="@WorkspaceId">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="col-packageid">Package Id</th>
                                        <th class="col-framework">Framework</th>
                                        <th class="col-usedby">Used by</th>
                                        <th class="col-registry">Registry</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (isLoading)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                Loading packages...
                                            </td>
                                        </tr>
                                    }
                                    else if (packages.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                No NuGet packages in this workspace. Sync repositories to discover package projects.
                                            </td>
                                        </tr>
                                    }
                                    else if (NoPackagesMatchSearch)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                No packages match your search.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var p in FilteredPackages)
                                        {
                                            var packagePageUrl = RepositoryUrlHelper.GetGitHubNuGetPackageUrl(
                                                p.MatchedConnector?.ApiBaseUrl,
                                                p.PackageId,
                                                p.Repository?.CloneUrl);
                                            <tr>
                                                <td class="col-packageid">
                                                    @if (packagePageUrl != null)
                                                    {
                                                        <a href="@packagePageUrl" target="_blank" rel="noopener noreferrer" class="repo-link"><strong>@p.PackageId</strong></a>
                                                    }
                                                    else
                                                    {
                                                        <strong>@(p.PackageId ?? "-")</strong>
                                                    }
                                                </td>
                                                <td class="col-framework"><span class="badge bg-secondary">@(p.TargetFramework ?? "-")</span></td>
                                                <td class="col-usedby">
                                                    @if (dependentRepositories.TryGetValue(p.ProjectId, out var dependents) && dependents.Count > 0)
                                                    {
                                                        var settingsUrl = RepositoryUrlHelper.GetGitHubNuGetPackageSettingsUrl(
                                                            p.MatchedConnector?.ApiBaseUrl,
                                                            p.PackageId,
                                                            p.Repository?.CloneUrl);
                                                        <span class="dependency-badge-tooltip-wrap">
                                                            @if (settingsUrl != null)
                                                            {
                                                                <a href="@settingsUrl"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer"
                                                                   class="badge packages-usedby-badge packages-usedby-badge--link"
                                                                   aria-label="Open package settings on GitHub">@dependents.Count</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge packages-usedby-badge">@dependents.Count</span>
                                                            }
                                                            <div class="dependency-badge-tooltip">
                                                                <div class="dependency-badge-tooltip-header">
                                                                    <span class="dependency-badge-tooltip-title">Used by repositories:</span>
                                                                    <button type="button"
                                                                            class="dependency-badge-tooltip-copy"
                                                                            title="Copy list to clipboard"
                                                                            aria-label="Copy list to clipboard"
                                                                            @onclick="() => CopyDependentRepositoriesAsync(dependents)"
                                                                            @onclick:preventDefault
                                                                            @onclick:stopPropagation>
                                                                        <i class="bi bi-clipboard" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                                @foreach (var dependent in dependents)
                                                                {
                                                                    <div class="dependency-badge-tooltip-line">
                                                                        <code>@dependent.RepositoryName</code>
                                                                        @if (!dependent.IsDirect)
                                                                        {
                                                                            <span class="dependency-badge-tooltip-versions">via @dependent.ViaPackageId</span>
                                                                        }
                                                                    </div>
                                                                }
                                                                @if (settingsUrl != null)
                                                                {
                                                                    <div class="dependency-badge-tooltip-footer">
                                                                        Click the number to open the package settings on GitHub, then add these repositories under Manage Actions access.
                                                                    </div>
                                                                }
                                                            </div>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="col-registry text-muted">@(p.MatchedConnector?.ConnectorName ?? "-")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <LoadingOverlay IsVisible="@isLoading" Message="Loading packages..." />
    <LoadingOverlay IsVisible="@isSyncingRegistries" Message="Syncing registries..." />
</WorkspacePageGate>

@code {
    [Parameter] public int WorkspaceId { get; set; }

    [SupplyParameterFromQuery(Name = "context")]
    public int? ContextQuery { get; set; }

    [Inject] private WorkspaceContextNavigationService ContextNavigation { get; set; } = default!;
    [Inject] private IWorkspacePageAccessResolver PageAccess { get; set; } = default!;

    private WorkspacePageAccessOutcome? _pageAccess;
    private WorkspaceFeatureContextId? _selectedContextId;
    private WorkspaceModel? workspace;
    private List<WorkspaceProject> packages = new();
    private IReadOnlyDictionary<int, IReadOnlyList<PackageDependentRepository>> dependentRepositories =
        new Dictionary<int, IReadOnlyList<PackageDependentRepository>>();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSyncingRegistries = false;
    private string searchTerm = string.Empty;

    private bool HasSearchFilter => !string.IsNullOrWhiteSpace(searchTerm);

    private IReadOnlyList<WorkspaceProject> FilteredPackages => GetFilteredPackages();

    private int FilteredPackageCount => FilteredPackages.Count;

    private bool NoPackagesMatchSearch =>
        !isLoading && packages.Count > 0 && FilteredPackages.Count == 0;

    private IReadOnlyList<WorkspaceProject> GetFilteredPackages()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return packages;
        }

        return packages.Where(p => WorkspacePackageSearchMatcher.Matches(p, searchTerm)).ToList();
    }

    private void ClearSearchFilter()
    {
        searchTerm = string.Empty;
        StateHasChanged();
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            searchTerm = string.Empty;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pageAccess = await PageAccess.LoadIfAvailableAsync(WorkspaceId, WorkspacePage.Packages, async () =>
        {
            var info = await ContextNavigation.ResolveForPageAsync(WorkspaceId, ContextQuery);
            _selectedContextId = info.ContextId;
            await LoadAsync();
        });
    }

    private async Task OnSelectedContextChangedAsync(WorkspaceFeatureContextId contextId)
    {
        _selectedContextId = contextId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            workspace = await WorkspaceRepository.GetByIdAsync(WorkspaceId);
            if (workspace == null)
            {
                errorMessage = "Workspace not found.";
                packages = new List<WorkspaceProject>();
                dependentRepositories = new Dictionary<int, IReadOnlyList<PackageDependentRepository>>();
                return;
            }
            packages = _selectedContextId is WorkspaceFeatureContextId ctx
                ? await WorkspaceProjectRepository.GetPackagesByWorkspaceIdAsync(WorkspaceId, ctx.Value)
                : await WorkspaceProjectRepository.GetPackagesByWorkspaceIdAsync(WorkspaceId);
            dependentRepositories = await WorkspaceProjectRepository.GetPackageDependentRepositoriesAsync(WorkspaceId, _selectedContextId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading packages for workspace {WorkspaceId}", WorkspaceId);
            errorMessage = "Failed to load packages. Please try again later.";
            packages = new List<WorkspaceProject>();
            dependentRepositories = new Dictionary<int, IReadOnlyList<PackageDependentRepository>>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyDependentRepositoriesAsync(IReadOnlyList<PackageDependentRepository> dependents)
    {
        try
        {
            var text = string.Join(Environment.NewLine, dependents.Select(d => d.RepositoryName));
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ToastService.Show("Repository list copied to the clipboard");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Copy of dependent repositories failed for workspace {WorkspaceId}", WorkspaceId);
            ToastService.Show("Could not copy to clipboard.");
        }
    }

    private async Task SyncRegistriesAsync()
    {
        if (_pageAccess != WorkspacePageAccessOutcome.Available || workspace == null || isSyncingRegistries || packages.Count == 0) return;
        try
        {
            isSyncingRegistries = true;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            await PackageRegistrySyncService.SyncWorkspacePackageRegistriesAsync(WorkspaceId, cancellationToken: default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error syncing package registries for workspace {WorkspaceId}", WorkspaceId);
            errorMessage = "Failed to sync registries. Please try again.";
        }
        finally
        {
            isSyncingRegistries = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
