@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using GrayMoon.App.Repositories
@using GrayMoon.App.Services
@inject WorkspaceRepository WorkspaceRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject AgentConnectionTracker AgentConnectionTracker
@inject IAgentBridge AgentBridge
@inject ConnectorHealthService ConnectorHealthService
@inject ConnectorRepository ConnectorRepository
<PageTitle>Home - GrayMoon</PageTitle>

@if (!showHome)
{
    <div class="container-fluid page-container">
        <div class="text-muted py-4">Loading...</div>
    </div>
}
else
{
<div class="container-fluid page-container">
    <div class="row mb-4 align-items-stretch">
        <div class="col-md-8 col-lg-8 d-flex mb-4 mb-md-0">
            <div class="jumbotron banner-card-style home-banner rounded p-4 border flex-grow-1 d-flex flex-column">
                <div class="home-banner-glow" aria-hidden="true"></div>
                <img src="moon-dark.svg" alt="" class="home-banner-moon" aria-hidden="true" />
                <div class="home-banner-veil" aria-hidden="true"></div>
                <div class="home-banner-copy">
                    <h1 class="display-5 mb-0 banner-title">
                        GrayMoon
                    </h1>
                    <p class="lead fs-6 mb-0 banner-subtitle">
                        All repos moving together.
                    </p>
                </div>
                <div class="home-banner-invite">
                    <p class="card-text mb-0">The GrayMoon journey starts here...</p>
                    <p class="card-text">Share your thoughts.</p>
                    <a class="btn home-banner-discuss"
                       href="https://github.com/Jandini/GrayMoon/discussions"
                       target="_blank"
                       rel="noopener noreferrer">Join Discussion</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-4 mb-4 mb-md-0">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-grid"></i> Workspaces
                    </h5>
                    <p class="card-text">
                        Group repositories into workspaces for quick access.
                    </p>
                    <a class="btn btn-primary" href="/workspaces">
                        Manage Workspaces
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-cpu"></i> Worker
                    </h5>
                    <p class="card-text">
                        Install, update, or uninstall the GrayMoon Worker service.
                    </p>
                    <a class="btn @AgentButtonClass" href="/agent">@AgentButtonText</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-plug"></i> Connectors
                    </h5>
                    <p class="card-text">
                        Configure access to GitHub and NuGet registries and manage connector tokens.
                    </p>
                    <a class="btn @ConnectorButtonClass" href="/connectors">
                        @ConnectorButtonText
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-collection"></i> Repositories
                    </h5>
                    <p class="card-text">
                        Fetch and review repositories available from your connectors.
                    </p>
                    <a class="btn btn-primary" href="/repositories">
                        View Repositories
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
}

@code {
    private const string DefaultWorkspaceRedirectKey = "defaultWorkspaceRedirected";
    private bool showHome;
    private bool hasConnectors;
    private bool anyUsedConnectorUnhealthy;
    private bool hostPrerequisitesMissing;
    private int hostInfoGeneration;

    private string AgentButtonText =>
        AgentConnectionTracker.State == AgentConnectionState.Online && hostPrerequisitesMissing
            ? "Install Prerequisites"
            : AgentConnectionTracker.State switch
            {
                AgentConnectionState.Online => "Manage Worker",
                AgentConnectionState.VersionMismatch => "Update Worker",
                _ => "Install Worker"
            };

    private string AgentButtonClass =>
        AgentConnectionTracker.State == AgentConnectionState.Online && !hostPrerequisitesMissing
            ? "btn-primary"
            : "btn-danger";

    private string ConnectorButtonText => hasConnectors ? "Manage Connectors" : "Add Connectors";

    private string ConnectorButtonClass => hasConnectors && !anyUsedConnectorUnhealthy ? "btn-primary" : "btn-danger";

    protected override async Task OnInitializedAsync()
    {
        var connectors = await ConnectorRepository.GetAllAsync();
        hasConnectors = connectors.Count > 0;
        anyUsedConnectorUnhealthy = hasConnectors && await ConnectorHealthService.AnyUsedConnectorUnhealthyAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        AgentConnectionTracker.OnStateChanged(state =>
        {
            try
            {
                _ = InvokeAsync(() => OnAgentStateChangedAsync(state));
            }
            catch (ObjectDisposedException)
            {
            }
        });
    }

    private async Task OnAgentStateChangedAsync(AgentConnectionState state)
    {
        if (state != AgentConnectionState.Online)
        {
            Interlocked.Increment(ref hostInfoGeneration);
            hostPrerequisitesMissing = false;
            StateHasChanged();
            return;
        }

        StateHasChanged();
        await RefreshHostPrerequisitesAsync();
    }

    private async Task RefreshHostPrerequisitesAsync()
    {
        var generation = Interlocked.Increment(ref hostInfoGeneration);
        var missing = await QueryHostPrerequisitesMissingAsync();
        if (generation != Volatile.Read(ref hostInfoGeneration))
            return;

        hostPrerequisitesMissing = AgentConnectionTracker.State == AgentConnectionState.Online && missing;
        StateHasChanged();
    }

    private async Task<bool> QueryHostPrerequisitesMissingAsync()
    {
        if (!AgentBridge.IsAgentConnected)
            return false;

        try
        {
            var response = await AgentBridge.SendCommandAsync("GetHostInfo", new { }, CancellationToken.None);
            if (!response.Success || response.Data is null)
                return false;

            var json = response.Data is JsonElement element
                ? element.GetRawText()
                : JsonSerializer.Serialize(response.Data);
            var dto = JsonSerializer.Deserialize<HostInfoDto>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (dto is null)
                return false;

            return HostPrerequisiteState.AnyMissing(new HostPrerequisiteVersions(
                dto.DotnetVersion,
                dto.GitVersion,
                dto.GitVersionToolVersion));
        }
        catch (Exception)
        {
            return false;
        }
    }

    private sealed record HostInfoDto(string? DotnetVersion, string? GitVersion, string? GitVersionToolVersion);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || showHome)
        {
            return;
        }

        var alreadyRedirected = await JsRuntime.InvokeAsync<string?>(
            "sessionStorage.getItem",
            DefaultWorkspaceRedirectKey);

        if (string.Equals(alreadyRedirected, "true", StringComparison.OrdinalIgnoreCase))
        {
            showHome = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var defaultWorkspace = await WorkspaceRepository.GetDefaultAsync();
        if (defaultWorkspace != null)
        {
            await JsRuntime.InvokeVoidAsync(
                "sessionStorage.setItem",
                DefaultWorkspaceRedirectKey,
                "true");
            NavigationManager.NavigateTo($"/workspaces/{defaultWorkspace.WorkspaceId}", replace: true);
            return;
        }

        showHome = true;
        await InvokeAsync(StateHasChanged);
    }
}
