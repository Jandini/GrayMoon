@namespace GrayMoon.App.Components.GitChanges
@using GrayMoon.App.Services.GitChanges
@using GrayMoon.Common.Git

<div class="git-changes-tree">
    @if (!string.IsNullOrEmpty(OfflineNotice))
    {
        <div class="git-changes-offline-notice">
            @OfflineNotice
        </div>
    }

    @if (Rows.Count == 0)
    {
        <div class="git-changes-tree__empty text-muted">@(IsFilterActive && HasChanges ? "No changes match the current filter." : "No changes")</div>
    }
    else
    {
        @foreach (var row in Rows)
        {
            <div class="git-changes-tree__row git-changes-tree__row--@(row.Kind.ToString().ToLowerInvariant()) @(IsSelected(row) ? "git-changes-tree__row--selected" : "") @(row.Kind == GitChangesTreeRowKind.File && IsMultiSelected(row) ? "git-changes-tree__row--multi-selected" : "")"
                 style="padding-left: @(row.Depth * 1.1)rem"
                 @key="row.Key">

                <span class="git-changes-tree__toggle" @onclick="() => OnToggleExpand.InvokeAsync(row)">
                    @if (row.HasChildren)
                    {
                        <i class="bi @(row.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                    }
                </span>

                <span class="git-changes-tree__icon">
                    <i class="bi @IconFor(row)" aria-hidden="true"></i>
                </span>

                <span class="git-changes-tree__label"
                      @onclick="e => OnLabelClick(row, e)"
                      @onmousedown:preventDefault="@(row.Kind == GitChangesTreeRowKind.File)">
                    @if (row.Kind == GitChangesTreeRowKind.Repository)
                    {
                        <span class="git-changes-tree__repo-name">@row.Label</span>
                        @if (!string.IsNullOrEmpty(row.BranchName))
                        {
                            <span class="git-changes-tree__repo-branch" title="@row.BranchName">@row.BranchName</span>
                        }
                    }
                    else if (row.Kind == GitChangesTreeRowKind.Section)
                    {
                        @row.Label
                        @if (row.Count.HasValue)
                        {
                            <span class="git-changes-tree__count-badge">@row.Count</span>
                        }
                    }
                    else
                    {
                        @row.Label
                        @if (row.Kind == GitChangesTreeRowKind.File && !string.IsNullOrEmpty(row.OriginalPath))
                        {
                            <span class="git-changes-tree__rename-from text-muted">&larr; @row.OriginalPath</span>
                        }
                    }
                </span>

                @if (row.Kind == GitChangesTreeRowKind.File)
                {
                    <span class="git-changes-tree__status git-changes-tree__status--@StatusClass(row)" title="@StatusLabel(row)">
                        @StatusLetter(row)
                    </span>
                }

                <span class="git-changes-tree__actions">
                    @RenderActions(row)
                </span>
            </div>

        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GitChangesTreeRow> Rows { get; set; } = [];
    [Parameter] public string? OfflineNotice { get; set; }
    [Parameter] public bool IsFilterActive { get; set; }
    [Parameter] public bool HasChanges { get; set; }
    [Parameter] public GitChangesTreeRow? SelectedRow { get; set; }
    [Parameter] public EventCallback<GitChangesTreeRow> OnToggleExpand { get; set; }
    [Parameter] public EventCallback<GitChangesFileSelectEventArgs> OnSelectFile { get; set; }
    [Parameter] public EventCallback<GitChangesStageEventArgs> OnStage { get; set; }
    [Parameter] public EventCallback<GitChangesStageEventArgs> OnUnstage { get; set; }
    [Parameter] public EventCallback OnStageSelected { get; set; }
    [Parameter] public EventCallback OnUnstageSelected { get; set; }
    [Parameter] public EventCallback OnStageAllChanged { get; set; }
    [Parameter] public EventCallback OnUnstageAllStaged { get; set; }
    /// <summary>Undo (discard) a single File/Folder/Repository row's unstaged changes. Never raised for
    /// Staged-section rows - discard is only ever offered on unstaged (Changed) items, matching VS Code.</summary>
    [Parameter] public EventCallback<GitChangesStageEventArgs> OnDiscard { get; set; }
    /// <summary>Undo (discard) every currently multi-selected unstaged File row in one batch - the discard
    /// equivalent of <see cref="OnUnstageSelected"/>/<see cref="OnStageSelected"/>.</summary>
    [Parameter] public EventCallback OnDiscardSelected { get; set; }
    /// <summary>Undo (discard) every unstaged change across every repository in the Changed section.</summary>
    [Parameter] public EventCallback OnDiscardAllChanged { get; set; }
    [Parameter, EditorRequired] public Func<int, bool> IsMutating { get; set; } = _ => false;
    /// <summary>True only when this exact row has a File/Folder-scope mutation of the given kind
    /// (isDiscard: true for the Undo button, false for the Stage/Unstage button) in flight - used to swap
    /// that single button's icon for a spinner without affecting the row's other action button or any
    /// other row (descendant, sibling, or otherwise) in the same repository.</summary>
    [Parameter, EditorRequired] public Func<GitChangesTreeRow, bool, bool> IsRowMutating { get; set; } = (_, _) => false;
    /// <summary>True when the given File row is part of the page's active multi-selection set.</summary>
    [Parameter, EditorRequired] public Func<GitChangesTreeRow, bool> IsMultiSelected { get; set; } = _ => false;
    /// <summary>Count of currently multi-selected File rows. Stage/Unstage on a multi-selected row only
    /// fans out to the whole selection when this is greater than 1.</summary>
    [Parameter] public int MultiSelectionCount { get; set; }

    private bool IsSelected(GitChangesTreeRow row) =>
        SelectedRow != null && SelectedRow.Kind == GitChangesTreeRowKind.File && SelectedRow.Key == row.Key;

    private Task OnLabelClick(GitChangesTreeRow row, MouseEventArgs e) =>
        row.Kind == GitChangesTreeRowKind.File
            ? OnSelectFile.InvokeAsync(new GitChangesFileSelectEventArgs(row, e.CtrlKey || e.MetaKey, e.ShiftKey))
            : OnToggleExpand.InvokeAsync(row);

    private static string IconFor(GitChangesTreeRow row) => row.Kind switch
    {
        GitChangesTreeRowKind.Section => row.IsStagedSection ? "bi-pencil-square" : "bi-pencil",
        GitChangesTreeRowKind.Repository => "bi-git",
        GitChangesTreeRowKind.Folder => "bi-folder",
        GitChangesTreeRowKind.File => "bi-file-earmark",
        _ => "bi-dash",
    };

    private static string StatusLetter(GitChangesTreeRow row)
    {
        var kind = row.IsStagedSection ? row.IndexChange : row.WorktreeChange;
        if (row.IsConflicted)
        {
            return "U";
        }

        return kind switch
        {
            GitChangeKind.Added or GitChangeKind.Untracked => "A",
            GitChangeKind.Modified => "M",
            GitChangeKind.Deleted => "D",
            GitChangeKind.Renamed => "R",
            GitChangeKind.Copied => "C",
            GitChangeKind.TypeChanged => "T",
            GitChangeKind.Unmerged => "U",
            _ => "",
        };
    }

    private static string StatusLabel(GitChangesTreeRow row)
    {
        var kind = row.IsStagedSection ? row.IndexChange : row.WorktreeChange;
        if (row.IsConflicted)
        {
            return "Conflict";
        }

        return kind switch
        {
            GitChangeKind.Added => "Added",
            GitChangeKind.Untracked => "New file",
            GitChangeKind.Modified => "Modified",
            GitChangeKind.Deleted => "Deleted",
            GitChangeKind.Renamed => "Renamed",
            GitChangeKind.Copied => "Copied",
            GitChangeKind.TypeChanged => "Type changed",
            GitChangeKind.Unmerged => "Unmerged",
            _ => "Unchanged",
        };
    }

    private static string StatusClass(GitChangesTreeRow row)
    {
        if (row.IsConflicted)
        {
            return "conflict";
        }

        var kind = row.IsStagedSection ? row.IndexChange : row.WorktreeChange;
        return kind switch
        {
            GitChangeKind.Added or GitChangeKind.Untracked => "added",
            GitChangeKind.Deleted => "deleted",
            GitChangeKind.Renamed => "renamed",
            _ => "modified",
        };
    }

    private RenderFragment RenderActions(GitChangesTreeRow row) => builder =>
    {
        switch (row.Kind)
        {
            case GitChangesTreeRowKind.File:
                RenderFileActions(builder, row);
                break;
            case GitChangesTreeRowKind.Folder:
                RenderScopedAction(builder, row, GitChangeOperationScope.Folder, FolderPathsOf(row));
                break;
            case GitChangesTreeRowKind.Repository:
                RenderScopedAction(builder, row, GitChangeOperationScope.Repository, []);
                break;
            case GitChangesTreeRowKind.Section:
                RenderSectionAction(builder, row);
                break;
        }
    };

    private void RenderSectionAction(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, GitChangesTreeRow row)
    {
        var seq = 0;

        // Discard has no meaning for the Staged section - it only ever targets unstaged content - so the
        // undo icon is rendered before the +/- button solely for the Changed section header.
        if (!row.IsStagedSection)
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
            builder.AddAttribute(seq++, "title", "Undo all changes in Changed");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnDiscardAllChanged.InvokeAsync()));
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", "bi bi-arrow-counterclockwise");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
        builder.AddAttribute(seq++, "title", row.IsStagedSection ? "Unstage all items in Staged" : "Stage all items in Changed");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => row.IsStagedSection
            ? OnUnstageAllStaged.InvokeAsync()
            : OnStageAllChanged.InvokeAsync()));
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", row.IsStagedSection ? "bi bi-dash-lg" : "bi bi-plus-lg");
        builder.CloseElement();
        builder.CloseElement();
    }

    private void RenderFileActions(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, GitChangesTreeRow row)
    {
        var seq = 0;
        var paths = new[] { row.FilePath! };
        var disabled = IsMutating(row.WorkspaceRepositoryId);
        // A multi-selected row (selection size > 1) fans its Stage/Unstage click out to every selected
        // File row in that action's section instead of just this one row - see StageSelectedAsync /
        // UnstageSelectedAsync on the page.
        var useSelection = IsMultiSelected(row) && MultiSelectionCount > 1;

        // Discard is only ever offered on unstaged (Changed) rows, mirroring VS Code - Staged rows must be
        // unstaged first. Reuses the same useSelection fan-out as Stage/Unstage above.
        if (!row.IsStagedSection)
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
            builder.AddAttribute(seq++, "disabled", disabled);
            builder.AddAttribute(seq++, "title", useSelection ? "Undo selected" : "Undo changes");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => useSelection
                ? OnDiscardSelected.InvokeAsync()
                : OnDiscard.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, GitChangeOperationScope.ExplicitPaths, paths, row.Key))));
            RenderActionIcon(builder, ref seq, "bi-arrow-counterclockwise", IsRowMutating(row, true));
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
        builder.AddAttribute(seq++, "disabled", disabled);
        builder.AddAttribute(seq++, "title", row.IsStagedSection
            ? (useSelection ? "Unstage selected" : "Unstage")
            : (useSelection ? "Stage selected" : "Stage"));
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => row.IsStagedSection
            ? (useSelection ? OnUnstageSelected.InvokeAsync() : OnUnstage.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, GitChangeOperationScope.ExplicitPaths, paths, row.Key)))
            : (useSelection ? OnStageSelected.InvokeAsync() : OnStage.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, GitChangeOperationScope.ExplicitPaths, paths, row.Key)))));
        RenderActionIcon(builder, ref seq, row, IsRowMutating(row, false));
        builder.CloseElement();
    }

    private void RenderScopedAction(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, GitChangesTreeRow row, GitChangeOperationScope scope, IReadOnlyList<string> paths)
    {
        var seq = 0;
        var disabled = IsMutating(row.WorkspaceRepositoryId);

        // Discard is only ever offered on unstaged (Changed) Folder/Repository rows - Staged rows must be
        // unstaged first, mirroring VS Code and the File-row behavior above.
        if (!row.IsStagedSection)
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
            builder.AddAttribute(seq++, "disabled", disabled);
            builder.AddAttribute(seq++, "title", row.Kind == GitChangesTreeRowKind.Repository ? "Undo all changes in repository" : "Undo all changes in folder");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnDiscard.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, scope, paths, row.Key))));
            // Repository scope runs as a full background job (LoadingOverlay), not the lightweight inline
            // indicator, so it never has a row-scoped spinner - only the Folder discard button does.
            RenderActionIcon(builder, ref seq, "bi-arrow-counterclockwise", row.Kind != GitChangesTreeRowKind.Repository && IsRowMutating(row, true));
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "git-changes-tree__action-btn");
        builder.AddAttribute(seq++, "disabled", disabled);
        builder.AddAttribute(seq++, "title", row.IsStagedSection
            ? (row.Kind == GitChangesTreeRowKind.Repository ? "Unstage repository" : "Unstage folder")
            : (row.Kind == GitChangesTreeRowKind.Repository ? "Stage repository" : "Stage folder"));
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => row.IsStagedSection
            ? OnUnstage.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, scope, paths, row.Key))
            : OnStage.InvokeAsync(new GitChangesStageEventArgs(row.WorkspaceRepositoryId, scope, paths, row.Key))));
        // Repository scope runs as a full background job (LoadingOverlay), not the lightweight inline
        // indicator, so it never has a row-scoped spinner - only File/Folder actions do.
        RenderActionIcon(builder, ref seq, row, row.Kind != GitChangesTreeRowKind.Repository && IsRowMutating(row, false));
        builder.CloseElement();
    }

    /// <summary>Renders the stage/unstage glyph inside an already-open action button. Swaps the +/- icon for
    /// a small inline spinner when <paramref name="showSpinner"/> is true - used for File/Folder rows (below
    /// repo level) while their repository's mutation is in flight, so the affected sub-items visibly show
    /// work happening instead of just going gray like the repository-level button does.</summary>
    private static void RenderActionIcon(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq, GitChangesTreeRow row, bool showSpinner) =>
        RenderActionIcon(builder, ref seq, row.IsStagedSection ? "bi-dash-lg" : "bi-plus-lg", showSpinner);

    /// <summary>Renders a glyph (identified by its bootstrap-icons class) inside an already-open action
    /// button, or a small inline spinner in its place when <paramref name="showSpinner"/> is true - used for
    /// File/Folder rows (below repo level) while their repository's mutation is in flight, so the affected
    /// sub-items visibly show work happening instead of just going gray like the repository-level button
    /// does.</summary>
    private static void RenderActionIcon(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq, string iconClass, bool showSpinner)
    {
        if (showSpinner)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "git-changes-tree__action-spinner");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", $"bi {iconClass}");
        builder.CloseElement();
    }

    private static string[] FolderPathsOf(GitChangesTreeRow row) =>
        // Folder scope operations pass the folder's own repo-relative path as a directory pathspec;
        // the Key encodes "<section>/<workspaceRepositoryId>/<segment>/<segment>/..." - strip the
        // section/repo prefix to recover the folder's repo-relative path.
        [string.Join('/', row.Key.Split('/').Skip(2))];
}
